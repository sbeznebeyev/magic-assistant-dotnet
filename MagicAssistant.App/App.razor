@using static Microsoft.AspNetCore.Components.Web.RenderMode

@* App.razor — root component for Blazor Web App (.NET 10 modern approach) *@

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Magic Assistant — Card Organizer</title>
    <base href="/" />

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Site CSS (global overrides) -->
    <link rel="stylesheet" href="css/site.css" />
    <link rel="stylesheet" href="css/sets.css" />

    <!-- Blazor scoped CSS (auto-generated .razor.css files) -->
    @* Microsoft .NET 10 template uses @Assets with the project namespace *@
    <link href="@Assets["MagicAssistant.App.styles.css"]" rel="stylesheet" />

    <HeadOutlet @rendermode="_interactiveRenderMode" />
</head>
<body>
    <Routes @rendermode="_interactiveRenderMode" />

    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <!-- Blazor enhanced navigation + interactive components -->
    <script src="_framework/blazor.web.js"></script>

    <!-- Bootstrap JS (dropdowns, modals, etc.) -->
    <script src="lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Site JS (custom helpers) -->
    <script src="js/site.js"></script>
</body>
</html>

@* Prerendering is intentionally disabled: the app is fully interactive (all data comes from SQLite after the
   SignalR circuit attaches), so the prerender pass would only render an empty shell and run every component's
   OnInitializedAsync twice. One shared instance keeps HeadOutlet and Routes consistent — mixing prerendered and
   non-prerendered interactive components in one tree is not allowed. *@
@code {
    private static readonly InteractiveServerRenderMode _interactiveRenderMode = new(prerender: false);
}
