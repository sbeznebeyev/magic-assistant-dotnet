@using MagicAssistant.Data.Model.NavigatorNodes
@* TabBar — deck analysis tab navigation *@

<div class="tab-bar">
    @foreach (var tab in VisibleTabs)
    {
        <button class="@(ActiveTab == tab.Value ? "active" : "")"
                @onclick="@(() => SelectTab(tab.Value))">
            @tab.Label
        </button>
    }
</div>

@code {
    [Parameter] public string ActiveTab { get; set; } = "cards";
    [Parameter] public EventCallback<string> OnTabSelected { get; set; }
    /// <summary>Node type of the selected collection — gates node-specific tabs.
    /// Named NodeKind so the property doesn't shadow the enum type.</summary>
    [Parameter] public NodeType? NodeKind { get; set; }

    private static readonly (string Label, string Value)[] Tabs =
    [
        ("Cards", "cards"),
        ("Mana Curve", "curve"),
        ("Colors", "colors"),
        ("Creatures", "creatures"),
        ("Types", "types"),
        ("Abilities", "abilities"),
        ("Legality", "legality"),
    ];

    /// <summary>Tabs visible for the current node type — Legality is Deck-only
    /// (format rules don't apply to Collections, Sideboards or Folders).</summary>
    private IEnumerable<(string Label, string Value)> VisibleTabs =>
        Tabs.Where(t => t.Value != "legality" || NodeKind == NodeType.Deck);

    private async Task SelectTab(string tabValue)
    {
        ActiveTab = tabValue;
        await OnTabSelected.InvokeAsync(tabValue);
    }
}
