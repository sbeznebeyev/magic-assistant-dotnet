@* Toolbar — action buttons and view mode selector *@

<div class="toolbar">
    <button @onclick="OnImportDeck" title="Import deck (current format)">📥 Import</button>
    <button @onclick="OnExportDeck" title="Export deck">📤 Export</button>
    <button @onclick="OnLegacyImportDeck" title="Import legacy deck (Gatherer ID + full set names)">📜 Legacy Import</button>
    <button @onclick="OnSyncKB" title="Update DataBase from Scryfall">🔄 Update DB</button>
    <span style="flex:1"></span>
    <select @bind="LocalViewMode" @bind:event="onchange" class="view-mode-select">
        <option value="list">List</option>
        <option value="gallery">Gallery</option>
        <option value="tree">Tree</option>
    </select>
</div>

@code {
    [Parameter] public EventCallback<MouseEventArgs> OnImportDeck { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnLegacyImportDeck { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnExportDeck { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnSyncKB { get; set; }
    [Parameter] public string ViewMode { get; set; } = "list";
    [Parameter] public EventCallback<string> OnViewModeChanged { get; set; }

    private string LocalViewMode
    {
        get => ViewMode;
        set
        {
            if (ViewMode != value)
                _ = SetViewModeAsync(value);
        }
    }

    private async Task SetViewModeAsync(string value)
    {
        await OnViewModeChanged.InvokeAsync(value);
    }
}
