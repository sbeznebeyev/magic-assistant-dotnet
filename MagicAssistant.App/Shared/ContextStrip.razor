@*
    ContextStrip — status strip at the top of the center panel (where SearchControl used to live).
    A single bar in three sections:
      left   — selected (displayed) collection, or the KB variant ("KnowledgeBase Cards") when no
               collection is displayed; stats "(x/y)" pushed to the outer left edge, name pushed
               right toward the arrow.
      middle — gold arrow pointing right (inline SVG, 24×24).
      right  — pinned collection (deck/collection/sideboard only); name pushed left toward the
               arrow, stats "(x/y)" pushed to the outer right edge. Nothing pinned →
               "? (pin to set)" in bold gray.
    Names are large gold bold; stats show "(x/y)" with a "unique: x, total: y" tooltip.
*@
@inject IDeckCardService DeckCardService

<div class="context-strip">
    @* Left half — selected (always filled: KB variant or collection/deck/sideboard) *@
    <div class="context-half context-selected">
        @if (SelectedCollection.CollectionId.HasValue)
        {
            <span class="context-stats" title="unique: @_selectedUnique, total: @_selectedTotal">(@_selectedUnique/@_selectedTotal)</span>
            <span class="context-name" title="@SelectedCollection.Name">@SelectedCollection.Name</span>
        }
        else
        {
            @* KB panel — replaces the selected half when no collection is displayed *@
            <span class="context-name">KnowledgeBase Cards</span>
        }
    </div>

    @* Middle — gold arrow pointing right *@
    <div class="context-arrow" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4 12H18" stroke="#ffd700" stroke-width="2.5" stroke-linecap="round"></path>
            <path d="M13 6L19 12L13 18" stroke="#ffd700" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
    </div>

    @* Right half — pinned *@
    <div class="context-half context-pinned">
        @if (PinnedCollection.CollectionId.HasValue)
        {
            <span class="context-name" title="@PinnedCollection.Name">@PinnedCollection.Name</span>
            <span class="context-stats" title="unique: @_pinnedUnique, total: @_pinnedTotal">(@_pinnedUnique/@_pinnedTotal)</span>
        }
        else
        {
            <span class="context-name context-placeholder">? (pin to set)</span>
        }
    </div>
</div>

@code {
    /// <summary>Pinned operation target (deck/collection/sideboard; null id = nothing pinned).</summary>
    [Parameter] public LockableCollection PinnedCollection { get; set; } = new();

    /// <summary>Currently displayed collection (null id = Knowledge Base mode).</summary>
    [Parameter] public LockableCollection SelectedCollection { get; set; } = new();

    /// <summary>Bumped by MainLayout whenever card counts in either context may have changed.</summary>
    [Parameter] public int RefreshTrigger { get; set; }

    private int _pinnedUnique;
    private int _pinnedTotal;
    private int _selectedUnique;
    private int _selectedTotal;

    /// <summary>Last loaded context ids — null = "nothing loaded yet" (the first load is forced by the trigger mismatch).</summary>
    private int? _loadedPinnedId;
    private int? _loadedSelectedId;
    private int _loadedTrigger = -1;
    private int _loadGeneration;

    protected override async Task OnParametersSetAsync()
    {
        var pinnedChanged = PinnedCollection.CollectionId != _loadedPinnedId;
        var selectedChanged = SelectedCollection.CollectionId != _loadedSelectedId;

        if (RefreshTrigger != _loadedTrigger || pinnedChanged || selectedChanged)
            await LoadStatsAsync();
    }

    private async Task LoadStatsAsync()
    {
        _loadedPinnedId = PinnedCollection.CollectionId;
        _loadedSelectedId = SelectedCollection.CollectionId;
        _loadedTrigger = RefreshTrigger;
        var generation = ++_loadGeneration;

        var pinned = await LoadContextStatsAsync(PinnedCollection.CollectionId);
        if (generation != _loadGeneration) return;  // superseded by a newer load
        (_pinnedUnique, _pinnedTotal) = pinned;

        var selected = await LoadContextStatsAsync(SelectedCollection.CollectionId);
        if (generation != _loadGeneration) return;
        (_selectedUnique, _selectedTotal) = selected;
    }

    /// <summary>unique = distinct cards in the node, total = sum of their counts (one row per card in Deck).</summary>
    private async Task<(int Unique, int Total)> LoadContextStatsAsync(int? collectionId)
    {
        if (collectionId is not int id) return (0, 0);
        try
        {
            var cards = await DeckCardService.GetDeckCardsAsync(id);
            return (cards.Count, cards.Sum(c => c.Count));
        }
        catch
        {
            return (0, 0);  // unreachable/deleted node — zeros instead of an error UI
        }
    }
}
