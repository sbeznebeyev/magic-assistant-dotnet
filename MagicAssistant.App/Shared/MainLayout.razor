@inherits LayoutComponentBase
@implements IDisposable
@inject KbRefreshService KbRefresh
@inject IDeckCardService DeckCardService
@inject IDeckManagementService DeckManagement
@using MagicAssistant.App.Services
@using MagicAssistant.Data.Model.NavigatorNodes

<div class="app-layout">
    <div class="header">
        <span class="title">⚔ Magic Assistant</span>
        <span class="subtitle">— Card Organizer</span>
        <span class="header-actions">
            <span class="header-action" @onclick="OpenImportDialog" title="Import deck (current format)">Import</span>
            <span class="header-action" @onclick="OpenExportDialog" title="Export deck">Export</span>
            <span class="header-action" @onclick="OpenLegacyImportDialog" title="Import legacy deck (Gatherer ID + full set names)">Legacy Import</span>
            <span class="header-action" @onclick="OpenUpdateDbDialog" title="Update DataBase from Scryfall">Update DB</span>
        </span>
    </div>

    @* ── Dialogs (render only when visible) *@
    @if (_showSyncDialog) { <SyncKnowledgeBase IsOpen="@_showSyncDialog" IsOpenChanged="@(v => _showSyncDialog = v)" OnCompleted="OnSyncKBCompleted" /> }
    @if (_showSelectedSetSyncDialog) { <SyncSelectedSetCards IsOpen="@_showSelectedSetSyncDialog" SetCode="@_selectedSetForSync" IsOpenChanged="@(v => _showSelectedSetSyncDialog = v)" OnCompleted="OnSyncKBCompleted" /> }
    @if (_showImportDialog) { <DeckImportWizard IsOpen="@_showImportDialog" OnImported="OnImportCompleted" IsOpenChanged="@(v => _showImportDialog = v)" /> }
    @if (_showLegacyImportDialog) { <OldDeckImportWizard IsOpen="@_showLegacyImportDialog" OnImported="OnLegacyImportCompleted" IsOpenChanged="@(v => _showLegacyImportDialog = v)" /> }
    @if (_showExportDialog) { <DeckExportWizard IsOpen="@_showExportDialog" DeckId="@_currentCollection.CollectionId" OnExported="OnExportCompleted" IsOpenChanged="@(v => _showExportDialog = v)" /> }
    @if (_showEditCardDialog) { <EditMagicCardPhysicalDialog IsOpen="@_showEditCardDialog" Card="@_editCardTarget" DeckId="@_currentCollection.CollectionId" OnSaved="OnEditCardSaved" IsOpenChanged="@(v => _showEditCardDialog = v)" /> }

    @if (_showFilterDialog) { <CardFilterDialog IsOpen="@_showFilterDialog" FilterViewModel="@_filterViewModel" IsOpenChanged="@(v => _showFilterDialog = v)" /> }
    @if (_showSplitDialog) { <SplitDialog IsOpen="@_showSplitDialog" Card="@_splitCardTarget" DeckId="@_currentCollection.CollectionId" OnSplitDone="OnSplitDone" IsOpenChanged="@(v => _showSplitDialog = v)" /> }
    @if (_showEditDeckPropertiesDialog) { <EditDeckPropertiesDialog IsOpen="@_showEditDeckPropertiesDialog" DeckId="@_currentCollection.CollectionId!.Value" OnSaved="OnEditDeckPropertiesSaved" IsOpenChanged="@(v => _showEditDeckPropertiesDialog = v)" /> }
    

    @* ── Main Grid ── *@
    <div class="main-grid">
        <div class="panel-left">
            <div class="navigator-scroll">
                <DecksNavigator
                    @ref="_navigator"
                    OnDeckSelected="OnDeckSelected"
                    OnPinToggled="OnPinToggled"
                    OnOpenProperties="OnOpenPropertiesFromNav"
                    OnShowAllCards="OnShowKB"
                    OnNodeDeleted="OnNodeDeleted"
                    SelectedNodeId="@_currentCollection.CollectionId"
                    PinnedNodeId="@_pinnedCollection.CollectionId" />
                @* TODO: Fix NullReferenceException in child components *@
            </div>

            <hr class="divider" />
            <LastActions Queue="@_lastActionsQueue" />
        </div>

        <div class="panel-center">
            <SearchControl
                FilterViewModel="@_filterViewModel"
                OnSearchCompleted="OnGlobalSearchCompleted" />

            <div style="height:4px"></div>

            @if (_currentCollection.CollectionId != null)
            {
                <TabBar ActiveTab="@ActiveTab" OnTabSelected="@(tab => ActiveTab = tab)" />
            }

            <div class="content-area" @key="_currentCollection.CollectionId">
                @if (_currentCollection.CollectionId != null)
                {
                    @RenderDeckContent()
                }
                else
                {
                    @RenderKBContent()
                }
            </div>

            <div class="status-bar">
                <span>@_statusText</span>
            </div>
        </div>

        <div class="panel-right">
            <CardDescriptionView CardId="@_selectedCardId" ShowBack="@_selectedCardShowBack" />
            <hr class="divider" />
            <PrintingsView CardId="@_selectedCardId" OnPrintingSelected="@(c => OnCardSelected(c.Id))" OnPrintingSideChanged="OnCardSideChanged" />
            <hr class="divider" />
            <InstancesView CardId="@_selectedCardId" OnDeckSelected="OnDeckSelectedFromInstance" />
        </div>
    </div>
</div>

@code {
    // ── Navigation State ──
    /// <summary>Collection node currently displayed in the center panel (CollectionId == null = Knowledge Base).</summary>
    private LockableCollection _currentCollection = new();

    /// <summary>Pinned operation target: LastActions and KB-mode card adds work against it.
    /// Changed exclusively by the navigator's Pin buttons (plus a defensive clear
    /// in OnNodeDeleted when the pinned node is deleted).</summary>
    private LockableCollection _pinnedCollection = new();

    /// <summary>Component reference — external selections (InstancesView jump) are delegated to the navigator.</summary>
    private DecksNavigator? _navigator;


    private Guid? _selectedCardId;
    private bool? _selectedCardShowBack;
    private string ActiveTab = "cards";
    private string _statusText = "Ready";

    // ── Dialog Visibility (state-based pattern) ──
    private bool _showSyncDialog;
    private bool _showSelectedSetSyncDialog;
    private string _selectedSetForSync = string.Empty;
    private int _kbRefreshTrigger;
    private bool _showImportDialog;
    private bool _showLegacyImportDialog;
    private bool _showExportDialog;
    private bool _showEditCardDialog;

    private bool _showFilterDialog;
    private bool _showSplitDialog;
    private bool _showEditDeckPropertiesDialog;

    // ── Dialog Data ──
    private MagicCardPhysical? _editCardTarget;

    private MagicCardPhysical? _splitCardTarget;

    /// <summary>Central filter/sort state shared between CardsListControl and CardFilterDialog.</summary>
    private readonly FilterViewModel _filterViewModel = new();

    /// <summary>In-memory queue of the last card actions, displayed by LastActions.</summary>
    private readonly LastActionsQueue _lastActionsQueue = new();

    // ── Navigation ──
    private void OnCardSelected(Guid? cardId) => _selectedCardId = cardId;
    private void OnCardSelectedNonNullable(Guid cardId) => _selectedCardId = cardId;
    private void OnCardSideChanged((Guid cardId, bool showBack) e)
    {
        if (e.cardId == _selectedCardId)
        {
            _selectedCardShowBack = e.showBack;
        }
    }
    /// <summary>Navigator selection — sets the display context only.
    /// _pinnedCollection is changed exclusively by the navigator's Pin buttons.</summary>
    private async Task OnDeckSelected(LockableCollection c)
    {
        _currentCollection = c;
        ActiveTab = "cards";
        _filterViewModel.CurrentCollectionId = c.CollectionId;
        _filterViewModel.Apply();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Pin toggle from the navigator — the ONLY writer of _pinnedCollection.
    /// Clicking an already-pinned node unpins it (silently). Pinning reports to the status bar.</summary>
    private void OnPinToggled(LockableCollection c)
    {
        if (_pinnedCollection.CollectionId == c.CollectionId)
            _pinnedCollection = new();  // unpin — no status message
        else
        {
            _pinnedCollection = c;
            _statusText = $"Pinned {c.Name}";  // side effect of setting PinnedCollection
        }
    }

    /// <summary>InstancesView jump — delegates the selection to the navigator: it highlights its own node
    /// and reports back the (Id, Locked) pair through the standard OnDeckSelected path.</summary>
    private async Task OnDeckSelectedFromInstance(int deckId)
    {
        if (_navigator == null) return;
        await _navigator.SelectNodeAsync(deckId);
    }

    /// <summary>Resolves the display name of a navigation node (collection/deck/sideboard).</summary>
    private async Task<string?> GetNodeNameAsync(int nodeId)
    {
        try
        {
            var node = await DeckManagement.GetByIdAsync(nodeId);
            return node?.Name;
        }
        catch
        {
            return null;
        }
    }

    /// <summary>Switch center panel to Knowledge Base view.
    /// The fixed collection survives — KB card adds keep targeting it.</summary>
    private void OnShowKB()
    {
        _currentCollection = new();
        _selectedCardId = null;
        _filterViewModel.CurrentCollectionId = null;
        _filterViewModel.Apply();
    }

    /// <summary>Properties is a dialog, not navigation: only the display context changes.</summary>
    private void OnOpenPropertiesFromNav(NavigatorNodeBase node)
    {
        _currentCollection = new LockableCollection { CollectionId = node.Id, IsLocked = node.Locked, Name = node.Name };
        _showEditDeckPropertiesDialog = true;
    }

    // ── Header Actions (clickable words in the app header) ──
    private void OpenImportDialog() => _showImportDialog = true;
    private void OpenExportDialog() => _showExportDialog = true;
    private void OpenLegacyImportDialog() => _showLegacyImportDialog = true;
    private void OpenUpdateDbDialog() => _showSyncDialog = true;

    // ── Dialog Openers ──
    private void OpenEditCard(MagicCardPhysical card) { _editCardTarget = card; _showEditCardDialog = true; }

    private void OpenSplit(MagicCardPhysical card) { _splitCardTarget = card; _showSplitDialog = true; }

    // ── Lifecycle (Microsoft Learn: subscribe in OnInitialized, unsubscribe in Dispose) ──
    protected override void OnInitialized()
    {
        KbRefresh.Subscribe(OnKbRefresh);
    }

    /// <summary>
    /// Canonical Blazor pattern (Microsoft Learn):
    /// "In the event a component must be updated based on an external event,
    /// use InvokeAsync to dispatch code execution to Blazor's synchronization context."
    /// The InvokeAsync is called HERE (in the subscriber), not in the background task.
    /// </summary>
    private async Task OnKbRefresh()
    {
        await InvokeAsync(() =>
        {
            _statusText = "Sync completed";
            _kbRefreshTrigger++;  // Trigger CardsListControl to reload
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        KbRefresh.Unsubscribe(OnKbRefresh);
    }

    // ── Dialog Callbacks ──
    private async Task OnSyncKBCompleted()
    {
        await InvokeAsync(() =>
        {
            _statusText = "Sync completed";
            _kbRefreshTrigger++;
            StateHasChanged();
        });
    }
    private void OnOpenSyncDialog(string setCode)
    {
        _selectedSetForSync = setCode;
        _showSelectedSetSyncDialog = true;
    }
    private void OnImportCompleted() { _statusText = "Import completed"; }
    private void OnLegacyImportCompleted() { _statusText = "Legacy import completed"; }
    private void OnExportCompleted() { _statusText = "Export completed"; }
    private void OnEditCardSaved(MagicCardPhysical? card) { _statusText = "Card updated"; StateHasChanged(); }


    private void OnSplitDone() { _statusText = "Card split"; StateHasChanged(); }
    /// <summary>Quick move: the selected card (with all its copies) moves from the viewed collection to the pinned one.</summary>
    private async Task OnMoveToPinned(MagicCardPhysical card)
    {
        if (_currentCollection.CollectionId == null || _pinnedCollection.CollectionId == null) return;
        if (_currentCollection.CollectionId == _pinnedCollection.CollectionId) return;

        try
        {
            var moved = await DeckCardService.MoveCardsAsync(_currentCollection.CollectionId.Value, new[] { card.Id }, _pinnedCollection.CollectionId.Value);
            if (moved > 0)
            {
                // Addition to the working collection — record it in LastActions.
                await RecordLastActionAsync(new CardOperationRecord(_pinnedCollection.CollectionId.Value, card.Card, moved, LastActionOperationEnum.Add));
                _statusText = $"Moved card to location {_pinnedCollection.CollectionId.Value}";
                _kbRefreshTrigger++;  // reload the viewed list
            }
            else
            {
                _statusText = "Nothing to move — card not found in this collection";
            }
        }
        catch (Exception ex)
        {
            _statusText = $"Move failed: {ex.Message}";
        }
    }

    /// <summary>Records an Add/Sub card operation in the rolling LastActions history.
    /// The entry is labeled with the target collection's display name (Location).
    /// The queue is never reset — entries from different collections coexist, each carrying its own location.</summary>
    private async Task RecordLastActionAsync(CardOperationRecord op)
    {
        var location = await GetNodeNameAsync(op.TargetCollectionId);
        _lastActionsQueue.Enqueue(new LastActionItem(op.TargetCollectionId, location ?? "?", op.Card, op.Count, op.Operation));
    }

    /// <summary>A node was deleted in the navigator — drop any context that references it (direct hit or folder cascade).</summary>
    private async Task OnNodeDeleted(int deletedNodeId)
    {
        var pinnedGone = _pinnedCollection.CollectionId.HasValue && await IsNodeGoneAsync(_pinnedCollection.CollectionId.Value);

        // Validate the display context only if it differs from the pinned one (same node → reuse the check).
        var currentGone = _currentCollection.CollectionId.HasValue
            && (_currentCollection.CollectionId == _pinnedCollection.CollectionId ? pinnedGone : await IsNodeGoneAsync(_currentCollection.CollectionId.Value));

        // A deleted pinned node would leave a ghost — drop it (defensive, not a user action).
        if (pinnedGone)
        {
            _pinnedCollection = new();
        }

        // Same for the display context (deleting the viewed collection left a ghost before).
        if (currentGone)
        {
            _currentCollection = new();
            _selectedCardId = null;
            _filterViewModel.CurrentCollectionId = null;
            _filterViewModel.Apply();
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task<bool> IsNodeGoneAsync(int nodeId)
    {
        try
        {
            return await DeckManagement.GetByIdAsync(nodeId) is null;
        }
        catch
        {
            return true;  // unreachable node — treat as gone
        }
    }
    private void OnEditDeckPropertiesSaved() => _statusText = "Deck properties updated";
    // ── Global Search ──
    private void OnGlobalSearchCompleted(string query) => _statusText = string.IsNullOrEmpty(query) ? "Ready" : $"Search: \"{query}\"";

    // ── Content Rendering (RenderFragment with Razor syntax — per Microsoft docs) ──
    private RenderFragment RenderDeckContent() => @<div>
        @switch (ActiveTab)
        {
            case "curve": <ManaCurvePage DeckId="@_currentCollection.CollectionId!.Value" /> break;
            case "colors": <SpellColourPage DeckId="@_currentCollection.CollectionId!.Value" /> break;
            case "creatures": <CreaturePage DeckId="@_currentCollection.CollectionId!.Value" /> break;
            case "types": <TypePage DeckId="@_currentCollection.CollectionId!.Value" /> break;
            case "abilities": <AbilityPage DeckId="@_currentCollection.CollectionId!.Value" /> break;
            case "info": <InfoPage DeckId="@_currentCollection.CollectionId!.Value" /> break;
            case "legality": <DeckLegalityPage DeckId="@_currentCollection.CollectionId!.Value" /> break;
            case "collector": <CollectorView /> break;
            default:
                <CardsListControl FilterViewModel="@_filterViewModel"
                                  OnCardSelected="OnCardSelected"
                                  OnCardSideChanged="OnCardSideChanged"
                                  OnOpenFilter="@(() => _showFilterDialog = true)"
                                  OnOpenSync="OnOpenSyncDialog"
                                  RefreshTrigger="@_kbRefreshTrigger"
                                  OnCardOperation="RecordLastActionAsync"
                                  PinnedCollectionId="@_pinnedCollection.CollectionId"
                                  OnEditCard="OpenEditCard"
                                  OnSplitCard="OpenSplit"
                                  OnMoveToPinned="OnMoveToPinned" />
                break;
        }
    </div>;

    private RenderFragment RenderKBContent()
    {
        return @<div>
            <CardsListControl FilterViewModel="@_filterViewModel"
                                OnCardSelected="OnCardSelected"
                                OnCardSideChanged="OnCardSideChanged"
                                OnOpenFilter="@(() => _showFilterDialog = true)"
                                OnOpenSync="OnOpenSyncDialog"
                                RefreshTrigger="@_kbRefreshTrigger"
                                OnCardOperation="RecordLastActionAsync"
                                PinnedCollectionId="@_pinnedCollection.CollectionId" />
        </div>;
    }
}
