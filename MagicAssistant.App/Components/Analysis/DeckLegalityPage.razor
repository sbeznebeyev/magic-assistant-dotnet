@*
    DeckLegalityPage — Format legality analysis with visual indicators
    Mirrors Java: ui.views.analyzers.DeckLegalityPage2
    
    Features:
    - Clickable format tiles with legal/illegal status (selection gets a gold glow)
    - Descriptions panel below the grid: full problem details of the selected tile,
      scrollable when long; card lists hard-capped at 10 with a truncation marker
    - Summary stats with progress bar
    - Error handling and loading states
*@

<div class="legality-page">
    <div class="section-header">
        <span>Format Legality</span>
        @if (_loading) { <span class="loading-indicator">Loading...</span> }
    </div>

    <div class="analysis-content">
        @if (_error != null)
        {
            <div class="error-state">
                <span>⚠ @_error</span>
                <button class="retry-btn" @onclick="Reload">Retry</button>
            </div>
        }
        else if (_loading && _formats == null)
        {
            <div class="loading-state">Loading legality data...</div>
        }
        else if (_formats != null && _formats.Any())
        {
            @* ── Summary Banner ── *@
            <div class="summary-banner">
                <div class="summary-stat">
                    <div class="summary-value legal">@_legalCount</div>
                    <div class="summary-label">Legal Formats</div>
                </div>
                <div class="summary-stat">
                    <div class="summary-value illegal">@_illegalCount</div>
                    <div class="summary-label">Illegal Formats</div>
                </div>
                <div class="summary-stat">
                    <div class="summary-value total">@_formats.Count</div>
                    <div class="summary-label">Total Checked</div>
                </div>
            </div>

            @* ── Legality Progress Bar ── *@
            <div class="legality-progress">
                <div class="progress-label">Deck Legality Rate</div>
                <div class="progress-track">
                    @* Whole-percent width — culture-safe int for the inline style (ru-RU
                       would render the double with a comma and break the CSS). *@
                    <div class="progress-fill" style="width:@((int)Math.Round(_legalityRate))%;"></div>
                </div>
                <div class="progress-value">@_legalityRate.ToString("F0")%</div>
            </div>

            @* ── Format Tiles — clickable; the selection drives the Descriptions panel below ── *@
            <div class="format-grid">
                @foreach (var format in _formats)
                {
                    <div class="format-card @(format.IsLegal ? "legal" : "illegal") @(_selectedFormat == format.FormatName ? "selected" : "")"
                         @onclick="() => SelectFormat(format.FormatName)">
                        <div class="format-header">
                            <span class="format-name">@format.FormatName</span>
                            <span class="legality-badge @(format.IsLegal ? "badge-legal" : "badge-illegal")">
                                @(format.IsLegal ? "✓ Legal" : "✕ Illegal")
                            </span>
                        </div>
                        @if (!format.IsLegal)
                        {
                            <div class="tile-summary">@IssueSummary(format)</div>
                        }
                    </div>
                }
            </div>

            @* ── Descriptions Panel — full details of the selected tile; scrolls when long ── *@
            <div class="description-panel">
                @if (SelectedItem is { } sel)
                {
                    <div class="description-header">
                        <span class="description-title">@sel.FormatName</span>
                        <span class="legality-badge @(sel.IsLegal ? "badge-legal" : "badge-illegal")">
                            @(sel.IsLegal ? "✓ Legal" : "✕ Illegal")
                        </span>
                    </div>

                    @if (sel.IsLegal)
                    {
                        <div class="description-body legal-clear">
                            <div class="clear-message">✓ This deck is fully legal in @sel.FormatName.</div>
                            <div class="clear-sub">Every card in the deck is legal in this format.</div>
                        </div>
                    }
                    else
                    {
                        <div class="description-body">
                            @if (sel.IllegalCards.Any())
                            {
                                <div class="desc-section">
                                    <div class="desc-section-title">Illegal Cards <span class="desc-count desc-count-red">@sel.IllegalCards.Count</span></div>
                                    <div class="illegal-cards-list">
                                        @foreach (var card in sel.IllegalCards.Take(10))
                                        {
                                            <span class="illegal-card-tag">@card</span>
                                        }
                                        @if (sel.IllegalCards.Count > 10)
                                        {
                                            <span class="more-chip">+ @(sel.IllegalCards.Count - 10) more</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="description-hint">Select a format tile above to see its details.</div>
                }
            </div>

            @if (_totalIllegalCards > 0)
            {
                <div class="total-illegal">
                    <span class="total-label">Total unique illegal cards:</span>
                    <span class="total-value">@_totalIllegalCards</span>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <span>No legality data available.</span>
                <span>Add cards to your deck to check format legality.</span>
            </div>
        }
    </div>
</div>

@code {
    private List<FormatLegalityItem>? _formats;
    private int _totalIllegalCards;
    private int _legalCount;
    private int _illegalCount;
    private double _legalityRate;
    private string? _selectedFormat;
    private bool _loading;
    private string? _error;

    [Parameter] public int DeckId { get; set; }
    [Inject] private ICollectionStore CollectionStore { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        if (DeckId <= 0) return;
        await LoadLegality();
    }

    private async Task LoadLegality()
    {
        _loading = true; _error = null; StateHasChanged();
        try
        {
            var cards = await CollectionStore.GetDeckCardsAsync(DeckId);
            if (cards.Count > 0) BuildLegalityData(cards);
            else _error = "No deck data available.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; StateHasChanged(); }
    }

    private async Task Reload() => await LoadLegality();

    private void BuildLegalityData(ICollection<MyCard> cards)
    {
        // Enum Format → display name mapping
        var formatMap = new Dictionary<Format, string>
        {
            [Format.Standard] = "Standard",
            [Format.Pioneer] = "Pioneer",
            [Format.Modern] = "Modern",
            [Format.Legacy] = "Legacy",
            [Format.Vintage] = "Vintage",
            [Format.Commander] = "Commander",
            [Format.Brawl] = "Brawl",
            [Format.Historic] = "Historic",
            [Format.Pauper] = "Pauper",
            [Format.FutureStandard] = "Future Standard",
            [Format.Timeless] = "Timeless",
            [Format.Duelist] = "Duelist",
        };

        _formats = new List<FormatLegalityItem>();
        var allIllegalCards = new HashSet<string>();

        foreach (var (format, formatName) in formatMap)
        {
            // Simple per-card legality: a format is legal when every card in the deck is.
            var illegalCards = cards
                .Where(c => !c.Card.LegalityMap.IsLegal(format))
                .Select(c => c.Card.Name)
                .Distinct()
                .ToList();

            _formats.Add(new FormatLegalityItem
            {
                FormatName = formatName,
                IsLegal = illegalCards.Count == 0,
                IllegalCards = illegalCards
            });

            allIllegalCards.UnionWith(illegalCards);
        }

        _totalIllegalCards = allIllegalCards.Count;
        _legalCount = _formats.Count(f => f.IsLegal);
        _illegalCount = _formats.Count(f => !f.IsLegal);
        _legalityRate = _formats.Count > 0 ? (double)_legalCount / _formats.Count * 100 : 0;
    }

    private void SelectFormat(string formatName) => _selectedFormat = formatName;

    /// <summary>The tile currently selected in the grid (null until the first click).</summary>
    private FormatLegalityItem? SelectedItem =>
        _selectedFormat is { } name ? _formats?.FirstOrDefault(f => f.FormatName == name) : null;

    /// <summary>Tile summary line: "N illegal cards".</summary>
    private static string IssueSummary(FormatLegalityItem f) =>
        $"{f.IllegalCards.Count} illegal card{(f.IllegalCards.Count != 1 ? "s" : "")}";

    private class FormatLegalityItem
    {
        public string FormatName { get; set; } = "";
        /// <summary>True when every card in the deck is legal in this format.</summary>
        public bool IsLegal { get; set; }
        public List<string> IllegalCards { get; set; } = new();
    }
}
