@*
    SpellColourPage — Color distribution (pure CSS progress bars + color identity)
    Mirrors Java: ui.views.analyzers.SpellColourPage + CardStoreUtils.buildSpellColorStats
    
    Features:
    - MTG color-coded progress bars with hover effects
    - Color identity detection and display
    - Summary stats
*@

<div class="color-distribution-page">
    <div class="section-header">
        <span>Color Distribution</span>
        @if (_loading) { <span class="loading-indicator">Loading...</span> }
    </div>

    <div class="analysis-content">
        @if (_error != null)
        {
            <div class="error-state"><span>⚠ @_error</span><button class="retry-btn" @onclick="Reload">Retry</button></div>
        }
        else if (_loading && _colorItems.Count == 0)
        {
            <div class="loading-state">Loading color distribution...</div>
        }
        else if (_colorItems.Count > 0)
        {
            @* ── Color Identity Banner ── *@
            <div class="color-identity-banner">
                <span class="identity-label">Color Identity:</span>
                @foreach (var color in _colorItems)
                {
                    <span class="identity-symbol card-symbol card-symbol-@color.ManaSymbol" title="@color.DisplayName"></span>
                }
            </div>

            @* ── Color Progress Bars ── *@
            <div class="color-bars">
                @foreach (var color in _colorItems)
                {
                    <div class="color-bar-row" style="--bar-color: @color.Hex;">
                        <div class="color-bar-header">
                            <span class="bar-symbol card-symbol card-symbol-@color.ManaSymbol"></span>
                            <span class="color-name">@color.DisplayName</span>
                        </div>
                        <div class="color-bar-track">
                            <div class="color-bar-fill" style="width:@(color.BarWidthPct)%">
                                <div class="color-bar-inner"></div>
                            </div>
                        </div>
                        <div class="color-bar-value">@color.Count (@color.Percentage.ToString("F1")%)</div>
                    </div>
                }
            </div>

            @* ── Summary Stats ── *@
            <div class="summary-stats">
                <div class="stat-card"><div class="stat-value">@_totalCards</div><div class="stat-label">Non-Land Cards</div></div>
                <div class="stat-card"><div class="stat-value">@_colorItems.Count</div><div class="stat-label">Colors Used</div></div>
                <div class="stat-card"><div class="stat-value">@_dominantColor</div><div class="stat-label">Dominant Color</div></div>
            </div>
        }
        else
        {
            <div class="empty-state">
                <span>No color distribution data available.</span>
                <span>Add non-land cards to your deck to see the distribution.</span>
            </div>
        }
    </div>
</div>

@code {
    private List<ColorItem> _colorItems = new();
    private int _totalCards;
    private string _dominantColor = "—";
    private bool _loading;
    private string? _error;

    [Parameter] public int DeckId { get; set; }
    [Inject] private ICollectionStore CollectionStore { get; set; } = default!;
    [Inject] private IAnalysisService AnalysisService { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        if (DeckId <= 0) return;
        await LoadAnalysis();
    }

    private async Task LoadAnalysis()
    {
        _loading = true; _error = null; StateHasChanged();
        try
        {
            var cards = await CollectionStore.GetDeckWithSideboardAsync(DeckId);
            if (cards.Count == 0)
            {
                _colorItems = new List<ColorItem>();
                _totalCards = 0;
            }
            else
            {
                var result = AnalysisService.Analyze(cards);
                BuildChartData(result);
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; StateHasChanged(); }
    }

    private async Task Reload() => await LoadAnalysis();

    private void BuildChartData(DeckAnalysisResult result)
    {
        // True non-land card count. ColorDistribution counts a multicolor card once PER COLOR,
        // so summing its values overcounts — "Non-Land Cards" must match the Mana Curve tab.
        // Bar width and % are relative to this number; on multicolor decks they can sum past 100%.
        _totalCards = result.TotalCards - result.LandCount;
        if (_totalCards == 0) return;

        // Soft matte colors matching each card color (W/U/B/R/G + colorless gray).
        var colorMap = new Dictionary<string, (string Hex, string DisplayName)>
        {
            ["W"] = ("#d8d5cc", "White"),
            ["U"] = ("#6f8fb3", "Blue"),
            ["B"] = ("#3a3a44", "Black"),
            ["R"] = ("#b06a6a", "Red"),
            ["G"] = ("#74a578", "Green"),
        };

        _colorItems = result.ColorDistribution
            .Select(kv =>
            {
                var (hex, displayName) = colorMap.TryGetValue(kv.Key, out var val) ? val : ("#909099", "Colorless");
                // Whole-percent bar width: an int renders identically in any culture (no decimal
                // separator to break the inline style) — same approach as the Mana Curve heights.
                var pct = kv.Value / (double)_totalCards * 100;
                return new ColorItem
                {
                    Key = kv.Key, Hex = hex, DisplayName = displayName,
                    // card-symbol sprite suffix: W/U/B/R/G, colorless → C (matches CardFilterDialog naming).
                    ManaSymbol = kv.Key == "Colorless" ? "C" : kv.Key,
                    Count = kv.Value, Percentage = pct, BarWidthPct = (int)Math.Round(pct)
                };
            })
            .OrderByDescending(c => c.Count)
            .ToList();

        _dominantColor = _colorItems.FirstOrDefault()?.DisplayName ?? "—";
    }

    private class ColorItem
    {
        public string Key { get; set; } = "";
        public string Hex { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public string ManaSymbol { get; set; } = "";
        public int Count { get; set; }
        public double Percentage { get; set; }
        /// <summary>Whole-percent bar width — culture-safe int for the inline style.</summary>
        public int BarWidthPct { get; set; }
    }
}
