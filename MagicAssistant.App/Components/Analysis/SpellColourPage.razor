@*
    SpellColourPage — Color distribution, split into two columns.
    Left column = main deck only (no sideboard); right column = sideboard only.
    Each column shows MTG color-coded progress bars + summary stats for its portion.

    Features:
    - Main-deck vs sideboard color breakdown side by side
    - Gold-framed, shimmering matte color bars
    - Per-column summary stats (non-land count, colors used, dominant color)
*@

<div class="color-distribution-page">
    <div class="section-header">
        <span>Color Distribution</span>
        @if (_loading) { <span class="loading-indicator">Loading...</span> }
    </div>

    <div class="analysis-content">
        @if (_error != null)
        {
            <div class="error-state"><span>⚠ @_error</span><button class="retry-btn" @onclick="Reload">Retry</button></div>
        }
        else if (_loading || _main == null)
        {
            <div class="loading-state">Loading color distribution...</div>
        }
        else
        {
            <div class="color-columns @(!_hasSideboard ? "single" : "")">
                @* ── Left: main deck only (no sideboard) ── *@
                <div class="color-column">
                    <div class="column-title deck-name-title">@(DeckName ?? "Deck")</div>
                    @if (_main!.TotalNonLand > 0)
                    {
                        <div class="color-bars">
                            @foreach (var color in _main.Items)
                            {
                                <div class="color-bar-row" style="--bar-color: @color.Hex;">
                                    <div class="color-bar-header">
                                        <span class="bar-symbol card-symbol card-symbol-@color.ManaSymbol"></span>
                                        <span class="color-name">@color.DisplayName</span>
                                    </div>
                                    <div class="color-bar-track">
                                        @if (color.Count > 0)
                                        {
                                            <div class="color-bar-fill" style="width:@(color.BarWidthPct)%">
                                                <div class="color-bar-inner"></div>
                                            </div>
                                        }
                                    </div>
                                    <div class="color-bar-value">@color.Count (@color.Percentage.ToString("F1")%)</div>
                                </div>
                            }
                        </div>
                        <div class="summary-stats">
                            <div class="stat-card"><div class="stat-value">@_main.TotalNonLand</div><div class="stat-label">Non-Land Cards</div></div>
                            <div class="stat-card"><div class="stat-value">@_main.Items.Count</div><div class="stat-label">Colors Used</div></div>
                            <div class="stat-card"><div class="stat-value">@_main.DominantColor</div><div class="stat-label">Dominant Color</div></div>
                        </div>
                    }
                    else
                    {
                        <div class="column-empty">No non-land cards.</div>
                    }
                </div>

                @* ── Right: sideboard only — hidden for nodes without a sideboard (Collection) ── *@
                @if (_hasSideboard)
                {
                    <div class="color-column">
                        <div class="column-title"><span class="sideboard-badge">Sideboard</span></div>
                        @if (_side!.TotalNonLand > 0)
                        {
                            <div class="color-bars">
                                @foreach (var color in _side.Items)
                                {
                                    <div class="color-bar-row" style="--bar-color: @color.Hex;">
                                        <div class="color-bar-header">
                                            <span class="bar-symbol card-symbol card-symbol-@color.ManaSymbol"></span>
                                            <span class="color-name">@color.DisplayName</span>
                                        </div>
                                        <div class="color-bar-track">
                                            @if (color.Count > 0)
                                            {
                                                <div class="color-bar-fill" style="width:@(color.BarWidthPct)%">
                                                    <div class="color-bar-inner"></div>
                                                </div>
                                            }
                                        </div>
                                        <div class="color-bar-value">@color.Count (@color.Percentage.ToString("F1")%)</div>
                                    </div>
                                }
                            </div>
                            <div class="summary-stats">
                                <div class="stat-card"><div class="stat-value">@_side.TotalNonLand</div><div class="stat-label">Non-Land Cards</div></div>
                                <div class="stat-card"><div class="stat-value">@_side.Items.Count</div><div class="stat-label">Colors Used</div></div>
                                <div class="stat-card"><div class="stat-value">@_side.DominantColor</div><div class="stat-label">Dominant Color</div></div>
                            </div>
                        }
                        else
                        {
                            <div class="column-empty">No non-land cards.</div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private DeckColorData? _main;
    private DeckColorData? _side;
    /// <summary>True when the node has sideboard cards (Deck nodes only — Collection nodes
    /// have no sideboard child). False → right column hidden, left takes full width.</summary>
    private bool _hasSideboard;
    private bool _loading;
    private string? _error;

    [Parameter] public int DeckId { get; set; }
    [Parameter] public string? DeckName { get; set; }
    [Inject] private ICollectionStore CollectionStore { get; set; } = default!;
    [Inject] private IAnalysisService AnalysisService { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        if (DeckId <= 0) return;
        await LoadAnalysis();
    }

    private async Task LoadAnalysis()
    {
        _loading = true; _error = null; _main = null; _side = null; StateHasChanged();
        try
        {
            var cards = await CollectionStore.GetDeckCardsForAnalysisAsync(DeckId, includeSideboard: true);
            // Each physical card carries its owning collection in Collection: the deck's own
            // cards (Id == DeckId) vs. the sideboard child's (everything else).
            var mainCards = cards.Where(c => c.Collection?.Id == DeckId).ToList();
            var sideCards = cards.Where(c => c.Collection?.Id != DeckId).ToList();
            _hasSideboard = sideCards.Count > 0;

            // Shared color list: union of both columns, ordered by combined count descending.
            // Every column renders every row — a color missing from one column shows a zero bar.
            var mainResult = AnalysisService.Analyze(mainCards);
            var sideResult = AnalysisService.Analyze(sideCards);
            var sharedColors = mainResult.ColorDistribution.Keys
                .Concat(sideResult.ColorDistribution.Keys)
                .Distinct()
                .OrderByDescending(k =>
                    (mainResult.ColorDistribution.TryGetValue(k, out var m) ? m : 0) +
                    (sideResult.ColorDistribution.TryGetValue(k, out var s) ? s : 0))
                .ToList();
            _main = BuildColumn(mainResult, sharedColors);
            _side = BuildColumn(sideResult, sharedColors);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; StateHasChanged(); }
    }

    private async Task Reload() => await LoadAnalysis();

    private DeckColorData BuildColumn(DeckAnalysisResult result, IReadOnlyList<string> sharedColors)
    {
        var data = new DeckColorData();
        // True non-land card count for this portion. ColorDistribution counts a multicolor
        // card once PER COLOR, so summing its values overcounts — use the real card count.
        var totalNonLand = result.TotalCards - result.LandCount;
        data.TotalNonLand = totalNonLand;

        // Soft matte colors matching each card color (W/U/B/R/G + colorless gray).
        var colorMap = new Dictionary<string, (string Hex, string DisplayName)>
        {
            ["W"] = ("#d8d5cc", "White"),
            ["U"] = ("#6f8fb3", "Blue"),
            ["B"] = ("#3a3a44", "Black"),
            ["R"] = ("#b06a6a", "Red"),
            ["G"] = ("#74a578", "Green"),
        };

        // One row per shared color, in the shared order; missing colors render a zero bar.
        data.Items = sharedColors
            .Select(key =>
            {
                var count = result.ColorDistribution.TryGetValue(key, out var v) ? v : 0;
                var (hex, displayName) = colorMap.TryGetValue(key, out var val) ? val : ("#909099", "Colorless");
                // Whole-percent bar width: an int renders identically in any culture (no decimal
                // separator to break the inline style) — same approach as the Mana Curve heights.
                var pct = totalNonLand > 0 ? count / (double)totalNonLand * 100 : 0;
                return new ColorItem
                {
                    Key = key, Hex = hex, DisplayName = displayName,
                    // card-symbol sprite suffix: W/U/B/R/G, colorless → C (matches CardFilterDialog naming).
                    ManaSymbol = key == "Colorless" ? "C" : key,
                    Count = count, Percentage = pct, BarWidthPct = (int)Math.Round(pct)
                };
            })
            .ToList();

        // Dominant color counts only cards actually present in this column.
        data.DominantColor = data.Items.Where(c => c.Count > 0).FirstOrDefault()?.DisplayName ?? "—";
        return data;
    }

    private class DeckColorData
    {
        public List<ColorItem> Items { get; set; } = new();
        public int TotalNonLand { get; set; }
        public string DominantColor { get; set; } = "—";
    }

    private class ColorItem
    {
        public string Key { get; set; } = "";
        public string Hex { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public string ManaSymbol { get; set; } = "";
        public int Count { get; set; }
        public double Percentage { get; set; }
        /// <summary>Whole-percent bar width — culture-safe int for the inline style.</summary>
        public int BarWidthPct { get; set; }
    }
}
