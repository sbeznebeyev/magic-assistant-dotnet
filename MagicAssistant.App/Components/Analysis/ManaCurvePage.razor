@*
    ManaCurvePage — Professional mana curve visualization (pure CSS bars)
    Mirrors Java: ui.views.analyzers.ManaCurvePage + CardStoreUtils.buildManaCurveStats
    
    Features:
    - Interactive vertical bar chart (pure CSS, no Chart.js dependency)
    - Hover tooltips with detailed card counts and percentages
    - Average/median CMC indicators
    - Smooth CSS animations
    - Responsive design
*@

<div class="mana-curve-page">
    <div class="section-header">
        <span>Mana Curve</span>
        @if (_loading) { <span class="loading-indicator">Loading...</span> }
    </div>

    <div class="analysis-content">
        @if (_error != null)
        {
            <div class="error-state">
                <span>⚠ @_error</span>
                <button class="retry-btn" @onclick="Reload">Retry</button>
            </div>
        }
        else if (_loading && _curve == null)
        {
            <div class="loading-state">Loading mana curve...</div>
        }
        else if (_curve != null && _totalNonLand > 0)
        {
            @* ── Bar Chart (Pure CSS) — two series: Main + Sideboard and Main only ── *@
            <div class="chart-container">
                @* Legend only when two series exist. Collection nodes have no sideboard —
                   the single bar series speaks for itself, no legend. *@
                @if (_hasSideboard)
                {
                    <div class="chart-legend">
                        <span class="legend-item"><span class="legend-swatch legend-combined"></span>Main + Sideboard</span>
                        <span class="legend-item"><span class="legend-swatch legend-main"></span>Main only</span>
                    </div>
                }
                <div class="chart-area">
                    @for (int i = 0; i < 8; i++)
                    {
                        var combined = i < _curve.Length ? _curve[i] : 0;
                        var main = i < (_mainCurve?.Length ?? 0) ? _mainCurve![i] : 0;
                        // Pixel heights computed in C# — no percentage/CSS-var chains, so every
                        // non-zero column is guaranteed a visible bar regardless of flex layout.
                        var combinedH = _maxBar > 0 ? (int)Math.Round(combined / (double)_maxBar * MaxBarPx) : 0;
                        var mainH = _maxBar > 0 ? (int)Math.Round(main / (double)_maxBar * MaxBarPx) : 0;
                        <div class="bar-column">
                            @if (combined > 0 || main > 0)
                            {
                                <div class="bar-tooltip">
                                    <span class="tooltip-cmc">CMC @(_labels[i])</span>
                                    @if (_hasSideboard)
                                    {
                                        <span class="tooltip-count tooltip-combined">Main + SB: @combined card@(combined != 1 ? "s" : "") (@FormatPct(combined, _totalNonLand))</span>
                                        <span class="tooltip-count tooltip-main">Main only: @main card@(main != 1 ? "s" : "") (@FormatPct(main, _totalMainNonLand))</span>
                                    }
                                    else
                                    {
                                        <span class="tooltip-count tooltip-main">@main card@(main != 1 ? "s" : "") (@FormatPct(main, _totalMainNonLand))</span>
                                    }
                                </div>
                            }
                            <div class="bars">
                                @if (_hasSideboard)
                                {
                                    @if (combined > 0)
                                    {
                                        <div class="bar bar-combined" style="height:@(combinedH)px"></div>
                                    }
                                    @if (main > 0)
                                    {
                                        <div class="bar bar-main" style="height:@(mainH)px"></div>
                                    }
                                }
                                else if (main > 0)
                                {
                                    <div class="bar bar-main bar-single" style="height:@(mainH)px"></div>
                                }
                            </div>
                            <div class="bar-label">@_labels[i]</div>
                        </div>
                    }
                </div>
            </div>

            @* ── Summary Stats ── *@
            <div class="summary-stats">
                <div class="stat-card">
                    <div class="stat-value">@_averageCmc.ToString("F2")</div>
                    <div class="stat-label">Average CMC</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">@_medianCmc.ToString("F1")</div>
                    <div class="stat-label">Median CMC</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">@_totalNonLand</div>
                    <div class="stat-label">Non-Land Cards</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">@_peakCmcLabel</div>
                    <div class="stat-label">Peak CMC</div>
                </div>
            </div>
        }
        else
        {
            <div class="empty-state">
                <span>No mana curve data available.</span>
                <span>Add non-land cards to your deck to see the curve.</span>
            </div>
        }
    </div>
</div>

@code {
    /// <summary>Curve over main deck + sideboard (the tab's primary series).</summary>
    private int[]? _curve;
    /// <summary>Curve over the main deck only — the second, sideboard-free series.</summary>
    private int[]? _mainCurve;
    private double _averageCmc;
    private double _medianCmc;
    /// <summary>Total non-land cards in main + sideboard — deck-level fact, tooltip % denominator.</summary>
    private int _totalNonLand;
    /// <summary>Total non-land cards in the main deck only.</summary>
    private int _totalMainNonLand;
    private int _maxBar;
    private string _peakCmcLabel = "—";
    /// <summary>True when the node has sideboard cards (Deck nodes only — Collection nodes
    /// have no sideboard child). False → single main-only series, no legend.</summary>
    private bool _hasSideboard;
    private bool _loading;
    private string? _error;

    private static readonly string[] _labels = { "0", "1", "2", "3", "4", "5", "6", "7+" };

    /// <summary>Pixel height of the tallest bar (chart-area is 200px; label row takes ~25px).
    /// Kept in sync with .chart-area height in ManaCurvePage.razor.css.</summary>
    private const int MaxBarPx = 170;

    [Parameter] public int DeckId { get; set; }
    [Inject] private ICollectionStore CollectionStore { get; set; } = default!;
    [Inject] private IAnalysisService AnalysisService { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        if (DeckId <= 0) return;
        await LoadAnalysis();
    }

    private IJSObjectReference? _jsModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _jsModule == null)
        {
            // ES Module (same pattern as CardsListControl's splitter): the CSS-only tooltip
            // anchored to the full-height column and stuck to the chart top — this module
            // floats it above the cursor. Listener is guarded module-side; re-entry is free.
            _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/manaTooltip.js");
            await _jsModule.InvokeVoidAsync("attachBarTooltips");
        }
    }

    private async Task LoadAnalysis()
    {
        _loading = true; _error = null; StateHasChanged();
        try
        {
            var cards = await CollectionStore.GetDeckCardsForAnalysisAsync(DeckId, includeSideboard: true);
            if (cards.Count == 0)
            {
                _curve = Array.Empty<int>();
                _mainCurve = Array.Empty<int>();
                _totalNonLand = 0;
                _totalMainNonLand = 0;
            }
            else
            {
                // Every physical card carries its owning collection in Collection — the deck's own
                // cards vs. the sideboard child's. Main-only series = everything but the sideboard.
                var mainCards = cards.Where(c => c.Collection?.Id == DeckId).ToList();
                _hasSideboard = cards.Count != mainCards.Count;

                // True non-land card counts (deck-level fact — must match the Colors tab).
                // Curve sums would undercount free cards: a {T} cost has no numeric CMC bucket.
                // Fully qualified: the injected property name shadows the type name in this scope.
                _totalNonLand = cards.Where(c => !MagicAssistant.Core.Analysis.AnalysisService.IsLand(c.Card)).Sum(c => c.Count);
                _totalMainNonLand = mainCards.Where(c => !MagicAssistant.Core.Analysis.AnalysisService.IsLand(c.Card)).Sum(c => c.Count);

                BuildChartData(AnalysisService.ComputeManaCurve(cards), AnalysisService.ComputeManaCurve(mainCards));
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; StateHasChanged(); }
    }

    private async Task Reload() => await LoadAnalysis();

    private void BuildChartData(int[] combined, int[] main)
    {
        _curve = combined;
        _mainCurve = main;

        // _totalNonLand / _totalMainNonLand are set in LoadAnalysis — true non-land card counts,
        // not curve sums (free cards have no CMC bucket but are still non-land).
        _maxBar = Math.Max(_curve.Max(), _mainCurve.Max());

        // main[i] <= combined[i] always holds, so the peak lives in the combined series.
        var peakIdx = Array.IndexOf(_curve, _maxBar);
        _peakCmcLabel = _labels[Math.Min(peakIdx, 7)];
        _averageCmc = CalculateAverageCmc(_curve);
        _medianCmc = CalculateMedianCmc(_curve);
    }

    private static string FormatPct(int count, int total) =>
        total > 0 ? $"{((double)count / total * 100):F1}%" : "0%";

    private static double CalculateAverageCmc(int[] curve)
    {
        var total = curve.Sum();
        if (total == 0) return 0;
        var weightedSum = 0;
        for (int i = 0; i < Math.Min(curve.Length, 8); i++)
            weightedSum += i * curve[i];
        return (double)weightedSum / total;
    }

    private static double CalculateMedianCmc(int[] curve)
    {
        var cards = new List<int>();
        for (int i = 0; i < Math.Min(curve.Length, 8); i++)
            for (int j = 0; j < curve[i]; j++)
                cards.Add(i);
        if (cards.Count == 0) return 0;
        cards.Sort();
        var mid = cards.Count / 2;
        return cards.Count % 2 == 0 ? (cards[mid - 1] + cards[mid]) / 2.0 : cards[mid];
    }
}
