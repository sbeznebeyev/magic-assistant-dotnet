@*
    CreaturePage — Creature subtype analysis (pure CSS horizontal bars)
    Mirrors Java: ui.views.analyzers.CreaturePage + CardStoreUtils.buildCreatureGroups
    
    Features:
    - Horizontal bar chart sorted by count
    - Interactive hover tooltips with count and percentage
    - Total creature count display
*@

<div class="creature-page">
    <div class="section-header">
        <span>Creatures</span>
        @if (_loading) { <span class="loading-indicator">Loading...</span> }
    </div>

    <div class="analysis-content">
        @if (_error != null)
        {
            <div class="error-state"><span>⚠ @_error</span><button class="retry-btn" @onclick="Reload">Retry</button></div>
        }
        else if (_loading && _subtypes.Count == 0)
        {
            <div class="loading-state">Loading creature data...</div>
        }
        else if (_subtypes.Count > 0)
        {
            <div class="summary-header">
                <span class="creature-count">@_creatureCount creature@(_creatureCount != 1 ? "s" : "")</span>
                <span class="unique-subtypes">@_subtypes.Count unique subtype@(_subtypes.Count != 1 ? "s" : "")</span>
            </div>

            <div class="h-bar-chart">
                @foreach (var item in _subtypes)
                {
                    var pct = _maxSubtype > 0 ? (double)item.Value / _maxSubtype * 100 : 0;
                    var totalPct = _creatureCount > 0 ? (double)item.Value / _creatureCount * 100 : 0;
                    <div class="h-bar-row" style="--bar-width: @pct%;">
                        <div class="h-bar-label">@item.Key</div>
                        <div class="h-bar-track">
                            <div class="h-bar-fill"></div>
                        </div>
                        <div class="h-bar-value">@item.Value (@totalPct.ToString("F0")%)</div>
                    </div>
                }
            </div>
        }
        else if (_creatureCount > 0)
        {
            <div class="empty-state"><span>Creatures exist but no subtypes detected.</span></div>
        }
        else
        {
            <div class="empty-state">
                <span>No creatures in this deck.</span>
                <span>Add creature cards to see subtype analysis.</span>
            </div>
        }
    </div>
</div>

@code {
    private List<KeyValuePair<string, int>> _subtypes = new();
    private int _creatureCount;
    private int _maxSubtype;
    private bool _loading;
    private string? _error;

    [Parameter] public int DeckId { get; set; }
    [Inject] private ICollectionStore CollectionStore { get; set; } = default!;
    [Inject] private IAnalysisService AnalysisService { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        if (DeckId <= 0) return;
        await LoadAnalysis();
    }

    private async Task LoadAnalysis()
    {
        _loading = true; _error = null; StateHasChanged();
        try
        {
            var cards = await CollectionStore.GetDeckWithSideboardAsync(DeckId);
            if (cards.Count == 0)
            {
                _subtypes = new List<KeyValuePair<string, int>>();
                _creatureCount = 0;
            }
            else
            {
                var result = AnalysisService.Analyze(cards);
                BuildCreatureData(result);
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; StateHasChanged(); }
    }

    private async Task Reload() => await LoadAnalysis();

    private void BuildCreatureData(DeckAnalysisResult result)
    {
        _creatureCount = result.CreatureCount;
        if (result.CreatureSubtypes.Any())
        {
            _subtypes = result.CreatureSubtypes.OrderByDescending(kv => kv.Value).ToList();
            _maxSubtype = _subtypes.Max(s => s.Value);
        }
    }
}
