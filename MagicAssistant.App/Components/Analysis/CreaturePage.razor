@*
    CreaturePage — Creature subtype analysis (pure CSS horizontal bars), split into two charts.
    Top = main deck only; bottom = sideboard only (hidden for nodes without a sideboard).

    Features:
    - Per-chart horizontal bar chart sorted by count, scaled to that chart's max subtype
    - Gold-framed deck name / Sideboard badge section titles (matches the Colors tab)
    - Per-chart creature count and unique-subtype stats
*@

<div class="creature-page">
    <div class="section-header">
        <span>Creatures</span>
        @if (_loading) { <span class="loading-indicator">Loading...</span> }
    </div>

    <div class="analysis-content">
        @if (_error != null)
        {
            <div class="error-state"><span>⚠ @_error</span><button class="retry-btn" @onclick="Reload">Retry</button></div>
        }
        else if (_loading || _main == null)
        {
            <div class="loading-state">Loading creature data...</div>
        }
        else if (_main!.CreatureCount > 0 || (_hasSideboard && _side!.CreatureCount > 0))
        {
            <div class="creature-sections">
                @* ── Top: main deck only ── *@
                <div class="creature-section">
                    <div class="section-title-row">
                        <span class="deck-name-title">@(DeckName ?? "Deck")</span>
                        <span class="section-stats">@_main.CreatureCount creature@(_main.CreatureCount != 1 ? "s" : "") · @_main.Items.Count unique subtype@(_main.Items.Count != 1 ? "s" : "")</span>
                    </div>
                    @if (_main.Items.Count > 0)
                    {
                        <div class="h-bar-chart">
                            @foreach (var item in _main.Items)
                            {
                                <div class="h-bar-row">
                                    <div class="h-bar-label @(item.IsAll ? "all" : "")">@item.Name</div>
                                    <div class="h-bar-track">
                                        <div class="h-bar-fill" style="width:@(item.BarWidthPct)%"></div>
                                    </div>
                                    <div class="h-bar-value">@item.Count (@item.TotalPct.ToString("F0")%)</div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="section-empty">Creatures exist but no subtypes detected.</div>
                    }
                </div>

                @* ── Bottom: sideboard only — hidden for nodes without a sideboard (Collection) ── *@
                @if (_hasSideboard)
                {
                    <div class="creature-section">
                        <div class="section-title-row">
                            <span class="sideboard-badge">Sideboard</span>
                            <span class="section-stats">@_side!.CreatureCount creature@(_side.CreatureCount != 1 ? "s" : "") · @_side.Items.Count unique subtype@(_side.Items.Count != 1 ? "s" : "")</span>
                        </div>
                        @if (_side.Items.Count > 0)
                        {
                            <div class="h-bar-chart">
                                @foreach (var item in _side.Items)
                                {
                                    <div class="h-bar-row">
                                        <div class="h-bar-label @(item.IsAll ? "all" : "")">@item.Name</div>
                                        <div class="h-bar-track">
                                            <div class="h-bar-fill" style="width:@(item.BarWidthPct)%"></div>
                                        </div>
                                        <div class="h-bar-value">@item.Count (@item.TotalPct.ToString("F0")%)</div>
                                    </div>
                                }
                            </div>
                        }
                        else if (_side.CreatureCount > 0)
                        {
                            <div class="section-empty">Creatures exist but no subtypes detected.</div>
                        }
                        else
                        {
                            <div class="section-empty">No creatures in the sideboard.</div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <span>No creatures in this deck.</span>
                <span>Add creature cards to see subtype analysis.</span>
            </div>
        }
    </div>
</div>

@code {
    private CreatureChartData? _main;
    private CreatureChartData? _side;
    /// <summary>True when the node has sideboard cards (Deck nodes only — Collection nodes
    /// have no sideboard child). False → bottom chart hidden.</summary>
    private bool _hasSideboard;
    private bool _loading;
    private string? _error;

    [Parameter] public int DeckId { get; set; }
    [Parameter] public string? DeckName { get; set; }
    [Inject] private ICollectionStore CollectionStore { get; set; } = default!;
    [Inject] private IAnalysisService AnalysisService { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        if (DeckId <= 0) return;
        await LoadAnalysis();
    }

    private async Task LoadAnalysis()
    {
        _loading = true; _error = null; _main = null; _side = null; StateHasChanged();
        try
        {
            var cards = await CollectionStore.GetDeckWithSideboardAsync(DeckId);
            if (cards.Count == 0)
            {
                _main = new CreatureChartData();
                _side = new CreatureChartData();
            }
            else
            {
                // Each physical card carries its owning collection in Location: the deck's own
                // cards (RawId == DeckId) vs. the sideboard child's (everything else).
                var mainCards = cards.Where(c => c.Location.RawId == DeckId).ToList();
                var sideCards = cards.Where(c => c.Location.RawId != DeckId).ToList();
                _hasSideboard = sideCards.Count > 0;
                _main = BuildChart(AnalysisService.Analyze(mainCards));
                _side = BuildChart(AnalysisService.Analyze(sideCards));
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; StateHasChanged(); }
    }

    private async Task Reload() => await LoadAnalysis();

    private CreatureChartData BuildChart(DeckAnalysisResult result)
    {
        var data = new CreatureChartData { CreatureCount = result.CreatureCount };
        if (!result.CreatureSubtypes.Any()) return data;

        // The type-line parser yields a bare "-" / "—" part for every creature whose line uses
        // the standard "Creature - X" separator — that row is the creature total. Relabel it "all".
        var dashKeys = new[] { "-", "\u2014" };
        var dashTotal = result.CreatureSubtypes.Where(kv => dashKeys.Contains(kv.Key)).Sum(kv => kv.Value);
        var subtypes = result.CreatureSubtypes
            .Where(kv => !dashKeys.Contains(kv.Key))
            .OrderByDescending(kv => kv.Value)
            .ToList();
        if (dashTotal > 0)
            subtypes.Insert(0, new KeyValuePair<string, int>("all", dashTotal));

        var max = subtypes.Max(s => s.Value);
        data.Items = subtypes
            .Select(kv =>
            {
                // Whole-percent bar width relative to this chart's max: an int renders
                // identically in any culture (no decimal separator to break the inline style).
                return new CreatureSubtypeItem
                {
                    Name = kv.Key, Count = kv.Value,
                    IsAll = kv.Key == "all",
                    BarWidthPct = (int)Math.Round(kv.Value / (double)max * 100),
                    TotalPct = result.CreatureCount > 0 ? kv.Value / (double)result.CreatureCount * 100 : 0
                };
            })
            .ToList();
        return data;
    }

    private class CreatureChartData
    {
        public List<CreatureSubtypeItem> Items { get; set; } = new();
        public int CreatureCount { get; set; }
    }

    private class CreatureSubtypeItem
    {
        public string Name { get; set; } = "";
        public int Count { get; set; }
        /// <summary>True for the "all" total row (relabeled parser dash) — bold, bright label.</summary>
        public bool IsAll { get; set; }
        /// <summary>Whole-percent bar width — culture-safe int for the inline style.</summary>
        public int BarWidthPct { get; set; }
        /// <summary>Share of all creatures in this chart — display text only.</summary>
        public double TotalPct { get; set; }
    }
}
