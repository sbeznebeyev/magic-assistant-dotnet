@using System.Text
@using MagicAssistant.App.Components.Shared
@using MagicAssistant.Core.Services.DeckCard
@using MagicAssistant.Data.Model
@inject IDeckCardService DeckCardService

@if (!IsOpen) return;

<div class="edit-dialog-overlay" @onclick="OnOverlayClick" @onkeydown="OnKeyDown" tabindex="0" style="outline:none;">
    <div class="edit-dialog-box" @onclick:stopPropagation>
        @* ── Header ── *@
        <div class="edit-header">
            <span class="edit-title">Edit Card</span>
            <button class="close-btn" @onclick="Close" aria-label="Close dialog">✕</button>
        </div>

        @if (_card != null)
        {
            <div class="edit-card-preview">
                <span class="preview-name">@_card.Name</span>
                @if (string.IsNullOrEmpty(ManaCost(_card.Card)))
                {
                    <span class="preview-cost">—</span>
                }
                else
                {
                    @* Mana symbols as SVG sprites — same rendering as the Cost column in CardListView *@
                    <span class="preview-cost"><MagicText Text="@ManaCost(_card.Card)" /></span>
                }
            </div>

            @* ── Form fields ── *@
            <div class="edit-form">
                @* Count is no longer editable here — it lives in the list's −/+ controls. *@

                @* Ownership ── *@
                <div class="form-row">
                    <label class="form-label">Ownership</label>
                    <div class="toggle-group">
                        <button type="button" class="toggle-btn @(_isOwn ? "active" : "")"
                                @onclick="() => _isOwn = true">Owned</button>
                        <button type="button" class="toggle-btn @(!_isOwn ? "active" : "")"
                                @onclick="() => _isOwn = false">Borrowed</button>
                    </div>
                </div>

                @* Price ── *@
                <div class="form-row">
                    <label class="form-label">Price ($)</label>
                    <input type="number" min="0" step="0.01" @bind="_price" @bind:event="oninput"
                           placeholder="0.00" class="form-input" />
                </div>

                @* Comment ── *@
                <div class="form-row">
                    <label class="form-label">Comment</label>
                    <textarea @bind="_comment" @bind:event="oninput" rows="2"
                              placeholder="Notes about this card..." class="form-textarea"></textarea>
                </div>

                @* Grade ── single-select: one of six, or none *@
                <div class="form-row">
                    <label class="form-label">Grade</label>
                    <div class="toggle-group grade-group">
                        @foreach (var g in Grades)
                        {
                            var selected = _grade == g.Grade;
                            <button type="button" class="toggle-btn @(selected ? "active" : "")"
                                    title="@g.Title" @onclick="() => ToggleGrade(g.Grade)">@g.Label</button>
                        }
                    </div>
                </div>

                @* Trading ── toggle + count that appears when pressed *@
                <div class="form-row">
                    <label class="form-label">Trading</label>
                    <div class="trading-row">
                        <button type="button" class="toggle-btn @(_forTradeOn ? "active" : "")"
                                disabled="@(_ownedCount == 0)"
                                title="@(_ownedCount == 0 ? "No owned copies in this deck" : "Mark copies as available for trade")"
                                @onclick="ToggleForTrade">For trade</button>
                        @if (_forTradeOn)
                        {
                            <input type="number" inputmode="numeric" pattern="[0-9]*" min="1" max="@_ownedCount" @bind="_forTradeCount" @bind:event="oninput"
                                   class="form-input form-input-sm no-spin" aria-label="For trade count" />
                            @if (_forTradeCount > _ownedCount)
                            {
                                <span class="field-error">Max @_ownedCount owned</span>
                            }
                        }
                    </div>
                </div>
            </div>

            @* ── Error message ── *@
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="edit-error">@_error</div>
            }

            @* ── Footer ── *@
            <div class="edit-footer">
                <button class="btn-save" @onclick="OnSave" disabled="@_saving">
                    @(_saving ? "Saving..." : "Save")
                </button>
                <button class="btn-cancel" @onclick="Close" disabled="@_saving">Cancel</button>
            </div>
        }
    </div>
</div>

@code {
    private MagicCardPhysical? _card;
    private bool _isOwn = true;
    private float? _price;
    private string _comment = "";
    private CardGrade? _grade;
    private int _forTradeCount = 0;
    private bool _forTradeOn;
    // Total copies of this card in the deck with IsOwn = true — bounds the for-trade count.
    private int _ownedCount;
    private bool _saving;
    private string? _error;

    /// <summary>Grade toggle buttons: label on the button, full name in the tooltip.</summary>
    private static readonly (CardGrade Grade, string Label, string Title)[] Grades =
    {
        (CardGrade.GemMint, "M", "GEM MINT / MINT"),
        (CardGrade.NearMint, "NM", "NEAR MINT"),
        (CardGrade.SlightlyPlayed, "SP", "SLIGHTLY PLAYED"),
        (CardGrade.ModeratelyPlayed, "MP", "MODERATELY PLAYED"),
        (CardGrade.HeavilyPlayed, "HP", "HEAVILY PLAYED"),
        (CardGrade.Damaged, "DMG", "DAMAGED"),
    };

    // ── Two-way binding pattern (IsOpen / IsOpenChanged) ──
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter] public MagicCardPhysical? Card { get; set; }
    [Parameter] public int? DeckId { get; set; }
    [Parameter] public EventCallback<MagicCardPhysical?> OnSaved { get; set; }

    protected override Task OnParametersSetAsync()
    {
        if (IsOpen && Card != _card)
            return LoadCard(Card);
        return Task.CompletedTask;
    }

    private async Task LoadCard(MagicCardPhysical? card)
    {
        _card = card;
        if (card == null) return;

        _isOwn = card.IsOwn;
        _price = card.MyPrice > 0 ? card.MyPrice : (float?)null;
        _comment = card.Comment ?? "";
        _grade = card.Grade;
        _forTradeCount = card.GetForTradeCount();
        _forTradeOn = _forTradeCount > 0;
        _ownedCount = DeckId.HasValue ? await DeckCardService.GetOwnedCountAsync(DeckId.Value, card.Id) : 0;
        _error = null;
    }

    private async Task OnSave()
    {
        if (_card == null || !DeckId.HasValue) return;

        _saving = true;
        _error = null;
        var saved = false;

        try
        {
            // Count is excluded on purpose — it is managed by the list's −/+ controls.
            if (_forTradeCount > _ownedCount)
            {
                _error = $"For trade count ({_forTradeCount}) exceeds owned copies ({_ownedCount}).";
                return;
            }

            var updates = new Dictionary<MagicCardField, object?>();

            if (_isOwn != _card.IsOwn)
                updates[MagicCardField.IsOwn] = _isOwn;

            if (_price.HasValue && _price.Value != _card.MyPrice)
                updates[MagicCardField.MyPrice] = _price.Value;

            if (_comment != (_card.Comment ?? ""))
                updates[MagicCardField.Comment] = _comment.Trim();

            // null clears the column, a value stores the enum as an integer
            if (_grade != _card.Grade)
                updates[MagicCardField.Grade] = _grade;

            if (_forTradeCount != _card.GetForTradeCount())
                updates[MagicCardField.ForTradeCount] = _forTradeCount;

            if (updates.Count > 0)
            {
                var success = await DeckCardService.UpdateCardAsync(DeckId.Value, _card.Id, updates);
                if (!success)
                {
                    _error = "Failed to update card.";
                    return;
                }
            }

            await OnSaved.InvokeAsync(_card);
            saved = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }

        // Close after finally: Close() guards on _saving, which is still true inside the try block.
        if (saved) await Close();
    }

    /// <summary>Mana cost for the preview; double-sided cards show "front // back" (same rule as CardListView).</summary>
    private static string ManaCost(MagicCard card)
    {
        if (!string.IsNullOrWhiteSpace(card.ManaCost))
            return card.ManaCost;

        if (card.CardFaces is null || card.CardFaces.Length == 0)
            return string.Empty;

        var sb = new StringBuilder(card.CardFaces[0].ManaCost);

        if (card.CardFaces.Length > 1)
            sb.Append($" // {card.CardFaces[1].ManaCost}");

        return sb.ToString();
    }

    /// <summary>Grade is single-select: clicking the active button clears it, any other selects.</summary>
    private void ToggleGrade(CardGrade grade) => _grade = _grade == grade ? null : grade;

    private void ToggleForTrade()
    {
        if (_forTradeOn)
        {
            _forTradeOn = false;
            _forTradeCount = 0;
        }
        else
        {
            _forTradeOn = true;
            if (_forTradeCount <= 0)
                _forTradeCount = Math.Min(1, _ownedCount);
        }
    }

    // ── Close helpers ──
    private async Task Close()
    {
        if (_saving) return;
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task OnOverlayClick() => await Close();

    // async Task, not void: rule 8 forbids fire-and-forget — the close must be awaited
    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            await Close();
    }
}
