@using MagicAssistant.App.Shared
@using MagicAssistant.Data.Model
@using MagicAssistant.Data.Model.NavigatorNodes

@if (!IsOpen) return;

<div class="filter-dialog-overlay" @onkeydown="OnKeyDown" tabindex="0" style="outline:none;">
    <div class="filter-dialog-box" @onclick:stopPropagation>
        @* ── Header ── *@
        <div class="filter-header">
            <span class="filter-title">Card Filter</span>
            <button class="close-btn" @onclick="Close" aria-label="Close dialog">✕</button>
        </div>

        @* ── Search (FTS5) — draft input; committed to FilterViewModel only via Apply/Enter ── *@
        <div class="filter-search">
            <SearchControl Value="@_searchDraft" ValueChanged="@(v => _searchDraft = v)" OnEnter="OnApply" />
        </div>

        @* ── Fields — all bound directly to shared FilterViewModel ── *@
        <div class="filter-tab-content">
                @* ── Locations — location mode only. Chips own the selected context:
                   exactly one chip ⇔ the selected node; 0/≥2 chips = browse all/selected locations.
                   Draft until Apply — like every other filter in this dialog. ── *@
                @if (FilterViewModel.InLocationsMode)
                {
                <div class="filter-field-row">
                    <label class="filter-label">Locations</label>
                    <MultiSelectList ViewModel="@_locationVm"
                                    @bind-IsAddDialogOpen="_showLocationPicker"
                                    OnAddItemClicked="OnLocationPickerOpening"
                                    OnItemRemoved="OnLocationRemoved"
                                    OnCleared="OnLocationCleared">
                        <AddDialogContent>
                            <div class="locations-picker">
                                <div class="locations-picker-list">
                                    @foreach (var (node, label, depth) in _locationOptions)
                                    {
                                        @if (node.NodeType == NodeType.Folder)
                                        {
                                            <div class="locations-folder-header" style="padding-left:@(4 + depth * 14)px">@label</div>
                                        }
                                        else
                                        {
                                            @* Toggle buttons in the mana-color style — one click to select *@
                                            <button type="button"
                                                    class="color-toggle location-toggle @(_locationDraft.Contains(node.Id) ? "active" : "")"
                                                    style="margin-left:@(depth * 14)px; max-width:calc(100% - @(depth * 14)px)"
                                                    @onclick="() => ToggleLocationInPicker(node.Id)">
                                                @label
                                            </button>
                                        }
                                    }
                                </div>
                                <div class="sets-picker-footer">
                                    <button type="button" class="picker-btn picker-btn-apply" @onclick="OnLocationPickerApply">Apply</button>
                                    <button type="button" class="picker-btn picker-btn-cancel" @onclick="OnLocationPickerCancel">Cancel</button>
                                </div>
                            </div>
                        </AddDialogContent>
                    </MultiSelectList>
                </div>
                }

                @* Sets scope is editable only in KB mode; in any location mode (single node or
                   locations browse) it is driven by the node chips — in browse the auto-scope is the
                   union of all selected nodes' sets, which would flood the chip area. *@
                @if (!FilterViewModel.InLocationsMode)
                {
                <div class="filter-field-row">
                    <label class="filter-label">Sets</label>
                    <MultiSelectList ViewModel="@_setVm"
                                    @bind-IsAddDialogOpen="_showSetPicker"
                                    OnAddItemClicked="OnSetPickerOpening"
                                    OnItemRemoved="OnSetRemoved"
                                    OnCleared="OnSetCleared">
                        <AddDialogContent>
                            <div class="sets-picker">
                                <input class="sets-picker-search"
                                       placeholder="Filter sets..."
                                       value="@_setSearchText"
                                       @oninput="@(e => { _setSearchText = e.Value?.ToString() ?? ""; ApplySetPickerFilter(); })" />
                                <div class="sets-picker-list">
                                    @foreach (var s in _filteredPickerSets)
                                    {
                                        <label class="set-option @(_pickerSelected.Contains(s.SetCode) ? "set-option-selected" : "")">
                                            <input type="checkbox"
                                                   checked="@_pickerSelected.Contains(s.SetCode)"
                                                   @onchange="() => ToggleSetInPicker(s.SetCode)" />
                                            <span class="set-icon set-symbol set-symbol-@s.SetCode"></span>
                                            <span class="set-option-name">@s.Name</span>
                                            <span class="set-option-code">@s.SetCode</span>
                                        </label>
                                    }
                                </div>
                                <div class="sets-picker-footer">
                                    <button type="button" class="picker-btn picker-btn-apply" @onclick="OnSetPickerApply">Apply</button>
                                    <button type="button" class="picker-btn picker-btn-cancel" @onclick="OnSetPickerCancel">Cancel</button>
                                </div>
                            </div>
                        </AddDialogContent>
                    </MultiSelectList>
                </div>
                }

                <div class="filter-field-row">
                    <label class="filter-label">Type</label>
                    <MultiSelectList ViewModel="@_typeVm"
                                    @bind-IsAddDialogOpen="_showTypePicker"
                                    OnItemRemoved="OnTypeRemoved"
                                    OnCleared="OnTypeCleared">
                        <AddDialogContent>
                            <div class="type-picker-list">
                                @foreach (var type in _allTypes)
                                {
                                    <button type="button"
                                            class="@GetTypeOptionClass(type)"
                                            @onclick="() => OnSelectType(type)">
                                        <span>@type</span>
                                    </button>
                                }
                            </div>
                        </AddDialogContent>
                    </MultiSelectList>
                </div>

                <div class="filter-field-row">
                    <label class="filter-label">Rarity</label>
                    <MultiSelectList ViewModel="@_rarityVm"
                                    @bind-IsAddDialogOpen="_showRarityPicker"
                                    OnItemRemoved="OnRarityRemoved"
                                    OnCleared="OnRarityCleared">
                        <AddDialogContent>
                            <div class="rarity-picker-list">
                                @foreach (var rarity in _allRarities)
                                {
                                    <button type="button"
                                            class="@GetRarityOptionClass(rarity)"
                                            @onclick="() => OnSelectRarity(rarity)">
                                        <span class="rarity-dot" style="background-color: @GetRarityColor(rarity)"></span>
                                        <span>@rarity</span>
                                    </button>
                                }
                            </div>
                        </AddDialogContent>
                    </MultiSelectList>
                </div>

                <div class="filter-field-row">
                    <label class="filter-label">Color</label>
                    @* ── Base colors (icons only) ── *@
                    <div class="color-toggle-grid color-toggle-grid-6">
                        <button type="button" class="color-toggle color-icon-btn @(FilterViewModel.ColorFilters[ColorBitFlags.W] ? "active" : "")" @onclick="() => ToggleColorFlag(ColorBitFlags.W)"><span class="card-symbol card-symbol-W"></span></button>
                        <button type="button" class="color-toggle color-icon-btn @(FilterViewModel.ColorFilters[ColorBitFlags.U] ? "active" : "")" @onclick="() => ToggleColorFlag(ColorBitFlags.U)"><span class="card-symbol card-symbol-U"></span></button>
                        <button type="button" class="color-toggle color-icon-btn @(FilterViewModel.ColorFilters[ColorBitFlags.B] ? "active" : "")" @onclick="() => ToggleColorFlag(ColorBitFlags.B)"><span class="card-symbol card-symbol-B"></span></button>
                        <button type="button" class="color-toggle color-icon-btn @(FilterViewModel.ColorFilters[ColorBitFlags.R] ? "active" : "")" @onclick="() => ToggleColorFlag(ColorBitFlags.R)"><span class="card-symbol card-symbol-R"></span></button>
                        <button type="button" class="color-toggle color-icon-btn @(FilterViewModel.ColorFilters[ColorBitFlags.G] ? "active" : "")" @onclick="() => ToggleColorFlag(ColorBitFlags.G)"><span class="card-symbol card-symbol-G"></span></button>
                        <button type="button" class="color-toggle color-icon-btn @(FilterViewModel.ColorFilters[ColorBitFlags.C] ? "active" : "")" @onclick="() => ToggleColorFlag(ColorBitFlags.C)"><span class="card-symbol card-symbol-C"></span></button>
                    </div>
                    @* ── Color types ── *@
                    <div class="color-toggle-grid">
                        <button type="button" class="color-toggle @(FilterViewModel.ColorFilters[ColorBitFlags.MULTI] ? "active" : "")" @onclick="() => ToggleColorFlag(ColorBitFlags.MULTI)">Multi-Color</button>
                        <button type="button" class="color-toggle @(FilterViewModel.ColorFilters[ColorBitFlags.MONO] ? "active" : "")" @onclick="() => ToggleColorFlag(ColorBitFlags.MONO)">Mono-Color</button>
                        <button type="button" class="color-toggle @(FilterViewModel.ColorFilters[ColorBitFlags.HYBRID] ? "active" : "")" @onclick="() => ToggleColorFlag(ColorBitFlags.HYBRID)">Hybrid</button>
                    </div>
                    @* ── Modifiers ── *@
                    <div class="color-toggle-grid">
                        <button type="button" class="color-toggle @(FilterViewModel.ColorAndMode ? "active" : "")" @onclick="() => FilterViewModel.ColorAndMode = !FilterViewModel.ColorAndMode">And</button>
                        <button type="button" class="color-toggle @(FilterViewModel.ColorOnlyMode ? "active" : "")" @onclick="() => FilterViewModel.ColorOnlyMode = !FilterViewModel.ColorOnlyMode">Only</button>
                        <button type="button" class="color-toggle @(FilterViewModel.ColorIdentityMode ? "active" : "")" @onclick="() => FilterViewModel.ColorIdentityMode = !FilterViewModel.ColorIdentityMode">Identity</button>
                    </div>
                </div>

                <div class="filter-field-row">
                    <label class="filter-label">Properties</label>
                    <div class="props-inline">
                        <div class="prop-row">
                            <span class="prop-title">P</span>
                            <select class="prop-op" value="@FilterViewModel.PowerOp"
                                    @onchange="@(e => FilterViewModel.PowerOp = e.Value?.ToString() ?? ">=")">
                                <option value=">=" selected="@(FilterViewModel.PowerOp == ">=")">&gt;=</option>
                                <option value="=" selected="@(FilterViewModel.PowerOp == "=")">=</option>
                                <option value="<=" selected="@(FilterViewModel.PowerOp == "<=")">&#60;&#61;</option>
                            </select>
                            <input type="text" inputmode="decimal" class="prop-value"
                                   value="@FilterViewModel.PowerValue"
                                   @oninput="@(e => FilterViewModel.PowerValue = FilterInputSanitizer.SanitizeNumeric(e.Value?.ToString() ?? ""))"
                                   placeholder="0" />
                        </div>
                        <div class="prop-row">
                            <span class="prop-title">T</span>
                            <select class="prop-op" value="@FilterViewModel.ToughnessOp"
                                    @onchange="@(e => FilterViewModel.ToughnessOp = e.Value?.ToString() ?? ">=")">
                                <option value=">=" selected="@(FilterViewModel.ToughnessOp == ">=")">&gt;=</option>
                                <option value="=" selected="@(FilterViewModel.ToughnessOp == "=")">=</option>
                                <option value="<=" selected="@(FilterViewModel.ToughnessOp == "<=")">&#60;&#61;</option>
                            </select>
                            <input type="text" inputmode="decimal" class="prop-value"
                                   value="@FilterViewModel.ToughnessValue"
                                   @oninput="@(e => FilterViewModel.ToughnessValue = FilterInputSanitizer.SanitizeNumeric(e.Value?.ToString() ?? ""))"
                                   placeholder="0" />
                        </div>
                        <div class="prop-row">
                            <span class="prop-title">Cmc</span>
                            <select class="prop-op" value="@FilterViewModel.CmcOp"
                                    @onchange="@(e => FilterViewModel.CmcOp = e.Value?.ToString() ?? ">=")">
                                <option value=">=" selected="@(FilterViewModel.CmcOp == ">=")">&gt;=</option>
                                <option value="=" selected="@(FilterViewModel.CmcOp == "=")">=</option>
                                <option value="<=" selected="@(FilterViewModel.CmcOp == "<=")">&#60;&#61;</option>
                            </select>
                            <input type="text" inputmode="decimal" class="prop-value"
                                   value="@FilterViewModel.CmcValue"
                                   @oninput="@(e => FilterViewModel.CmcValue = FilterInputSanitizer.SanitizeNumeric(e.Value?.ToString() ?? ""))"
                                   placeholder="0" />
                        </div>
                    </div>
                </div>
        </div>

        @* ── Footer: Advanced opens the auxiliary dialog (left); commit actions stay right ── *@
        <div class="filter-footer">
            <button type="button" class="btn-advanced" @onclick="() => _showAdvanced = true">Advanced</button>
            <div class="filter-footer-actions">
                <button class="btn-apply @(FilterViewModel.IsDirty ? "btn-dirty" : "")" @onclick="OnApply">Apply</button>
                <button class="btn-clear" @onclick="OnClearAndApply">Clear All</button>
                <button class="btn-cancel" @onclick="Close">Cancel</button>
            </div>
        </div>
    </div>
</div>

<CardFilterAdvancedDialog FilterViewModel="@FilterViewModel"
                          IsOpen="@_showAdvanced"
                          IsOpenChanged="@(v => _showAdvanced = v)" />

@code {
    /// <summary>Shared filter/sort view model — mutations here propagate to CardsListControl.</summary>
    [Parameter] public required FilterViewModel FilterViewModel { get; set; } = new();

    /// <summary>Locations chips were committed (Apply) — MainLayout syncs the selected context:
    /// exactly one chip promotes that node to selected, zero/several drop the selection.
    /// Fired BEFORE FilterViewModel.Apply(), so the list re-queries exactly once.</summary>
    [Parameter] public EventCallback<List<int>> OnLocationsApplied { get; set; }

    // ── Rarity MultiSelectList ──
    private readonly MultiSelectViewModel<string, string> _rarityVm = new();
    private bool _showRarityPicker;
    private static readonly string[] _allRarities = { "common", "uncommon", "rare", "mythic" };

    // ── Type MultiSelectList ──
    private readonly MultiSelectViewModel<string, string> _typeVm = new();
    private bool _showTypePicker;
    private static readonly string[] _allTypes = { "artifact", "creature", "enchantment", "instant", "land", "planeswalker", "sorcery" };

    // ── Sets MultiSelectList ──
    private readonly MultiSelectViewModel<string, CardSet> _setVm = new();
    private bool _showSetPicker;

    /// <summary>Catalog of sets for the picker: all KB sets, or only the current node's sets in location mode.</summary>
    private List<CardSet> _allPickerSets = new();

    /// <summary>Catalog narrowed by the picker search text (in memory only).</summary>
    private List<CardSet> _filteredPickerSets = new();
    private string _setSearchText = "";

    /// <summary>Staged selection inside the open picker; committed to FilterViewModel on Apply.</summary>
    private readonly HashSet<string> _pickerSelected = new(StringComparer.OrdinalIgnoreCase);

    private bool _wasDialogOpen;

    [Inject] private IDbCardStore DbStore { get; set; } = default!;
    [Inject] private IDeckCardService DeckCardService { get; set; } = default!;

    // ── Auxiliary Advanced dialog (Artist/Layout/Legality/Other/Collection) ──
    private bool _showAdvanced;

    // ── Two-way binding pattern (IsOpen / IsOpenChanged) ──
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>Forwarded to MainLayout so the status bar keeps reporting search commits.</summary>
    [Parameter] public EventCallback<string> OnSearchCompleted { get; set; }

    /// <summary>FTS5 draft — lives only in the dialog; committed to FilterViewModel.SearchQuery
    /// on Apply (or Enter in the search field). Resynced from the model on every open.</summary>
    private string _searchDraft = string.Empty;

    /// <summary>Apply: single commit point — search draft, location chips, then one re-query.</summary>
    private async Task OnApply()
    {
        var query = _searchDraft.Trim();
        if (query != FilterViewModel.SearchQuery)
        {
            FilterViewModel.SearchQuery = query;
            await OnSearchCompleted.InvokeAsync(query);
        }
        // Chips own the selected context: commit the draft, let MainLayout sync selected
        // (1 chip → select that node; 0/≥2 → drop selection), then fire the single re-query.
        if (FilterViewModel.InLocationsMode)
        {
            var committed = _locationDraft.ToList();
            FilterViewModel.SetLocationChips(committed);
            await OnLocationsApplied.InvokeAsync(committed);
        }
        FilterViewModel.Apply();  // fires Changed → CardsListControl wraps in InvokeAsync
        await Close();
    }

    /// <summary>Clear all filter/sort fields and trigger re-query. Clear All clears the location
    /// chips too (agreed semantics): draft empties → search across ALL locations, and MainLayout
    /// drops the selected context together with the last chip.</summary>
    private async Task OnClearAndApply()
    {
        _searchDraft = string.Empty;
        if (FilterViewModel.InLocationsMode)
        {
            _locationDraft.Clear();
            SyncLocationChips();
            await OnLocationsApplied.InvokeAsync(new List<int>());
        }
        FilterViewModel.ClearAndApply();  // clears + fires Changed (chips included — Clear() empties them)
        await Close();
    }

    // ── Sync rarity + type from FilterViewModel on open ──
    protected override async Task OnParametersSetAsync()
    {
        _rarityVm.Initialize(
            FilterViewModel.Rarity.Select(r => (Key: r, Item: r)),
            r => r);

        _typeVm.Initialize(
            FilterViewModel.TypeFilter.Select(t => (Key: t, Item: t)),
            t => t);

        // Load the set catalog once per open and sync the chips from the current scope.
        if (IsOpen && !_wasDialogOpen)
        {
            _searchDraft = FilterViewModel.SearchQuery;
            await LoadSetsForPickerAsync();
            SyncSetChipsFromScope();
            if (FilterViewModel.InLocationsMode)
            {
                await LoadLocationsAsync();
                _locationDraft.Clear();
                foreach (var id in FilterViewModel.LocationNodeIds)
                    AddDraftWithSideboard(id);
                SyncLocationChips();
            }
        }
        _wasDialogOpen = IsOpen;
    }

    // ── Sets picker: catalog, search, staged selection ──
    private async Task LoadSetsForPickerAsync()
    {
        List<CardSet> sets;
        if (FilterViewModel.CurrentCollectionId.HasValue)
        {
            // Location mode: only the sets present in this node's cards — one DISTINCT query
            // (the old path materialized every card with faces just to project SetCode).
            var codes = (await DeckCardService.GetNodeSetCodesAsync(FilterViewModel.CurrentCollectionId.Value)).ToList();
            sets = codes.Count == 0 ? new List<CardSet>() : (await DbStore.GetCardSetsByCodesAsync(codes)).ToList();
        }
        else
        {
            sets = (await DbStore.GetCardSetsAsync()).ToList();
        }

        // Same display order as the sidebar: newest release first, then by parent set code.
        _allPickerSets = sets
            .OrderByDescending(s => s.ReleaseDate ?? DateTime.MinValue)
            .ThenBy(s => s.ParentSetCode)
            .ToList();
    }

    private void SyncSetChipsFromScope()
    {
        var byCode = _allPickerSets.ToDictionary(s => s.SetCode, StringComparer.OrdinalIgnoreCase);
        _setVm.Initialize(
            FilterViewModel.FilteredSetCodes.Select(code =>
                (Key: code, Item: byCode.TryGetValue(code, out var set) ? set : new CardSet(Guid.NewGuid(), code, code))),
            s => s.Name);
    }

    private void OnSetPickerOpening()
    {
        _pickerSelected.Clear();
        foreach (var code in FilterViewModel.FilteredSetCodes)
            _pickerSelected.Add(code);
        _setSearchText = "";
        ApplySetPickerFilter();
    }

    private void ApplySetPickerFilter()
    {
        if (_setSearchText.Length < 2)
        {
            _filteredPickerSets = _allPickerSets;
            return;
        }
        var q = _setSearchText.ToLowerInvariant();
        _filteredPickerSets = _allPickerSets
            .Where(s => s.Name.ToLowerInvariant().Contains(q) || s.SetCode.ToLowerInvariant().Contains(q))
            .ToList();
    }

    private void ToggleSetInPicker(string setCode)
    {
        if (!_pickerSelected.Remove(setCode))
            _pickerSelected.Add(setCode);
    }

    private void OnSetPickerApply()
    {
        // Commit the staged selection to the scope — FilteredCardSetsCollection reloads on the next query.
        FilterViewModel.SetFilteredSetCodes(_pickerSelected);
        SyncSetChipsFromScope();
        _showSetPicker = false;
    }

    private void OnSetPickerCancel() => _showSetPicker = false;

    private void OnSetRemoved(MultiSelectItemBase item)
    {
        // Chips are live, like Type/Rarity: a removal commits the remaining codes to the scope.
        FilterViewModel.SetFilteredSetCodes(_setVm.GetAllItems().Select(s => s.SetCode));
    }

    private void OnSetCleared()
    {
        // Bulk clear mirrors the last-chip removal: empty scope = all sets in the KB.
        FilterViewModel.SetFilteredSetCodes(Enumerable.Empty<string>());
    }

    // ── Locations MultiSelectList (location mode only) ──
    private readonly MultiSelectViewModel<int, LocationNodeInfo> _locationVm = new();
    private bool _showLocationPicker;
    private List<LocationNodeInfo> _allLocationNodes = new();
    private List<(LocationNodeInfo Node, string Label, int Depth)> _locationOptions = new();

    /// <summary>Draft of the chip selection for this dialog session — committed to FilterViewModel
    /// (and to the selected context via MainLayout) only on Apply, like every other filter here.
    /// Chip removals and picker toggles both mutate the draft; picker Cancel restores the snapshot
    /// taken when the picker opened.</summary>
    private readonly HashSet<int> _locationDraft = new();
    private HashSet<int> _locationPickerSnapshot = new();

    // ── Locations picker: catalog, tree order, draft selection ──
    private async Task LoadLocationsAsync()
    {
        _allLocationNodes = (await DeckCardService.GetLocationNodesAsync()).ToList();
        _locationOptions = BuildLocationOptions(_allLocationNodes);
    }

    /// <summary>Tree order for the picker: root collections and decks first (alphabetical together),
    /// then folder sections (alphabetical); inside each folder the same rule. Sideboards are NOT
    /// selectable rows — a deck carries its sideboard implicitly (see
    /// <see cref="AddDraftWithSideboard"/>); the only sideboard chip that can appear is the one
    /// matching the navigator-selected sideboard.</summary>
    private static List<(LocationNodeInfo Node, string Label, int Depth)> BuildLocationOptions(List<LocationNodeInfo> nodes)
    {
        var byParent = nodes.GroupBy(n => n.ParentId).ToDictionary(g => g.Key ?? -1, g => g.ToList());
        var result = new List<(LocationNodeInfo, string, int)>();

        void Walk(int? parentId, int depth)
        {
            if (!byParent.TryGetValue(parentId ?? -1, out var children)) return;
            // Root and inside folders: collections and decks first, alphabetically together;
            // then folder sections, alphabetically. Sideboards are never rows (deck-carried).
            foreach (var node in children
                         .Where(n => n.NodeType != NodeType.Sideboard)
                         .OrderBy(n => n.NodeType == NodeType.Folder ? 1 : 0)
                         .ThenBy(n => n.Name, StringComparer.OrdinalIgnoreCase))
            {
                if (node.NodeType == NodeType.Folder)
                {
                    result.Add((node, node.Name, depth));
                    Walk(node.Id, depth + 1);
                }
                else
                {
                    result.Add((node, node.Name, depth));
                }
            }
        }

        Walk(null, 0);
        return result;
    }

    /// <summary>Rebuild the chips from the draft. Sideboards carried by a drafted deck stay
    /// invisible — chips show collections and decks only; a sideboard without its deck in the draft
    /// (the navigator-selected sideboard) keeps its own chip. A draft id without a node (vanished
    /// between open and sync) keeps a #id placeholder.</summary>
    private void SyncLocationChips()
    {
        var visible = _locationDraft.Where(id =>
        {
            var n = _allLocationNodes.FirstOrDefault(x => x.Id == id);
            return n is null || n.NodeType != NodeType.Sideboard || !_locationDraft.Contains(n.ParentId ?? -1);
        });
        _locationVm.Initialize(
            visible.Select(id => (Key: id, Item: _allLocationNodes.FirstOrDefault(n => n.Id == id)
                                     ?? new LocationNodeInfo(id, $"#{id}", NodeType.Collection, null))),
            n => n.Name);
    }

    private void OnLocationPickerOpening() => _locationPickerSnapshot = new HashSet<int>(_locationDraft);

    /// <summary>Locations-filter-only default: a selected deck brings its sideboard along — the
    /// typical "browse the deck" intent includes the sideboard. The user may still uncheck the
    /// sideboard alone afterwards; unchecking the deck removes the pair again (a lone sideboard
    /// chip without its deck is left alone — it is a legitimate standalone selection).</summary>
    private void AddDraftWithSideboard(int id)
    {
        _locationDraft.Add(id);
        if (_allLocationNodes.FirstOrDefault(n => n.Id == id)?.NodeType == NodeType.Deck)
        {
            var sb = _allLocationNodes.FirstOrDefault(n => n.NodeType == NodeType.Sideboard && n.ParentId == id);
            if (sb != null)
                _locationDraft.Add(sb.Id);
        }
    }

    private void ToggleLocationInPicker(int id)
    {
        if (_locationDraft.Remove(id))
        {
            // Turning the deck off turns its sideboard off too (they came in as a pair).
            var sb = _allLocationNodes.FirstOrDefault(n => n.NodeType == NodeType.Sideboard && n.ParentId == id);
            if (sb != null)
                _locationDraft.Remove(sb.Id);
        }
        else
        {
            AddDraftWithSideboard(id);
        }
    }

    private void OnLocationPickerApply()
    {
        SyncLocationChips();          // draft → chips; the dialog's Apply commits
        _showLocationPicker = false;  // same close contract as the Sets picker
    }

    private void OnLocationPickerCancel()
    {
        _locationDraft.Clear();
        foreach (var id in _locationPickerSnapshot)
            _locationDraft.Add(id);
        SyncLocationChips();
        _showLocationPicker = false;  // same close contract as the Sets picker
    }

    private void OnLocationRemoved(MultiSelectItemBase item)
    {
        // Chips are live like Type/Rarity/Sets: removal drops the node from the draft immediately
        // (still uncommitted until Apply). The chip carries its node id as the key — exact match,
        // no name lookup (two drafted decks may share a name).
        if (item is not MultiSelectItem<int, LocationNodeInfo> chip)
            return;
        _locationDraft.Remove(chip.Key);
        // Removing a deck chip also removes its auto-added sideboard — the pair leaves together.
        if (chip.Item.NodeType == NodeType.Deck)
        {
            var sb = _allLocationNodes.FirstOrDefault(n => n.NodeType == NodeType.Sideboard && n.ParentId == chip.Key);
            if (sb != null)
                _locationDraft.Remove(sb.Id);
        }
        SyncLocationChips();
    }

    private void OnLocationCleared()
    {
        // Bulk clear = no chips = search across ALL locations (draft emptied; Apply commits).
        _locationDraft.Clear();
        SyncLocationChips();
    }

    // ── Rarity MultiSelectList handlers ──
    private void OnRarityRemoved(MultiSelectItemBase item)
    {
        SyncRarityToFilterViewModel();
    }

    private void OnRarityCleared() => SyncRarityToFilterViewModel();

    private void OnSelectRarity(string rarity)
    {
        if (!_rarityVm.Items.Any(i => i.DisplayValue == rarity))
        {
            _rarityVm.AddNewItem(rarity, rarity, r => r);
        }
        SyncRarityToFilterViewModel();
        _showRarityPicker = false;
    }

    private void SyncRarityToFilterViewModel()
    {
        FilterViewModel.Rarity = _rarityVm.Items.Select(i => i.DisplayValue).ToList();
    }

    private string GetRarityOptionClass(string rarity)
    {
        bool selected = _rarityVm.Items.Any(i => i.DisplayValue == rarity);
        return "rarity-option" + (selected ? " rarity-option-selected" : "");
    }

    private static string GetRarityColor(string rarity) => rarity switch
    {
        "common" => "#999999",
        "uncommon" => "#a0522d",
        "rare" => "#ffd700",
        "mythic" => "#c0392b",
        _ => "#888888"
    };

    // ── Type MultiSelectList handlers ──
    private void OnTypeRemoved(MultiSelectItemBase item)
    {
        SyncTypeToFilterViewModel();
    }

    private void OnTypeCleared() => SyncTypeToFilterViewModel();

    private void OnSelectType(string type)
    {
        if (!_typeVm.Items.Any(i => i.DisplayValue == type))
        {
            _typeVm.AddNewItem(type, type, t => t);
        }
        SyncTypeToFilterViewModel();
        _showTypePicker = false;
    }

    private void SyncTypeToFilterViewModel()
    {
        FilterViewModel.SetTypeFilters(_typeVm.Items.Select(i => i.DisplayValue));
    }

    private string GetTypeOptionClass(string type)
    {
        bool selected = _typeVm.Items.Any(i => i.DisplayValue == type);
        return "type-option" + (selected ? " type-option-selected" : "");
    }

    // ── Color toggle button ──
    private void ToggleColorFlag(ColorBitFlags flag)
    {
        FilterViewModel.ColorFilters[flag] = !FilterViewModel.ColorFilters[flag];
    }

    // ── Close helpers ──
    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        // Nested layers (pickers, Advanced sub-dialog) own the keyboard while open —
        // Enter there must never commit the whole dialog.
        if (_showSetPicker || _showLocationPicker || _showAdvanced) return;
        if (e.Key == "Escape")
            await Close();
        else if (e.Key == "Enter")
            await OnApply();  // global Enter = Apply (agreed): one action for the whole dialog
    }
}
