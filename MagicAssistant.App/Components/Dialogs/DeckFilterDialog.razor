@if (!IsOpen) return;

<div class="deck-filter-overlay" @onclick="OnOverlayClick">
    <div class="deck-filter-box" @onclick:stopPropagation="true">
        @* ── Header ── *@
        <div class="deck-filter-header">
            <span class="deck-filter-title">Deck Filter</span>
            <button class="close-btn" @onclick="Close">✕</button>
        </div>

        @* ── Tabs ── *@
        <div class="deck-filter-tabs">
            <button class="deck-filter-tab @(_tab == "quick" ? "active" : "")" @onclick="OnQuickTab">Quick</button>
            <button class="deck-filter-tab @(_tab == "advanced" ? "active" : "")" @onclick="OnAdvancedTab">Advanced</button>
        </div>

        @* ── Quick Filters Tab ── *@
        @if (_tab == "quick")
        {
            <div class="deck-filter-content">
                @* Ownership ── *@
                <div class="filter-section">
                    <label class="section-label">Ownership</label>
                    <div class="radio-group">
                        <label class="radio-label">
                            <input type="radio" @bind="_ownershipFilter" @bind:value="all" /> All
                        </label>
                        <label class="radio-label">
                            <input type="radio" @bind="_ownershipFilter" @bind:value="owned" /> Owned
                        </label>
                        <label class="radio-label">
                            <input type="radio" @bind="_ownershipFilter" @bind:value="borrowed" /> Borrowed
                        </label>
                    </div>
                </div>

                @* Card Count ── *@
                <div class="filter-section">
                    <label class="section-label">Card Count</label>
                    <div class="range-row">
                        <input type="number" min="1" max="4" @bind="_minCount" @bind:event="oninput" class="range-input" placeholder="Min" />
                        <span class="range-sep">—</span>
                        <input type="number" min="1" max="4" @bind="_maxCount" @bind:event="oninput" class="range-input" placeholder="Max" />
                    </div>
                </div>

                @* Price Range ── *@
                <div class="filter-section">
                    <label class="section-label">Price Range ($)</label>
                    <div class="range-row">
                        <input type="number" min="0" step="0.01" @bind="_minPrice" @bind:event="oninput" class="range-input" placeholder="Min" />
                        <span class="range-sep">—</span>
                        <input type="number" min="0" step="0.01" @bind="_maxPrice" @bind:event="oninput" class="range-input" placeholder="Max" />
                    </div>
                </div>

                @* Has special tag ── *@
                <div class="filter-section">
                    <label class="section-label">Special Tags</label>
                    <div class="tag-filters">
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="_hasFoil" /> Foil
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="_hasForTrade" /> For Trade
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="_hasComment" /> Has Comment
                        </label>
                    </div>
                </div>
            </div>
        }

        @* ── Advanced Tab ── *@
        @if (_tab == "advanced")
        {
            <div class="deck-filter-content">
                @* Text search ── *@
                <div class="filter-section">
                    <label class="section-label">Search</label>
                    <textarea @bind="_textSearch" @bind:event="oninput" rows="2" class="filter-textarea" placeholder="Filter by name, type, text..."></textarea>
                </div>

                @* Type filter ── *@
                <div class="filter-section">
                    <label class="section-label">Card Type</label>
                    <input @bind="_typeFilter" @bind:event="oninput" class="filter-input" placeholder="e.g. Creature, Land" />
                </div>

                @* Set filter ── *@
                <div class="filter-section">
                    <label class="section-label">Set</label>
                    <input @bind="_setFilter" @bind:event="oninput" class="filter-input" placeholder="e.g. M19, STH" />
                </div>

                @* Color filter ── *@
                <div class="filter-section">
                    <label class="section-label">Color</label>
                    <select @bind="_colorFilter" @bind:event="onchange" class="filter-select">
                        <option value="">Any</option>
                        <option value="W">White</option>
                        <option value="U">Blue</option>
                        <option value="B">Black</option>
                        <option value="R">Red</option>
                        <option value="G">Green</option>
                        <option value="colorless">Colorless</option>
                    </select>
                </div>
            </div>
        }

        @* ── Footer ── *@
        <div class="deck-filter-footer">
            <button class="btn-apply" @onclick="OnApply">Apply</button>
            <button class="btn-clear" @onclick="OnClear">Clear</button>
            <button class="btn-cancel" @onclick="Close">Cancel</button>
        </div>
    </div>
</div>

@code {
    private string _tab = "quick";

    // Quick filters
    private string _ownershipFilter = "all";
    private int? _minCount;
    private int? _maxCount;
    private float? _minPrice;
    private float? _maxPrice;
    private bool _hasFoil;
    private bool _hasForTrade;
    private bool _hasComment;

    // Advanced filters
    private string? _textSearch;
    private string? _typeFilter;
    private string? _setFilter;
    private string? _colorFilter;

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<DeckFilterResult> OnFilterApplied { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private void OnQuickTab() => _tab = "quick";
    private void OnAdvancedTab() => _tab = "advanced";

    private async Task OnApply()
    {
        var result = new DeckFilterResult
        {
            Ownership = _ownershipFilter,
            MinCount = _minCount,
            MaxCount = _maxCount,
            MinPrice = _minPrice,
            MaxPrice = _maxPrice,
            HasFoil = _hasFoil,
            HasForTrade = _hasForTrade,
            HasComment = _hasComment,
            TextSearch = string.IsNullOrWhiteSpace(_textSearch) ? null : _textSearch!.Trim(),
            TypeFilter = string.IsNullOrWhiteSpace(_typeFilter) ? null : _typeFilter!.Trim(),
            SetFilter = string.IsNullOrWhiteSpace(_setFilter) ? null : _setFilter!.Trim(),
            ColorFilter = string.IsNullOrEmpty(_colorFilter) ? null : _colorFilter,
        };

        await OnFilterApplied.InvokeAsync(result);
    }

    private void OnClear()
    {
        _ownershipFilter = "all";
        _minCount = null;
        _maxCount = null;
        _minPrice = null;
        _maxPrice = null;
        _hasFoil = false;
        _hasForTrade = false;
        _hasComment = false;
        _textSearch = null;
        _typeFilter = null;
        _setFilter = null;
        _colorFilter = null;
        StateHasChanged();
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task OnOverlayClick()
    {
        await Close();
    }
}