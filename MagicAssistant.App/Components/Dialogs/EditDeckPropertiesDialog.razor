@*
    EditDeckPropertiesDialog — Deck properties editor
    Mirrors Java: ui.dialogs.EditDeckPropertiesDialog
    
    Features:
    - Rename node via IDeckManagementService.RenameAsync (no-op save when unchanged)
    - Validation: name required, max 100 characters
    - Enter to save, Escape to cancel
    - Load-once per DeckId: parent re-renders while open don't wipe in-progress edits
*@

@if (!IsOpen) { return; }

<div class="dialog-overlay" @onclick="Close">
    <div class="dialog-box" @onclick:stopPropagation="true">
        <div class="dialog-header">
            <span>Deck Properties</span>
            <button class="close-btn" @onclick="Close" title="Close">✕</button>
        </div>

        <div class="dialog-body">
            @if (_loading)
            {
                <div class="dialog-loading">Loading...</div>
            }
            else if (_deckNode == null)
            {
                <div class="dialog-error">Deck not found</div>
            }
            else
            {
                <div class="form-group">
                    <label for="deck-name-input">Name</label>
                    <input id="deck-name-input" @bind="_deckName" @onkeydown="OnKeyDown"
                           class="form-input" maxlength="100" />
                    @if (_nameError != null)
                    {
                        <span class="form-error">@_nameError</span>
                    }
                </div>

                <div class="form-info">
                    <span>ID: @_deckNode.Id</span>
                    <span>Cards: @_deckNode.CardCount</span>
                </div>
            }
        </div>

        <div class="dialog-footer">
            <button class="btn-primary" @onclick="OnSave" disabled="@(_saving || _nameError != null)">
                @(_saving ? "Saving..." : "Save")
            </button>
            <button class="btn-secondary" @onclick="Close">Cancel</button>
        </div>
    </div>
</div>

@code {
    private string _deckName = string.Empty;

    private MagicAssistant.Data.DbModel.Collection? _deckNode;
    private bool _loading;
    private bool _saving;
    private string? _nameError;

    /// <summary>DeckId the last load attempt targeted — guards against parent re-renders wiping in-progress edits.</summary>
    private int _loadedDeckId = -1;

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public int DeckId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    [Inject] private IDeckManagementService? DeckManagement { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen) return;

        // Load-once per DeckId: a parent re-render while the dialog is open (e.g. KB sync
        // completed → MainLayout StateHasChanged) must not reset _deckName mid-typing.
        if (_loadedDeckId == DeckId)
            return;

        _loading = true;
        _deckNode = null;
        _nameError = null;
        StateHasChanged();

        try
        {
            if (DeckManagement != null && DeckId > 0)
            {
                _deckNode = await DeckManagement.GetByIdAsync(DeckId);
                if (_deckNode != null)
                {
                    _deckName = _deckNode.Name;
                }
            }
        }
        catch
        {
            // Deck not found — dialog will show error state
        }

        _loading = false;
        _loadedDeckId = DeckId;
        StateHasChanged();
    }

    private async Task OnSave()
    {
        var newName = _deckName.Trim();
        if (string.IsNullOrEmpty(newName))
        {
            _nameError = "Deck name is required";
            StateHasChanged();
            return;
        }

        // Defensive: the input has maxlength=100, but a legacy node name could exceed it.
        if (newName.Length > 100)
        {
            _nameError = "Name must be 100 characters or less";
            StateHasChanged();
            return;
        }

        // Only save if name changed
        var nameChanged = _deckNode != null && !string.Equals(_deckNode.Name, newName, StringComparison.Ordinal);
        
        if (!nameChanged)
        {
            await Close();
            return;
        }

        _saving = true;
        StateHasChanged();

        try
        {
            if (DeckManagement != null)
            {
                await DeckManagement.RenameAsync(DeckId, newName);
                // Keep the cached node in sync in place — the dialog stays open after save
                // and a re-fetch here would flash "Loading..." on the parent's re-render.
                if (_deckNode != null)
                    _deckNode.Name = newName;
            }

            await OnSaved.InvokeAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_saving && _nameError == null)
            await OnSave();
        else if (e.Key == "Escape")
            await Close();
    }
}