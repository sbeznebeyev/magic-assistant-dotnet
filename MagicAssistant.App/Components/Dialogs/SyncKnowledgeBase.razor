@using System.Text.Json
@using MagicAssistant.App.Dtos
@using MagicAssistant.App.Services
@using MagicAssistant.Core.Commands
@using MagicAssistant.Core.Queries

@if (IsOpen)
{
    <div class="sync-dialog-overlay">
    <div class="sync-dialog" @onclick:stopPropagation="true">
        @* ── Header ── *@
        <div class="sync-header">
            <span class="sync-title">🔄 Update DB from Scryfall</span>
            <button class="close-btn" @onclick="Close">✕</button>
        </div>

        @if (_loadingSets)
        {
            <div class="sync-loading">Loading sets from database...</div>
        }
        else if (_error != null)
        {
            <div class="sync-error">
                <span>@_error</span>
                <button @onclick="RetryLoadSetsFromKB">Retry</button>
            </div>
        }
        else if (!_isSyncing)
        {
            @* ── Selection Form ── *@
            <div class="sync-form">
                @* Top row: Sync from Scryfall button + Full Update checkbox ── *@
                <div class="scryfall-row">
                    <button class="sync-scryfall-btn" @onclick="SyncSetsFromScryfall"
                            disabled="@_isSyncingSets">
                        @if (_isSyncingSets)
                        {
                            <span>Syncing...</span>
                        }
                        else
                        {
                            <span>Sync Sets from Scryfall</span>
                        }
                    </button>
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="_fullUpdateCardSets" />
                        <span>Rewrite all existed sets in DB</span>
                    </label>
                </div>

                <hr class="sync-divider" />

                @* Set Selector ── *@
                <div class="form-group">
                    <label>Sets (@_sets.Count)</label>
                    <div class="set-selector-wrap">
                        <SetSelectorDropdown
                            Value="@_selectedSetCode"
                            ValueChanged="v => _selectedSetCode = v"
                            Sets="@_sets"
                            Disabled="@(_sets!.Count == 0)"
                            OnDropdownToggle="OnDropdownToggle" />
                    </div>
                </div>

                @* Download Images ── *@
                <div class="form-group checkbox-group">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="_downloadImages" />
                        <span>Download card images</span>
                    </label>
                </div>

                @* Language Localization Toggles ── *@
                <div class="form-group language-group">
                    <label>Card languages</label>
                    <div class="language-toggles">
                        @foreach (var lang in _allLanguages)
                        {
                            <button type="button"
                                    class="lang-toggle @(IsLangSelected(lang) ? "active" : "")"
                                    @onclick="() => ToggleLanguage(lang)"
                                    title="@GetLangDisplayName(lang)">
                                @lang
                            </button>
                        }
                    </div>
                </div>

                @* Sync Button ── *@
                <button class="sync-btn" @onclick="StartSyncCards"
                        disabled="@(_syncDisabled)">
                    @GetSyncButtonLabel()
                </button>
            </div>

            @* ── Sets Sync Result ── *@
            @if (_setsSyncResult != null)
            {
                <div class="sync-result @(_setsSyncResult.Success ? "success" : "error")">
                    <div class="result-header">
                        @(_setsSyncResult.Success ? "✓ Sets Synced" : "✗ Sets Sync Failed")
                    </div>
                    <div class="result-details">
                        <span class="detail">Total from Scryfall: @_setsSyncResult.TotalScryfallSets</span>
                        <span class="detail">New added: @_setsSyncResult.NewSetsAdded</span>
                        @if (_fullUpdateCardSets)
                        {
                            <span class="detail">Updated: @_setsSyncResult.ExistingSetsUpdated</span>
                        }
                        else
                        {
                            <span class="detail">Skipped (existing): @_setsSyncResult.ExistingSetsSkipped</span>
                        }
                        @if (_setsSyncResult.IconsDownloaded > 0)
                        {
                            <span class="detail">Icons: @_setsSyncResult.IconsDownloaded</span>
                        }
                        @* Icons reach the UI only as .set-symbol classes in sets.css — the generator
                           appends the missing ones right after the icon cache is filled. *@
                        @if (_setsSyncResult.CssRulesAdded > 0)
                        {
                            <span class="detail">CSS rules: @_setsSyncResult.CssRulesAdded</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(_setsSyncResult.CssError))
                    {
                        <div class="result-errors">
                            <div>⚠ Icons cached, but sets.css was not updated: @_setsSyncResult.CssError</div>
                        </div>
                    }
                    @if (!_setsSyncResult.Success && !string.IsNullOrEmpty(_setsSyncResult.ErrorMessage))
                    {
                        <div class="result-errors">
                            <div>⚠ @_setsSyncResult.ErrorMessage</div>
                        </div>
                    }
                </div>
            }

            @* ── Last Result ── *@
            @if (_lastResult != null)
            {
                <div class="sync-result @( _lastResult.Success ? "success" : "error")">
                    <div class="result-header">
                        @( _lastResult.Success ? "✓ Sync Complete" : "✗ Sync Failed")
                    </div>
                    <div class="result-details">
                        @if (!string.IsNullOrEmpty(_lastResult.SetName))
                        {
                            <span class="detail">Set: @_lastResult.SetName</span>
                        }
                        <span class="detail">Cards: @_lastResult.CardsPersisted</span>
                        <span class="detail">Images: @_lastResult.ImagesDownloaded</span>
                        @if (_lastResult.Errors > 0)
                        {
                            <span class="detail error">Errors: @_lastResult.Errors</span>
                        }
                        <span class="detail">Duration: @_lastResult.Duration.ToString("mm\\:ss")</span>
                    </div>
                    @if (_lastResult.ErrorMessages.Any())
                    {
                        <div class="result-errors">
                            @foreach (var err in _lastResult.ErrorMessages)
                            {
                                <div>⚠ @err</div>
                            }
                        </div>
                    }
                </div>
            }
        }
        else
        {
            @* ── Sync In Progress ── *@
            <div class="sync-progress-section">
                <div class="progress-set-name">@(_currentSet?.Name ?? _selectedSetCode)</div>

                <div class="phase-indicator">
                    <span class="phase-label">@_currentState?.PhaseName</span>
                    <span class="phase-message">@_currentState?.Message</span>
                </div>

                <div class="progress-bar-wrap">
                    <div class="progress-bar" style="width: @(_currentState?.ProgressPercent ?? 0)%"></div>
                </div>

                <div class="progress-stats">
                    @if ((_currentState?.DownloadedPages ?? 0) > 0)
                    {
                        <span>Pages: @_currentState!.DownloadedPages</span>
                    }
                    <span>Cards: @_currentState?.ReadyCardsToSave / @_currentState?.TotalCards</span>
                    @if (_downloadImages)
                    {
                        <span>Images: @_currentState?.ImagesDownloaded</span>
                        @if ((_currentState?.ImagesFailed ?? 0) > 0)
                        {
                            <span class="fail">(@_currentState!.ImagesFailed failed)</span>
                        }
                    }
                </div>

                <button class="cancel-btn" @onclick="CancelSync">Cancel</button>
            </div>
        }
    </div>
    </div>
}

@code {
    // ── State ────────────────────────────────────────────
    private List<CardSetDto> _sets = new();
    private bool _loadingSets;
    private string? _error;

    // ── Selection ────────────────────────────────────────
    private string _selectedSetCode = "";
    private bool _downloadImages = true;
    private bool _fullUpdateCardSets;

    // ── Sets Sync ────────────────────────────────────────
    private bool _isSyncingSets;
    private SyncCardSetsResult? _setsSyncResult;

    // ── Sync ─────────────────────────────────────────────
    private bool _isSyncing;
    private SyncResult? _lastResult;
    private SyncSetState? _currentState;
    private CancellationTokenSource? _cts;
    private Timer? _pollTimer;
    private string[] _languages = [];
    private static readonly string[] _allLanguages = ["en", "ru", "es", "fr", "de", "it", "pt", "ja", "ko", "zhs", "zht"];
    private const string LanguagesSettingKey = "SyncKnowledgeBase.Languages";

    private static readonly Dictionary<string, string> _langDisplayNames = new()
    {
        { "en", "English" },
        { "ru", "Русский" },
        { "es", "Español" },
        { "fr", "Français" },
        { "de", "Deutsch" },
        { "it", "Italiano" },
        { "pt", "Português" },
        { "ja", "日本語" },
        { "ko", "한국어" },
        { "zhs", "简体中文" },
        { "zht", "繁體中文" }
    };

    private bool IsLangSelected(string lang) => _languages.Contains(lang);

    private string GetLangDisplayName(string lang)
    {
        return _langDisplayNames.TryGetValue(lang, out var name) ? name : lang;
    }

    private async Task ToggleLanguage(string lang)
    {
        if (_languages.Contains(lang))
        {
            _languages = _languages.Where(l => l != lang).ToArray();
        }
        else
        {
            _languages = _languages.Append(lang).ToArray();
        }
        await SaveLanguagesAsync();
    }

    private async Task LoadLanguagesAsync()
    {
        if (GetSettingQueryHandler is null) return;
        try
        {
            var json = await GetSettingQueryHandler.Handle(new GetUserSettingQuery(LanguagesSettingKey));
            if (!string.IsNullOrEmpty(json))
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                _languages = System.Text.Json.JsonSerializer.Deserialize<string[]>(json, options) ?? [];
            }
        }
        catch
        {
            // If loading fails, keep default (empty)
            _languages = [];
        }
    }

    private async Task SaveLanguagesAsync()
    {
        if (SaveSettingCommandHandler is null) return;
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(_languages);
            await SaveSettingCommandHandler.Handle(new SaveUserSettingCommand(LanguagesSettingKey, json));
        }
        catch
        {
            // Silently fail — settings are not critical for sync to work
        }
    }

    private bool _syncDisabled => string.IsNullOrEmpty(_selectedSetCode) || _languages.Length == 0;

    private string GetSyncButtonLabel()
    {
        if (string.IsNullOrEmpty(_selectedSetCode))
            return "No selected Set";
        if (_languages.Length == 0)
            return "Select at least one language";
        return $"Sync Cards of selected Set ({_languages.Length} lang)";
    }

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnCompleted { get; set; }

    [Inject] private GetKBAvailableSetsQueryHandler? KBSetsQueryHandler { get; set; }
    [Inject] private SyncKBCommandHandler? SyncCommandHandler { get; set; }
    [Inject] private SyncCardSetsCommandHandler? SyncCardSetsHandler { get; set; }
    [Inject] private SyncSetStateRegistry? StateRegistry { get; set; }
    [Inject] private SaveUserSettingCommandHandler? SaveSettingCommandHandler { get; set; }
    [Inject] private GetUserSettingQueryHandler? GetSettingQueryHandler { get; set; }
    /// <summary>Canonical Microsoft Learn pattern: scoped service for cross-thread UI notifications.</summary>
    [Inject] private KbRefreshService? KbRefresh { get; set; }

    // ── Lifecycle ────────────────────────────────────────
    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen)
        {
            if (_sets.Count == 0)
                await LoadSetsFromKB();
            await LoadLanguagesAsync();
        }
    }

    private async Task LoadSetsFromKB()
    {
        _loadingSets = true;
        _error = null;
        try
        {
            var sets = await KBSetsQueryHandler!.Handle(new GetKBAvailableSetsQuery());
            _sets = sets.Select(DtoHelper.ToCardSetDto).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loadingSets = false;
        }
    }

    private async Task RetryLoadSetsFromKB()
    {
        await LoadSetsFromKB();
        StateHasChanged();
    }

    // ── Sync Sets from Scryfall ──────────────────────────
    private async Task SyncSetsFromScryfall()
    {
        _isSyncingSets = true;
        _setsSyncResult = null;
        StateHasChanged();

        try
        {
            var result = await SyncCardSetsHandler!.Handle(new SyncCardSetsCommand(FullUpdate: _fullUpdateCardSets));
            _setsSyncResult = result;

            // Reload sets from KB after successful sync.
            // Keep dialog OPEN — user needs to pick a set and sync cards next.
            if (result.Success)
            {
                await LoadSetsFromKB();
                // OnCompleted notifies MainLayout → RefreshTrigger++ → CardsListControl reloads its sets list.
                // We do NOT close the dialog here — user stays to sync cards of selected set.
                await OnCompleted.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            _setsSyncResult = new SyncCardSetsResult
            {
                Success = false,
                ErrorMessage = ex.Message
            };
        }
        finally
        {
            _isSyncingSets = false;
        }
    }

    // ── Sync Control ─────────────────────────────────────
    private async Task StartSyncCards()
    {
        if (string.IsNullOrEmpty(_selectedSetCode)) return;

        _isSyncing = true;
        _lastResult = null;
        _cts = new CancellationTokenSource();
        StateHasChanged();

        Task syncTask = Task.Run(async () =>
        {
            try
            {
                var result = await SyncCommandHandler!.Handle(
                    new SyncKBCommand(_selectedSetCode, _languages, _downloadImages),
                    _cts.Token);

                _lastResult = result;
            }
            catch (OperationCanceledException)
            {
                _lastResult = new SyncResult
                {
                    Success = false,
                    SetCode = _selectedSetCode,
                    ErrorMessages = { "Sync cancelled" }
                };
            }
            catch (Exception ex)
            {
                _lastResult = new SyncResult
                {
                    Success = false,
                    SetCode = _selectedSetCode,
                    ErrorMessages = { ex.Message }
                };
            }
            finally
            {
                _isSyncing = false;
                _cts = null;
                _pollTimer?.Dispose();
                _pollTimer = null;
            }
        });

        // Start polling for progress (every 500ms)
        _pollTimer = new Timer(_ =>
        {
            InvokeAsync(() =>
            {
                if (StateRegistry != null)
                {
                    _currentState = StateRegistry.Get(_selectedSetCode);
                    if (_currentState != null && !string.IsNullOrEmpty(_currentState.SetName))
                    {
                        _currentSet = _sets.FirstOrDefault(s => s.Code == _selectedSetCode);
                    }
                    StateHasChanged();
                }
            });
        }, null, 0, 500);

        // Wait for sync to complete, then notify via OnCompleted.
        await syncTask;
        await OnCompleted.InvokeAsync();
    }

    private void CancelSync()
    {
        _cts?.Cancel();
    }

    // ── Dialog ───────────────────────────────────────────
    private async Task Close()
    {
        if (_isSyncing) return; // Don't close while syncing
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private CardSetDto? _currentSet;

    // ── Dropdown Toggle Handler ────────────────────────
    private Task OnDropdownToggle(bool isOpen)
    {
        // When dropdown opens, ensure dialog is not scrolling underneath.
        // No action needed — dropdown uses position: fixed.
        return Task.CompletedTask;
    }
}
