@using MagicAssistant.Data.Model
@using MagicAssistant.Data.Model.NavigatorNodes

<div class="tree-branch">
    @if (Node.NodeType == NodeType.Folder)
    {
        var folder = (NavigatorNodeFolder)Node;
        <div class="tree-node"
             style="--depth: @Depth;"
             @oncontextmenu:preventDefault="true">

                <span class="tree-toggle" @onclick:stopPropagation="true"
                      @onclick="OnToggleClick">
                    @(IsExpanded ? "▾" : "▸")
                </span>

                <span class="deck-nav-ico @(ShowMarker ? "node-dot " + NodeMarkerClass : "deck-nav-folder-ico")"></span>

                <span class="tree-label">@Node.Name</span>
                @if (Node.CardCount > 0)
                {
                    <span class="tree-count">@(Node.CardCount)</span>
                }

                <span class="tree-actions">
                    <button class="tree-more-btn" @onclick:stopPropagation="true"
                            @onclick="OnMoreClick" title="Options">⋯</button>
                </span>
        </div>

        @if (IsExpanded && folder.Children != null && folder.Children.Any())
        {
            @foreach (var child in folder.Children)
            {
                <DecksNavigatorTreeItem @key="child.Id + child.Name" Node="@child"
                          Depth="@(Depth + 1)"
                          SelectedId="@SelectedId"
                          PinnedId="@PinnedId"
                          ActiveAddMenuNodeId="@ActiveAddMenuNodeId"
                          ExpandedSet="@ExpandedSet"
                          OnToggleExpand="@OnToggleExpand"
                          OnSelectDeck="@OnSelectDeck"
                          OnContextMenuToggle="@OnContextMenuToggle"
                          OnAskCreateNode="@OnAskCreateNode"
                          OnAddMenuToggle="@OnAddMenuToggle" />
            }
        }

        @* ── Add Node Button (only for folders) ── *@
        <div class="add-menu-wrapper">
            <div class="tree-node tree-add-node" style="--depth: @Depth;" @onclick="OnAddClick">
                <span class="tree-spacer"></span>
                <button class="tree-add-btn" @onclick:stopPropagation="true" title="Add node">+</button>
                <span class="tree-label tree-add-label" style="margin-left: 6px;">add node</span>
            </div>
            @if (IsAddMenuOpen)
            {
                <div class="add-menu">
                    <button @onclick="() => AskCreateNode(NodeType.Collection)"><span class="deck-nav-ico deck-nav-col-ico"></span> Collection</button>
                    <button @onclick="() => AskCreateNode(NodeType.Deck)"><span class="deck-nav-ico deck-nav-deck-ico"></span> Deck</button>
                    <button @onclick="() => AskCreateNode(NodeType.Folder)"><span class="deck-nav-ico deck-nav-folder-ico"></span> Folder</button>
                </div>
            }
        </div>
    }
    else if (Node.NodeType == NodeType.Deck)
    {
        var deck = (NavigatorNodeDeck)Node;
        <div class="tree-node @(SelectedId == Node.Id ? "selected" : "")"
                 style="--depth: @Depth;"
                 @onclick="OnSelectClick"
                 @oncontextmenu:preventDefault="true">

                <span class="deck-nav-ico @(ShowMarker ? "node-dot " + NodeMarkerClass : "deck-nav-deck-ico")"></span>

                <span class="tree-label">@Node.Name</span>
                @if (Node.CardCount > 0)
                {
                    <span class="tree-count">@(Node.CardCount)</span>
                }

                <span class="tree-actions">
                    @if (deck.Sideboard != null)
                    {
                        var sideboard = deck.Sideboard;
                        <button class="tree-sb-btn @(SelectedId == sideboard.Id ? "selected" : "") @(SbShowMarker(sideboard) ? "has-marker" : "")" @onclick:stopPropagation="true"
                                @onclick="() => OnSideboardClick(sideboard)"
                                title="Sideboard @(sideboard.CardCount) cards">
                            @if (SbShowMarker(sideboard))
                            {
                                <span class="node-marker @SbMarkerClass(sideboard)"></span>
                            }
                            SB@(sideboard.CardCount > 0 ? " " + sideboard.CardCount : "")
                        </button>
                    }
                    <button class="tree-more-btn" @onclick:stopPropagation="true"
                            @onclick="OnMoreClick" title="Options">⋯</button>
                </span>
        </div>
    }
    else if (Node.NodeType == NodeType.Collection)
    {
        <div class="tree-node @(SelectedId == Node.Id ? "selected" : "")"
             style="--depth: @Depth;"
             @onclick="OnSelectClick"
             @oncontextmenu:preventDefault="true">

            <span class="deck-nav-ico @(ShowMarker ? "node-dot " + NodeMarkerClass : "deck-nav-col-ico")"></span>

            <span class="tree-label">@Node.Name</span>
            @if (Node.CardCount > 0)
            {
                <span class="tree-count">@(Node.CardCount)</span>
            }

            <span class="tree-actions">
                <button class="tree-more-btn" @onclick:stopPropagation="true"
                        @onclick="OnMoreClick" title="Options">⋯</button>
            </span>
        </div>
    }
</div>

@code {
    [Parameter] public required NavigatorNodeBase Node { get; set; }
    [Parameter] public int Depth { get; set; }
    [Parameter] public int? SelectedId { get; set; }
    /// <summary>ID of the currently pinned node (MainLayout._pinnedCollection.CollectionId) — drives the green marker dot.</summary>
    [Parameter] public int? PinnedId { get; set; }
    /// <summary>ID of the folder whose add-menu is currently open. Each instance computes its own visibility.</summary>
    [Parameter] public int? ActiveAddMenuNodeId { get; set; }

    private bool IsAddMenuOpen => ActiveAddMenuNodeId == Node.Id;

    /// <summary>Set of folder IDs that are currently visually expanded.</summary>
    [Parameter] public HashSet<int>? ExpandedSet { get; set; }

    [Parameter] public EventCallback<int> OnToggleExpand { get; set; } = default!;
    [Parameter] public required EventCallback<NavigatorNodeBase> OnSelectDeck { get; set; }
    [Parameter] public EventCallback<(int nodeId, double clientX, double clientY)> OnContextMenuToggle { get; set; } = default!;
    /// <summary>Requests parent to open the name-input dialog for creating a node.</summary>
    [Parameter] public EventCallback<(int? parentId, NodeType type)> OnAskCreateNode { get; set; } = default!;
    [Parameter] public EventCallback<int> OnAddMenuToggle { get; set; } = default!;

    private bool IsExpanded => ExpandedSet != null && ExpandedSet.Contains(Node.Id);

    // ── State marker: 8px gutter over the label — red dot = locked, green dot = pinned ──
    private bool ShowMarker => Node.Locked || PinnedId == Node.Id;
    private string NodeMarkerClass => Node.Locked ? "marker-locked" : "marker-pinned";

    // Same marker language on the deck row's SB button (sideboards have no row of their own)
    private bool SbShowMarker(NavigatorNodeBase sb) => sb.Locked || PinnedId == sb.Id;
    private string SbMarkerClass(NavigatorNodeBase sb) => sb.Locked ? "marker-locked" : "marker-pinned";

    private async Task OnSelectClick()
    {
        await OnSelectDeck.InvokeAsync(Node);
    }

    private async Task OnSideboardClick(NavigatorNodeBase sideboard)
    {
        await OnSelectDeck.InvokeAsync(sideboard);
    }

    private async Task OnToggleClick()
    {
        await OnToggleExpand.InvokeAsync(Node.Id);
    }

    private async Task OnMoreClick(MouseEventArgs e)
    {
        await OnContextMenuToggle.InvokeAsync((Node.Id, e.ClientX, e.ClientY));
    }

    /// <summary>Toggle add-menu open/closed — parent controls visibility via IsAddMenuOpen.</summary>
    private async Task OnAddClick()
    {
        await OnAddMenuToggle.InvokeAsync(Node.Id);
    }

    /// <summary>Close menu, then request parent to open name-input dialog for the given type.</summary>
    private async Task AskCreateNode(NodeType type)
    {
        await OnAddMenuToggle.InvokeAsync(Node.Id);
        await OnAskCreateNode.InvokeAsync((Node.Id, type));
    }
}
