@using Microsoft.Extensions.Logging
@implements IDisposable
@inject IDeckCardService DeckCardService
@inject ILogger<LastActions> Logger
@inject ICardImageLoader ImageLoader

<div class="last-actions-view">
    <div class="section-header">
        <span>Last actions</span>
    </div>

    @if (Queue.Items.Count == 0)
    {
        <div class="view-empty">No actions yet</div>
    }
    else
    {
        <div class="actions-list">
            @foreach (var item in Queue.Items)
            {
                var isAdd = item.Operation == LastActionOperationEnum.Add;
                <div class="action-row">

                    <div class="action-body">
                        @* Card image (lazy: renders once the file is on disk; missing → auto-download) *@
                        <div class="action-img">
                            @if (!string.IsNullOrEmpty(ImageHelper.GetImageUrl(item.Card, true)) && ImageLoader.FrontExists(item.Card))
                            {
                                <img src="@ImageHelper.GetImageUrl(item.Card, true)" alt="front" loading="lazy" />
                            }
                            else
                            {
                                <span class="action-img-placeholder">@(ImageLoader.Failed(item.Card) ? "?" : "⏳")</span>
                            }
                        </div>

                        @* Info *@
                        <div class="action-info">
                            <div class="action-name">@item.Card.Name</div>
                            <div class="action-meta">
                                @if (!string.IsNullOrEmpty(item.Card.SetCode))
                                {
                                    <span class="meta-set" title="Set">@item.Card.SetCode</span>
                                }
                                @if (!string.IsNullOrEmpty(item.Card.Rarity))
                                {
                                    <span class="meta-rarity @(GetRarityClass(item.Card.Rarity))">
                                        @item.Card.Rarity
                                    </span>
                                }
                                @if (item.Card.CmcNumber > 0)
                                {
                                    <span class="meta-cmc">@item.Card.CmcText</span>
                                }
                                @if (!string.IsNullOrEmpty(item.Card.Language))
                                {
                                    <span class="meta-lang" title="Language">@item.Card.Language.ToUpperInvariant()</span>
                                }
                            </div>
                        </div>

                    </div>

                    @* Right column: location label on top, formula directly below it (right-aligned).
                       The queue is never reset, so each entry carries its own collection. *@
                    <div class="action-side">
                        <div class="action-location" title="@item.Location">@item.Location</div>

                        @* Formula in the entry's own location: before + delta → total (e.g. 3+1 4).
                           Counts are clamped at 0; an unknown total renders as 0 — never a dash. *@
                        @{
                            var total = GetTotal(item) ?? 0;
                            var before = Math.Max(0, isAdd ? total - item.Count : total + item.Count);
                        }
                        <div class="action-count">
                            <span class="action-before">@before</span>
                            <span class="action-delta @(isAdd ? "add" : "sub")">@(isAdd ? $"+{item.Count}" : $"-{item.Count}")</span>
                            <span class="action-total">@total</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public required LastActionsQueue Queue { get; set; }

    /// <summary>Totals per (LocationId, CardId) for the queued entries.</summary>
    private Dictionary<(int CollectionId, Guid CardId), int> _counts = new();

    protected override void OnInitialized()
    {
        Queue.Changed += OnQueueChanged;
        _ = EnsureImagesAsync(); // items already in the queue at mount time
    }

    /// <summary>Central handler: reload totals + re-render when the queue changes.
    /// Called from LastActionsQueue.Changed (Action event). The delegate is synchronous, so the
    /// callback cannot be awaited — every exception is handled inside the callback (logged),
    /// so nothing is dropped on the renderer.</summary>
    private void OnQueueChanged()
    {
        InvokeAsync(async () =>
        {
            try
            {
                await ReloadCountsAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "LastActions refresh failed.");
            }
        });
        // New entries may have uncached images — the event can fire off the render context,
        // so the lazy-load batch runs inside InvokeAsync as well.
        InvokeAsync(() => _ = EnsureImagesAsync());
    }

    /// <summary>
    /// Lazy image loading for queue thumbnails: missing front images are downloaded in parallel
    /// (one per-card command each, deduplicated by the loader); the list re-renders as files land.
    /// </summary>
    private async Task EnsureImagesAsync()
    {
        var missing = Queue.Items
            .Where(i => i.Card is not null && !ImageLoader.FrontExists(i.Card))
            .ToList();

        if (missing.Count == 0) return;

        var tasks = missing.Select(i => ImageLoader.EnsureAsync(i.Card)).ToList(); // all start at once
        foreach (var t in tasks)
        {
            await t;
            StateHasChanged();
        }
    }

    /// <summary>Totals per (location, card) for the queued entries — one grouped query over the
    /// distinct locations and cards in the queue. Best-effort: on failure totals render as 0.</summary>
    private async Task ReloadCountsAsync()
    {
        if (Queue.Items.Count == 0)
        {
            _counts = new();
            return;
        }

        try
        {
            var collectionIds = Queue.Items.Select(i => i.LocationId).Distinct().ToList();
            var cardIds = Queue.Items.Select(i => i.Card.Id).Distinct().ToList();
            _counts = await DeckCardService!.GetDeckCardCountsAsync(collectionIds, cardIds);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load LastActions totals; showing —.");
            _counts = new();
        }
    }

    /// <summary>Total copies of the entry's card in its own location after the operation; null if unknown.
    /// Clamped at 0 — a negative total is never rendered.</summary>
    private int? GetTotal(LastActionItem item) =>
        _counts.TryGetValue((item.LocationId, item.Card.Id), out var count) ? Math.Max(0, count) : null;

    private static string GetRarityClass(string? rarity)
    {
        return rarity?.ToLowerInvariant() switch
        {
            "common" => "rarity-common",
            "uncommon" => "rarity-uncommon",
            "rare" => "rarity-rare",
            "mythic" => "rarity-mythic",
            _ => ""
        };
    }

    public void Dispose()
    {
        Queue.Changed -= OnQueueChanged;
    }
}
