@using MagicAssistant.App.Components.Shared
@using MagicAssistant.App.Dtos
@using MagicAssistant.App.Shared
@using MagicAssistant.Core.Commands
@using MagicAssistant.Core.Queries
@using MagicAssistant.Data.Model.NavigatorNodes
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject ICardSearchService CardSearch
@inject IDeckCardService DeckCardService
@inject IDbCardStore DbStore
@inject SaveUserSettingCommandHandler? SaveSettingCommandHandler
@inject GetUserSettingQueryHandler? GetSettingQueryHandler
@inject HasCardsQueryHandler? HasCardsHandler
@inject GetSideboardPresenceQueryHandler? SideboardPresenceHandler
@inject IJSRuntime JS

<div class="kb-browser">
    @* ── Two-panel layout: Sets sidebar + Splitter + Card grid ── *@
    <div class="kb-body">
        @* ── Left: Sets Sidebar ── *@
        <div class="sets-sidebar @(_setsCollapsed ? "collapsed" : "")" style="width: @(_setsCollapsed ? "28px" : _sidebarWidth + "px");">
            <div class="sets-header">
                <span class="sets-title">@(IsLocationMode
                    ? FilterViewModel.CurrentCollectionId.HasValue
                        ? $"sets: {GetDisplayedSetsCount()}, cards: {GetDisplayedCardsCount()}, total: {GetLocationTotalCount()}"
                        : $"sets: {GetDisplayedSetsCount()}, cards: {GetDisplayedCardsCount()}"
                    : $"KB (sets: {GetDisplayedSetsCount()}, cards: {GetDisplayedCardsCount()})")</span>
                @* Collapse-only button — hidden when collapsed; the badge is the sole way back *@
                @if (!_setsCollapsed)
                {
                    <button class="sets-toggle"
                            @onclick="ToggleSetsCollapsed"
                            title="Collapse sets">
                        <span class="sets-toggle-glyph">&lt;</span>
                    </button>
                }
            </div>
            @* Vertical badge label — visible only in the collapsed 28px strip; clicking it expands the sidebar *@
            <span class="sets-label" @onclick="ToggleSetsCollapsed" title="Expand sets">Sets</span>
            <div class="sets-search-bar">
                <input value="@GetSetsInputValue()"
                       @oninput="OnSetsFilterInput"
                       placeholder="Filter sets..."
                       class="sets-search-input" />
                @if (FilterViewModel.ActiveCardSets is not null || IsSetsSearchActive)
                {
                    <button class="sets-clear-btn" @onclick="ClearSetsFilter" title="Clear filter">✕</button>
                }
            </div>
            <div class="sets-list-wrapper">
                <div class="sets-list">
                    @if (_filteredSets.Count == 0)
                    {
                        <div class="set-item empty">No sets found</div>
                    }
                    else
                    {
                        @* "All Sets" option — in location mode the label names the displayed node type.
                           Hidden while the list is narrowed by search: clearing the filter (✕ / Clear All)
                           is the only way back to the full list. *@
                        @if (!IsSetsSearchActive)
                        {
                            <div class="set-item @(FilterViewModel.ActiveCardSets is null ? "selected" : "")"
                                 @onclick="@(() => SelectAllSets())">
                                <span class="set-code">ALL</span>
                                <span class="set-name">@GetAllSetsLabel()</span>
                            </div>
                        }
                        @foreach (var s in _filteredSets)
                        {
                            <div class="set-item @(FilterViewModel.ActiveCardSets?.Contains(s.SetCode) == true ? "selected" : "") @(s.ParentSetCode != null ? "subset" : "")"
                                 @onclick="@(() => SelectSetFilter(s.SetCode))">
                                <span class="set-icon set-symbol set-symbol-@s.SetCode"></span>
                                <span class="set-name" title="@s.Name">@s.Name</span>
                                <span class="set-count">@s.CardCount</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        @* ── Splitter (8px, draggable) ── *@
        <div class="sets-splitter" @ref="_splitterRef"
             @onmousedown="OnSplitterMouseDown"
             @onmousedown:preventDefault></div>

        @* ── Right: Card Grid Area ── *@
        <div class="kb-content">
            @* ── Toolbar Row: Name filter + Sort + Filters ── *@
            <div class="toolbar-row">
                <div class="name-filter-area">
                    <div class="name-filter-wrapper">
                        <input value="@_nameInputBuffer" @oninput="OnNameFilterInput" @onkeypress="OnNameFilterKey"
                               placeholder="Name... (3+)"
                               class="name-filter-input" />
                        @if (!string.IsNullOrEmpty(_nameInputBuffer))
                        {
                            <button class="name-filter-clear" @onclick="ClearNameFilter" title="Clear">✕</button>
                        }
                    </div>
                </div>

                @* ── View Mode: list / gallery toggle ── *@
                <div class="view-mode-area">
                    <button class="view-btn @(_viewMode == "list" ? "active" : "")"
                            @onclick="@(() => SetViewMode("list"))" title="List view">List</button>
                    <button class="view-btn @(_viewMode == "gallery" ? "active" : "")"
                            @onclick="@(() => SetViewMode("gallery"))" title="Gallery view">Gallery</button>
                    <button class="view-btn @(_viewMode == "tree" ? "active" : "")"
                            @onclick="@(() => SetViewMode("tree"))" title="Tree view">Tree</button>
                </div>
                <div class="filter-area">
                    <select value="@(GetTypeSelectValue())" @onchange="(e) => OnTypeChanged(e)" class="filter-select">
                        <option value="@_typeExpr" selected="@(FilterViewModel.TypeFilter.Count > 1)">@TypePlaceholderLabel</option>
                        @foreach (var t in _typeOptions)
                        {
                            <option value="@t.Key" selected="@(FilterViewModel.TypeFilter.Count == 1 && FilterViewModel.TypeFilter[0] == t.Key)">@t.DisplayName</option>
                        }
                    </select>
                    <select value="@(GetRaritySelectValue())" @onchange="(e) => OnRarityChanged(e)" class="filter-select">
                        <option value="@_rarityExpr" selected="@(FilterViewModel.Rarity.Count != 1)">@RarityPlaceholderLabel</option>
                        @foreach (var r in _rarities)
                        {
                            <option value="@r" selected="@(FilterViewModel.Rarity.Count == 1 && FilterViewModel.Rarity[0] == r)">@r</option>
                        }
                    </select>
                    <button class="filter-btn" @onclick="OnFilterClick" title="Advanced filter">Filters</button>
                    <button class="clear-filters-btn @(HasActiveFilters ? "active" : "")" disabled="@(!HasActiveFilters)" @onclick="OnClearFiltersClick" title="Clear all filters">✕</button>
                </div>
            </div>

            @* ── Loading ── *@
            @if (_loading)
            {
                <div class="kb-loading">Searching...</div>
            }

            @* ── Cards view: list / gallery (toggle in toolbar) ── *@
            @if (!_loading && _displayCards.Any())
            {
                @if (_viewMode == "gallery")
                {
                    <CardGalleryView Cards="_displayCards"
                                     CurrentPage="@_currentPage"
                                     TotalPages="@_totalPages"
                                     PageSize="@_pageSize"
                                     Counts="GetCountMap()"
                                     SelectedCardId="@_selectedCardId"
                                     OnCardClicked="SelectCard"
                                     OnCardSideChanged="OnCardSideChanged"
                                     OnPrevPage="PrevPage"
                                     OnNextPage="NextPage"
                                     OnPageSizeChanged="OnGalleryPageSizeChanged" />
                }
                else if (_viewMode == "tree")
                {
                    <CardTreeView Cards="_displayCards"
                                  CurrentPage="@_currentPage"
                                  TotalPages="@_totalPages"
                                  PageSize="@_pageSize"
                                  Counts="GetCountMap()"
                                  SelectedCardId="@_selectedCardId"
                                  OnCardClicked="SelectCard"
                                  OnPrevPage="PrevPage"
                                  OnNextPage="NextPage"
                                  OnPageSizeChanged="OnGalleryPageSizeChanged" />
                }
                else
                {
                    <CardListView Cards="_displayCards"
                                  CurrentPage="@_currentPage"
                                  TotalPages="@_totalPages"
                                  PageSize="@_pageSize"
                                  Physicals="_physicalByCardId"
                                  LocationNames="_locationNamesByCardId"
                                  Locked="@CurrentCollectionLocked"
                                  PinnedLocked="@PinnedCollectionLocked"
                                  OnCountChanged="ChangeCardCount"
                                  OnEditRequested="EditLocationCard"
                                  OnSplitRequested="SplitLocationCard"
                                  OnMoveToPinnedRequested="MoveLocationCardToPinned"
                                  PinnedCounts="_pinnedCountByCardId"
                                  SbPresence="_sbPresenceByCardId"
                                  ViewNodeKind="@FilterViewModel.CurrentCollectionNodeType"
                                  SelectedIsPinned="@(PinnedCollectionId.HasValue && PinnedCollectionId == FilterViewModel.CurrentCollectionId)"
                                  PinnedMoveLabel="@PinnedMoveLabel"
                                  OnKbAddRequested="AddCardToPinned"
                                  OnKbRemoveRequested="RemoveCardFromPinned"
                                  SelectedCardId="@_selectedCardId"
                                  OnCardClicked="SelectCard"
                                  OnPrevPage="PrevPage"
                                  OnNextPage="NextPage"
                                  SortField="@FilterViewModel.SortField"
                                  SortAsc="@FilterViewModel.SortAsc"
                                  OnSortColumnClicked="ToggleSort" />
                }
            }

            @* ── Empty State ── *@
            @if (!_loading && !_displayCards.Any())
            {
                <div class="kb-empty">
                    @if (!IsLocationMode)
                    {
                        @if (FilterViewModel.ActiveCardSets is { Count: > 0 } && !_selectedSetHasCards)
                        {
                            @* Direct DB check (HasCardsQuery) — no filter inference: the selected set
                               has no cards in the KB, so offer to sync it. Sync is a KB-only operation —
                               collection/deck/sideboard display never offers it. *@
                            <span>No cards from the selected set in knowledge base yet.</span>
                            <button class="sync-btn-inline" @onclick="OnSyncClick">
                                Sync from Scryfall
                            </button>
                        }
                        else if (HasActiveFilters)
                        {
                            <span class="empty-filters-msg">No cards match the selected filters</span>
                        }
                        else
                        {
                            <span>No cards in knowledge base yet.</span>
                        }
                    }
                    else if (GetLocationTotalCount() == 0)
                    {
                        @* The location itself is empty — the count check precedes any filter inference:
                           an empty node reports as empty even when filters happen to be active. *@
                        <span>No cards in the @GetLocationTypeLabel() yet.</span>
                    }
                    else
                    {
                        @* The location has cards but none displayed — filters are hiding them. *@
                        <span class="empty-filters-msg">No cards match the selected filters</span>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private int _pageSize = 50; // cards per page (adjustable from the gallery view)

    // Data
    private List<Card> _displayCards = new();

    /// <summary>Direct DB check (HasCardsQuery): does the selected set have cards in the KB?
    /// Only meaningful when the displayed list is empty and exactly a set scope is active.</summary>
    private bool _selectedSetHasCards;

    /// <summary>Physical instances of cards in the current location (deck mode). Null = KB mode.</summary>
    private Dictionary<Guid, MyCard>? _physicalByCardId;

    /// <summary>Locations multi-chip mode: the selected nodes each displayed card lives in,
    /// comma-joined — the leftmost column answers "where is this card from". Null outside that mode.</summary>
    private IReadOnlyDictionary<Guid, string>? _locationNamesByCardId;

    /// <summary>Total copies of each displayed card in the pinned collection (KB mode with a pinned target only —
    /// deck mode shows the current deck's count in the Total column instead). Null otherwise.</summary>
    private Dictionary<Guid, int>? _pinnedCountByCardId;

    /// <summary>Deck view only: CardId → the deck's sideboard holds ≥1 copy. Null = SB badges hidden.</summary>
    private Dictionary<Guid, bool>? _sbPresenceByCardId;
    private int? _previousPinnedCollectionId;
    private int _totalCount;
    private int _currentPage = 1;
    private int _totalPages = 0;
    private bool _loading;

    // Name filter input buffer (debounced — actual filter lives in FilterViewModel)
    private string _nameInputBuffer = "";
    private System.Threading.Timer? _nameDebounceTimer;
    private int _debounceSequence;

    /// <summary>Last seen FilterViewModel.ClearGeneration — detects external resets (Clear All).</summary>
    private int _lastClearGeneration;

    // Static options
    private static readonly string[] _rarities = { "common", "uncommon", "rare", "mythic" };
    private static readonly (string Key, string DisplayName)[] _typeOptions =
    {
        ("artifact", "Artifact"),
        ("creature", "Creature"),
        ("enchantment", "Enchantment"),
        ("instant", "Instant"),
        ("land", "Land"),
        ("planeswalker", "Planeswalker"),
        ("sorcery", "Sorcery"),
    };

    // Sets: lazy DB-backed view scoped by FilterViewModel.FilteredSetCodes (created per mount —
    // the component remounts on every navigation @key, so a fresh collection costs at most one small query).
    private FilteredCardSetsCollection? _setCollection;

    /// <summary>Last loaded scope list from the collection — the base for the in-memory search narrowing.</summary>
    private List<CardSet> _scopeSets = new();

    /// <summary>Search text narrowing the displayed set list (in memory only — never touches FilteredSetCodes).</summary>
    private List<CardSet> _filteredSets = new();
    private string _setsSearchQuery = "";

    // Splitter / Resizable sidebar
    private ElementReference _splitterRef;
    private int _sidebarWidth = 220;
    private const int MinSidebarWidth = 160;
    private const int MaxSidebarWidth = 500;
    private bool _isDragging;

    /// <summary>Collapse state of the sets sidebar (toggle button in the sets-header, mirrors MainLayout panel toggles).
    /// Persisted like the splitter position — the component remounts on every navigation (@key),
    /// so a plain bool would reset on each deck click.</summary>
    private bool _setsCollapsed;
    private const string SetsCollapsedKey = "KBCardsListControl.SetsCollapsed";

    // View mode (list / gallery) — persisted like other UI settings
    private string _viewMode = "list";
    private const string ViewModeSettingKey = "KBCardsListControl.ViewMode";

    // Settings persistence
    private const string SplitterPositionKey = "KBCardsListControl.SplitterPosition";
    private const string PageSizeSettingKey = "CardsListControl.PageSize";

    // Refresh trigger tracking
    private int _previousRefreshTrigger;
    // ── Parameters ──────────────────────────────────────
    /// <summary>Central filter/sort state shared with CardFilterDialog.</summary>
    [Parameter] public required FilterViewModel FilterViewModel { get; set; } = new();

    [Parameter] public EventCallback<Guid?> OnCardSelected { get; set; }
    [Parameter] public EventCallback OnOpenFilter { get; set; }
    [Parameter] public EventCallback<string> OnOpenSync { get; set; }
    /// <summary>Gallery view: card selected with the currently shown side (front/back).</summary>
    [Parameter] public EventCallback<(Guid cardId, bool showBack)> OnCardSideChanged { get; set; }
    [Parameter] public int RefreshTrigger { get; set; }

    /// <summary>Shared in-memory queue of the last card actions — count changes are recorded here for LastActions.</summary>
    /// <summary>Records an Add/Sub card operation in the rolling LastActions history.
    /// Target = the collection the card was added to / removed from (current in deck mode, fixed in KB mode).</summary>
    [Parameter] public EventCallback<CardOperationRecord> OnCardOperation { get; set; }

    /// <summary>Edit requested for a location card (deck mode only).</summary>
    [Parameter] public EventCallback<MyCard> OnEditCard { get; set; }

    /// <summary>Split requested for a location card (deck/sideboard views — any count, the whole row can move).</summary>
    [Parameter] public EventCallback<MyCard> OnSplitCard { get; set; }

    /// <summary>Move-to-pinned requested from a row (collection view — MainLayout opens MoveDialog).</summary>
    [Parameter] public EventCallback<MyCard> OnMoveCardToPinned { get; set; }

    /// <summary>Display label of the pinned move target (MainLayout.PinnedMoveLabel);
    /// null = no valid target — the row's ⇄ stays hidden in collection view.</summary>
    [Parameter] public string? PinnedMoveLabel { get; set; }

    /// <summary>Pinned operation target (MainLayout._pinnedCollection.CollectionId).
    /// KB-mode (+) and quick Move work against it.</summary>
    [Parameter] public int? PinnedCollectionId { get; set; }

    /// <summary>The displayed collection is locked — its card-mutation controls (−/+, ✎, ✂) are hidden.</summary>
    [Parameter] public bool CurrentCollectionLocked { get; set; }

    /// <summary>The pinned collection is locked — KB (+) is hidden and the row ⇄ Move button
    /// disappears everywhere (strict reading: a locked pin is no destination).</summary>
    [Parameter] public bool PinnedCollectionLocked { get; set; }

    protected override async Task OnInitializedAsync()
    {
        FilterViewModel.Changed += OnFilterChanged;
        _lastClearGeneration = FilterViewModel.ClearGeneration;
        _previousPinnedCollectionId = PinnedCollectionId;
        // Restore set search text across component remounts (@key change on navigation)
        _setsSearchQuery = FilterViewModel.SetSearchText;
        _setCollection = new FilteredCardSetsCollection(FilterViewModel, DbStore);
        await LoadSplitterSettingsAsync();
        await LoadViewModeAsync();
        await LoadPageSizeAsync();
        await LoadSetsCollapsedAsync();
        await LoadCounts();
        await ApplyFiltersAndPagination();
    }

    /// <summary>Central handler: reset page + re-query when any filter/sort changes.
    /// Called from FilterViewModel.Changed (Action event) — wraps async work in InvokeAsync.</summary>
    private void OnFilterChanged()
    {
        _currentPage = 1;
        InvokeAsync(async () =>
        {
            // Sync local set-search state when the filter was cleared through the channel
            // (toolbar ✕ / CardFilterDialog Clear All) — the input must not keep stale text.
            if (string.IsNullOrEmpty(FilterViewModel.SetSearchText) && !string.IsNullOrEmpty(_setsSearchQuery))
            {
                _setsSearchQuery = string.Empty;
                ApplySetsFilter();  // re-narrow the last loaded scope list
            }

            // Detect an external reset via ClearGeneration: after Clear All the debounced name buffer
            // must not keep stale text — and a pending debounce timer must not resurrect the filter.
            if (FilterViewModel.ClearGeneration != _lastClearGeneration)
            {
                _lastClearGeneration = FilterViewModel.ClearGeneration;
                if (string.IsNullOrEmpty(FilterViewModel.NameFilter))
                {
                    _nameInputBuffer = string.Empty;
                    _nameDebounceTimer?.Dispose();
                    _nameDebounceTimer = null;
                    _debounceSequence++;
                }
            }

            await ApplyFiltersAndPagination();
            StateHasChanged();
        });
    }

    private IJSObjectReference? _jsModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _jsModule == null)
        {
            // ES Module — Microsoft Learn pattern: путь относительно wwwroot
            _jsModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "/js/splitter.js");

            // Register C# callback — модуль вызовет OnSidebarResize из C#
            await _jsModule.InvokeVoidAsync(
                "init",
                DotNetObjectReference.Create(this));
        }
    }

    // ── Sets: lazy DB collection + in-memory search narrowing ────────────

    private void OnSetsFilterInput(ChangeEventArgs e)
    {
        var text = e.Value?.ToString() ?? string.Empty;
        _setsSearchQuery = text;
        FilterViewModel.SetSearchText = text;  // canonical state — survives component remounts
        ApplySetsFilter();                      // instant sidebar narrowing only — the card grid
                                                // follows the explicit single selection, not the search text
        StateHasChanged();
    }

    private async Task ClearSetsFilter()
    {
        FilterViewModel.SetActiveCardSets(null);
        FilterViewModel.SetSearchText = string.Empty;
        _setsSearchQuery = "";
        ApplySetsFilter();
        await OnCardSelected.InvokeAsync((Guid?)null);
        FilterViewModel.Apply();  // single channel: Changed → OnFilterChanged
    }

    private string GetSetsInputValue()
    {
        // The input is exclusively for set-list search. The selected set code is deliberately NOT shown here:
        // a stale code rendered into the field would be appended to on the next keystroke and leak into
        // the search filter. Selection state lives in the list highlight (and the ✕ button), not in this text.
        return _setsSearchQuery;
    }

    // ── Header stats (dynamic based on filter context) ─────────────────────
    private int GetDisplayedSetsCount() => _filteredSets.Count;

    private int GetDisplayedCardsCount()
    {
        if (FilterViewModel.CurrentCollectionId.HasValue)
            // Unique cards in the current node, narrowed by the active set when one is clicked.
            return _physicalByCardId?.Values
                .Count(p => FilterViewModel.ActiveCardSets is null || p.Card.SetCode == FilterViewModel.ActiveCardSets[0]) ?? 0;
        if (FilterViewModel.InLocationsMode)
            // Locations multi-chip / all-locations: unique cards from the server EXISTS query.
            return _totalCount;
        if (FilterViewModel.ActiveCardSets is { Count: 1 })
            return _filteredSets.FirstOrDefault(s => s.SetCode == FilterViewModel.ActiveCardSets![0])?.CardCount ?? 0;
        // KB, no set selected: total cards from DB
        return _totalCount;
    }

    /// <summary>Location mode only: all card copies in the current node (SUM of physical counts —
    /// same semantics as the tree's CardCount). 0 outside location mode or before the first load.</summary>
    private int GetLocationTotalCount() =>
        _physicalByCardId?.Values.Sum(p => p.Count) ?? 0;

    /// <summary>True while the sidebar list is actually narrowed by the search input (2+ chars).
    /// ALL is hidden in this state; clearing the filter (✕ / Clear All) is the only way back.</summary>
    private bool IsSetsSearchActive => !string.IsNullOrWhiteSpace(_setsSearchQuery) && _setsSearchQuery.Length >= 2;

    private void ApplySetsFilter()
    {
        // Base list = the lazy DB collection scoped by FilteredSetCodes (all sets in KB, node's sets in location mode).
        if (!IsSetsSearchActive)
        {
            _filteredSets = _scopeSets;
        }
        else
        {
            var q = _setsSearchQuery.ToLowerInvariant();
            _filteredSets = _scopeSets
                .Where(s => s.Name.ToLowerInvariant().Contains(q) ||
                            s.SetCode.ToLowerInvariant().Contains(q))
                .ToList();
        }
    }

    /// <summary>Location mode: scopes the set list to this node's sets. While the scope is in auto mode it is
    /// filled with the node's codes; an explicit user selection (Sets filter in Card Filter) survives and is
    /// trimmed to the node's codes — if nothing survives, the scope falls back to the full node scope.</summary>
    private void ApplyLocationScope(IEnumerable<string> setCodes)
    {
        var codes = setCodes.Distinct().ToList();
        if (FilterViewModel.SetScopeAuto)
        {
            FilterViewModel.SetNodeScope(codes);
        }
        else
        {
            var kept = FilterViewModel.FilteredSetCodes
                .Where(c => codes.Contains(c, StringComparer.OrdinalIgnoreCase))
                .ToList();
            if (kept.Count == 0)
            {
                FilterViewModel.ResetSetScope();
                FilterViewModel.SetNodeScope(codes);   // back to the full node scope
            }
            else if (kept.Count < FilterViewModel.FilteredSetCodes.Count)
            {
                FilterViewModel.SetFilteredSetCodes(kept);  // drop codes absent in this node
            }
        }
        if (FilterViewModel.ActiveCardSets is not null
            && !codes.Contains(FilterViewModel.ActiveCardSets[0], StringComparer.OrdinalIgnoreCase))
            FilterViewModel.SetActiveCardSets(null);
    }

    private async Task SelectSetFilter(string setCode)
    {
        // Click = activate exactly this set for the card grid (ActiveCardSets). The set-list scope
        // (FilteredSetCodes) is untouched — the sidebar keeps showing the full scoped list.
        // Clicking the already-active set is a no-op; ALL / ✕ clear the selection.
        if (FilterViewModel.ActiveCardSets is { Count: 1 } && FilterViewModel.ActiveCardSets[0] == setCode) return;

        FilterViewModel.SetActiveCardSets(setCode);
        await OnCardSelected.InvokeAsync((Guid?)null);
        FilterViewModel.Apply();  // single channel: Changed → OnFilterChanged
    }

    private async Task SelectAllSets()
    {
        // ALL resets the selection only — the scoped list stays as is.
        FilterViewModel.SetActiveCardSets(null);
        await OnCardSelected.InvokeAsync((Guid?)null);
        FilterViewModel.Apply();  // single channel: Changed → OnFilterChanged
    }

    // ── Splitter / Resize ──────────────────────────────────────
    /// <summary>Toggle the sets sidebar between full and collapsed (28px strip with the toggle only).
    /// Render is automatic after the handler — no StateHasChanged.</summary>
    private async Task ToggleSetsCollapsed()
    {
        _setsCollapsed = !_setsCollapsed;

        if (SaveSettingCommandHandler is null) return;
        try
        {
            await SaveSettingCommandHandler.Handle(new SaveUserSettingCommand(SetsCollapsedKey, _setsCollapsed ? "1" : "0"));
        }
        catch
        {
            // silently fail — settings are not critical
        }
    }

    private async Task LoadSetsCollapsedAsync()
    {
        if (GetSettingQueryHandler is null) return;

        try
        {
            var json = await GetSettingQueryHandler.Handle(new GetUserSettingQuery(SetsCollapsedKey));
            _setsCollapsed = json == "1";
        }
        catch
        {
            // default: expanded
        }
    }

    private async Task OnSplitterMouseDown(MouseEventArgs e)
    {
        if (_jsModule is null) return;

        // Dragging the splitter while collapsed expands the sidebar first — the drag then resizes it.
        if (_setsCollapsed)
            _setsCollapsed = false;

        _isDragging = true;
        StateHasChanged();
        await _jsModule.InvokeVoidAsync("startDrag", (int)e.ClientX, _sidebarWidth);
    }

    // ── Settings Persistence ───────────────────────────────
    private async Task LoadSplitterSettingsAsync()
    {
        if (GetSettingQueryHandler is null) return;

        try
        {
            var json = await GetSettingQueryHandler.Handle(new GetUserSettingQuery(SplitterPositionKey));
            if (!string.IsNullOrEmpty(json) && int.TryParse(json, out var width))
            {
                _sidebarWidth = Math.Clamp(width, MinSidebarWidth, MaxSidebarWidth);
            }
        }
        catch
        {
            // default _sidebarWidth = 220
        }
    }

    private async Task SaveSplitterPositionAsync()
    {
        if (SaveSettingCommandHandler is null) return;

        try
        {
            await SaveSettingCommandHandler.Handle(new SaveUserSettingCommand(SplitterPositionKey, _sidebarWidth.ToString()));
        }
        catch
        {
            // silently fail — settings are not critical
        }
    }

    [JSInvokable]
    public void OnSidebarResize(int newWidth)
    {
        _sidebarWidth = Math.Clamp(newWidth, MinSidebarWidth, MaxSidebarWidth);
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnDragEnd()
    {
        await SaveSplitterPositionAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Auto-reload when RefreshTrigger changes (sync completed)
        if (RefreshTrigger != _previousRefreshTrigger)
        {
            _previousRefreshTrigger = RefreshTrigger;
            _currentPage = 1;
            _setCollection?.Invalidate();  // sync may have added new sets — force a DB reload
            await LoadCounts();            // refresh total card count
            await ApplyFiltersAndPagination();
        }

        // Pinned target changed while KB is displayed — refresh pinned totals without re-querying cards
        if (PinnedCollectionId != _previousPinnedCollectionId)
        {
            _previousPinnedCollectionId = PinnedCollectionId;
            if (FilterViewModel.CurrentCollectionId is null)
            {
                _pinnedCountByCardId = PinnedCollectionId.HasValue ? await LoadPinnedCountsAsync(_displayCards) : null;
                StateHasChanged();
            }
        }
    }

