    private void OnNameFilterInput(ChangeEventArgs e)
    {
        _nameInputBuffer = e.Value?.ToString() ?? "";

        // Cancel previous timer
        _nameDebounceTimer?.Dispose();
        _nameDebounceTimer = null;

        if (_nameInputBuffer.Length >= 3)
        {
            // Debounce: wait 300ms, then commit to ViewModel + fire Changed
            int sequence = ++_debounceSequence;
            string filterValue = _nameInputBuffer;

            _nameDebounceTimer = new System.Threading.Timer(_ =>
            {
                InvokeAsync(() => ApplyNameFilterWithGuard(sequence, filterValue));
            }, null, 300, Timeout.Infinite);
        }
        else
        {
            // Below 3 chars — clear filter immediately through single channel
            _debounceSequence++;
            FilterViewModel.NameFilter = string.Empty;
            FilterViewModel.Apply();
        }
    }

    private void ApplyNameFilterWithGuard(int sequence, string filterValue)
    {
        if (sequence != _debounceSequence)
            return;
        FilterViewModel.NameFilter = filterValue;
        FilterViewModel.Apply();  // Changed → OnFilterChanged
    }

    private void OnNameFilterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _nameDebounceTimer?.Dispose();
            _nameDebounceTimer = null;
            _debounceSequence++;
            FilterViewModel.NameFilter = _nameInputBuffer.Length >= 3 ? _nameInputBuffer : string.Empty;
            FilterViewModel.Apply();
        }
    }

    private void ClearNameFilter()
    {
        _nameDebounceTimer?.Dispose();
        _nameDebounceTimer = null;
        _debounceSequence++;
        _nameInputBuffer = "";
        FilterViewModel.NameFilter = string.Empty;
        FilterViewModel.Apply();
    }

    // Server-side: filters + sort + pagination in one SQL query via GetPagedAsync
    private async Task ApplyFiltersAndPagination()
    {
        _loading = true;
        // Forced paint before the heavy phase: Microsoft.Data.Sqlite's "async" completes on the
        // dispatcher, so without a real suspension the loading state would never reach the
        // browser (same trap as the import wizard). Task.Run below keeps the dispatcher free
        // while the 10k-card physical load runs on a pool thread — the store opens its own
        // connection per call, so leaving the render thread is safe.
        StateHasChanged();
        await Task.Yield();
        try
        {
            // Location mode: load physical instances first — needed both for per-card counts/actions
            // and to scope the sidebar set list to this node's distinct sets.
            if (FilterViewModel.CurrentCollectionId.HasValue)
            {
                var physical = await Task.Run(() => DeckCardService.GetDeckCardsForListAsync(FilterViewModel.CurrentCollectionId.Value));
                _physicalByCardId = physical.ToDictionary(p => p.Card.Id, p => p);
                ApplyLocationScope(physical.Select(p => p.Card.SetCode).OfType<string>());
            }
            else if (FilterViewModel.InLocationsMode)
            {
                // Locations multi-chip / all-locations: no physical load — the server EXISTS path
                // decides membership; the sidebar scope is the union of the selected nodes' sets,
                // one DISTINCT query (never a loop over nodes).
                _physicalByCardId = null;
                var chips = FilterViewModel.LocationNodeIds;
                var codes = await Task.Run(() => DeckCardService.GetNodesSetCodesAsync(chips.Count > 0 ? chips : null));
                ApplyLocationScope(codes);
            }
            else
            {
                _physicalByCardId = null;
                // KB mode: drop only the stale location-mode auto-fill (node codes from a previous visit);
                // an explicit user selection (Sets filter in Card Filter) carries over to the KB list.
                if (FilterViewModel.SetScopeAuto && FilterViewModel.FilteredSetCodes.Count > 0)
                    FilterViewModel.ResetSetScope();
            }

            // Load the scoped set list for the sidebar (lazy DB view of FilteredSetCodes),
            // then narrow it by the search text in memory. An empty node has no sets at all —
            // loading with an empty scope would fall back to the full KB, so short-circuit it.
            // Display order is applied here as a guard: newest release first, then by parent set code.
            _scopeSets = _physicalByCardId is { Count: 0 }
                ? new List<CardSet>()
                : (await _setCollection!.EnsureLoadedAsync())
                    .OrderByDescending(s => s.ReleaseDate ?? DateTime.MinValue)
                    .ThenBy(s => s.ParentSetCode)
                    .ToList();
            ApplySetsFilter();

            // FilterViewModel.SortField already matches CardListFilter.SortFields values
            var sortField = FilterViewModel.SortField;

            string? effectiveNameFilter = FilterViewModel.NameFilter.Length >= 3
                ? FilterViewModel.NameFilter
                : null;

            var filter = new CardListFilter
            {
                SetCodes = FilterViewModel.GetEffectiveSetCodes(),
                Rarity = FilterViewModel.Rarity.Count > 0 ? FilterViewModel.Rarity : null,
                SortField = sortField,
                SortAsc = FilterViewModel.SortAsc,
                Page = _currentPage,
                PageSize = _pageSize,
                NameFilter = effectiveNameFilter,
                Query = string.IsNullOrWhiteSpace(FilterViewModel.SearchQuery) ? null : FilterViewModel.SearchQuery.Trim(),
                LocationFilter = FilterViewModel.CurrentCollectionId,
                LocationNodeIds = FilterViewModel.IsLocationsBrowse ? FilterViewModel.LocationNodeIds : null,
                TypeFilters = FilterViewModel.TypeFilter.Count > 0 ? FilterViewModel.TypeFilter : null,
                Artist = string.IsNullOrEmpty(FilterViewModel.Artist) ? null : FilterViewModel.Artist,
                ColorType = string.IsNullOrEmpty(FilterViewModel.ColorType) ? null : FilterViewModel.ColorType,
                ColorFilter = ColorFilterHelper.GetFilter(
                    FilterViewModel.ColorFilters,
                    andMode: FilterViewModel.ColorAndMode,
                    onlyMode: FilterViewModel.ColorOnlyMode,
                    identityMode: FilterViewModel.ColorIdentityMode),
                // Properties filters (Power / Toughness / CMC)
                PowerFilter = ParseNumericPropertyFilter(FilterViewModel.PowerOp, FilterViewModel.PowerValue),
                ToughnessFilter = ParseNumericPropertyFilter(FilterViewModel.ToughnessOp, FilterViewModel.ToughnessValue),
                CmcFilter = ParseNumericPropertyFilter(FilterViewModel.CmcOp, FilterViewModel.CmcValue),
                // Layout / Legality / GameChanger filters
                LayoutFilter = string.IsNullOrEmpty(FilterViewModel.LayoutFilter) ? null : FilterViewModel.LayoutFilter,
                LegalityFilter = string.IsNullOrEmpty(FilterViewModel.LegalityFilter) ? null : FilterViewModel.LegalityFilter,
                GameChangerFilter = FilterViewModel.GameChangerFilter,
                // Collection filters (location mode)
                Ownership = FilterViewModel.Ownership,
                MinCount = ParseCountFilter(FilterViewModel.MinCount),
                MaxCount = ParseCountFilter(FilterViewModel.MaxCount),
                MinPrice = ParsePriceFilter(FilterViewModel.MinPrice),
                MaxPrice = ParsePriceFilter(FilterViewModel.MaxPrice),
                IsFoil = FilterViewModel.IsFoil,
                HasForTrade = FilterViewModel.HasForTrade,
                HasComment = FilterViewModel.HasComment,
            };

            var result = await CardSearch!.GetPagedAsync(filter);
            _displayCards = result.Cards.Cast<Card>().ToList();
            _totalCount = result.TotalCount;
            _locationNamesByCardId = result.LocationNames;   // non-null only in locations multi-chip mode
            _totalPages = (int)Math.Ceiling((double)_totalCount / _pageSize);
            if (_currentPage > _totalPages && _totalPages > 0) _currentPage = _totalPages;

            // KB mode with a pinned target: totals of the displayed cards in the pinned collection
            // (deck mode shows the current deck's count in the Total column — no pinned query needed;
            // locations multi-chip shows its own read-only CopyTotals — pinned +/− has no address here)
            _pinnedCountByCardId = FilterViewModel.CurrentCollectionId is null && !FilterViewModel.InLocationsMode && PinnedCollectionId.HasValue
                ? await LoadPinnedCountsAsync(_displayCards)
                : null;

            // Deck view: read-only SB badges — one bulk query for the whole page answers which
            // displayed cards also sit in the sideboard. Sideboard/collection/KB views: no badges.
            _sbPresenceByCardId = FilterViewModel.CurrentCollectionId is { } deckId
                                  && FilterViewModel.CurrentCollectionNodeType == NodeType.Deck
                ? await LoadSideboardPresenceAsync(deckId)
                : null;
        }
        catch
        {
            _displayCards = new List<Card>();
            _totalCount = 0;
            _totalPages = 0;
            _sbPresenceByCardId = null;
            _locationNamesByCardId = null;
        }
        finally
        {
            _loading = false;
            await RefreshSelectedSetHasCardsAsync();
        }
    }

    /// <summary>
    /// Direct DB check for the sync button: when the displayed list is empty and a set scope is
    /// active, asks HasCardsQuery whether that set actually has cards in the knowledge base.
    /// No filter inference — the answer comes from the database itself.
    /// </summary>
    private async Task RefreshSelectedSetHasCardsAsync()
    {
        if (_displayCards.Count > 0
            || FilterViewModel.InLocationsMode
            || FilterViewModel.ActiveCardSets is not { Count: > 0 })
        {
            _selectedSetHasCards = false;
            return;
        }

        _selectedSetHasCards = await HasCardsHandler!.Handle(new HasCardsQuery(FilterViewModel.ActiveCardSets[0]));
    }

    /// <summary>Parse a numeric property filter from operator string + value string.
    /// Returns null if the value is empty/non-numeric (filter inactive).</summary>
    private static NumericPropertyFilter? ParseNumericPropertyFilter(string op, string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        if (!double.TryParse(value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var num))
            return null;

        return new NumericPropertyFilter { Operator = op, Value = num };
    }

    /// <summary>Parse a card count filter (Deck.Count). Returns null if empty/non-integer (filter inactive).</summary>
    private static int? ParseCountFilter(string value) =>
        int.TryParse(value?.Trim(), out var num) ? num : null;

    /// <summary>Parse a price filter in USD (Cards.Usd). Returns null if empty/non-numeric (filter inactive).</summary>
    private static float? ParsePriceFilter(string value) =>
        float.TryParse(value?.Trim(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var num)
            ? num : null;

    // ── Location mode: per-card actions ───────────────────────────────────
    private Dictionary<Guid, int>? GetCountMap() =>
        _physicalByCardId?.ToDictionary(kv => kv.Key, kv => kv.Value.Count);

    private async Task ChangeCardCount((MyCard card, int delta) e)
    {
        if (!FilterViewModel.CurrentCollectionId.HasValue) return;
        var (card, delta) = e;
        var newCount = card.Count + delta;
        if (newCount < 0) return;

        if (newCount == 0)
            await DeckCardService.RemoveCardsAsync(FilterViewModel.CurrentCollectionId.Value, new[] { card.Id });
        else
            await DeckCardService.UpdateCardAsync(FilterViewModel.CurrentCollectionId.Value, card.Id,
                new Dictionary<MagicCardField, object?> { [MagicCardField.Count] = newCount });

        // Record the operation in the rolling LastActions history — labeled with the target collection.
        await OnCardOperation.InvokeAsync(new CardOperationRecord(
            FilterViewModel.CurrentCollectionId.Value, card.Card,
            Math.Abs(delta), delta > 0 ? LastActionOperationEnum.Add : LastActionOperationEnum.Sub));

        // Re-query current page + refresh count map (no page reset)
        await ApplyFiltersAndPagination();
    }

