    /// <summary>The bulk list load skips CardFaces (10k cards × face rows for one preview).
    /// The Edit/Split/Move previews need the faces of exactly this card — load them now;
    /// the map entry travels by reference, so the dialog sees them.</summary>
    private async Task EnsureFacesAsync(MyCard card)
    {
        if (!card.Card.Has2Faces || card.Card.CardFaces is { Length: > 0 }) return;
        card.Card.CardFaces = await DbStore.GetCardFacesAsync(card.Card.Id);
    }

    /// <summary>One grouped query over Deck: total copies of each displayed card in the pinned collection.</summary>
    /// <summary>Deck view: which of the displayed cards have ≥1 copy in the deck's sideboard.
    /// One GetSideboardPresenceQuery per page — no per-row round-trips.</summary>
    private async Task<Dictionary<Guid, bool>?> LoadSideboardPresenceAsync(int deckId)
    {
        if (SideboardPresenceHandler is null || _displayCards.Count == 0)
            return null;

        return await SideboardPresenceHandler.Handle(
            new GetSideboardPresenceQuery(deckId, _displayCards.Select(c => c.Id).ToList()));
    }

    private async Task<Dictionary<Guid, int>> LoadPinnedCountsAsync(List<Card> cards)
    {
        if (cards.Count == 0 || PinnedCollectionId is null)
            return new Dictionary<Guid, int>();

        var counts = await DeckCardService.GetDeckCardCountsAsync(
            new[] { PinnedCollectionId.Value },
            cards.Select(c => c.Id).ToList());

        return counts.ToDictionary(kv => kv.Key.CardId, kv => kv.Value);
    }

    /// <summary>KB mode: add one copy of the card to the pinned collection (merge semantics if already present).</summary>
    private async Task AddCardToPinned(Card card)
    {
        if (!PinnedCollectionId.HasValue) return;

        await DeckCardService.MaterializeFromIdsAsync(PinnedCollectionId.Value, new[] { card.Id });
        await OnCardOperation.InvokeAsync(new CardOperationRecord(PinnedCollectionId.Value, card, 1, LastActionOperationEnum.Add));

        // Keep the pinned-total column in sync (same total LastActions shows) — immutable update so
        // Blazor detects the parameter change on CardListView.
        var current = _pinnedCountByCardId ?? new Dictionary<Guid, int>();
        _pinnedCountByCardId = new Dictionary<Guid, int>(current) { [card.Id] = current.GetValueOrDefault(card.Id) + 1 };
        StateHasChanged();
    }

    /// <summary>KB mode: remove one copy of the card from the pinned collection (full removal when the count hits 0).</summary>
    private async Task RemoveCardFromPinned(Card card)
    {
        if (!PinnedCollectionId.HasValue) return;

        var current = _pinnedCountByCardId?.GetValueOrDefault(card.Id) ?? 0;
        if (current <= 0) return;

        if (current == 1)
            await DeckCardService.RemoveCardsAsync(PinnedCollectionId.Value, new[] { card.Id });
        else
            await DeckCardService.UpdateCardAsync(PinnedCollectionId.Value, card.Id,
                new Dictionary<MagicCardField, object?> { [MagicCardField.Count] = current - 1 });

        await OnCardOperation.InvokeAsync(new CardOperationRecord(PinnedCollectionId.Value, card, 1, LastActionOperationEnum.Sub));

        // Keep the pinned-total column in sync — immutable update so Blazor detects the parameter change.
        var counts = _pinnedCountByCardId ?? new Dictionary<Guid, int>();
        var updated = new Dictionary<Guid, int>(counts);
        if (current - 1 <= 0) updated.Remove(card.Id);
        else updated[card.Id] = current - 1;
        _pinnedCountByCardId = updated;
        StateHasChanged();
    }

    // ── Sort — through single channel ────────────────────
    private void ToggleSort(string field)
    {
        if (FilterViewModel.SortField == field)
            FilterViewModel.SortAsc = !FilterViewModel.SortAsc;
        else
        {
            FilterViewModel.SortField = field;
            FilterViewModel.SortAsc = true;
        }
        FilterViewModel.Apply();  // Changed → OnFilterChanged resets page + re-queries
    }

    // ── View Mode (list / gallery) ───────────────────────
    private async Task SetViewMode(string mode)
    {
        if (_viewMode == mode) return;
        _viewMode = mode;
        await SaveViewModeAsync();
    }

    private async Task LoadViewModeAsync()
    {
        if (GetSettingQueryHandler is null) return;

        try
        {
            var json = await GetSettingQueryHandler.Handle(new GetUserSettingQuery(ViewModeSettingKey));
            if (json == "list" || json == "gallery" || json == "tree")
                _viewMode = json;
        }
        catch
        {
            // default _viewMode = "list"
        }
    }

    private async Task SaveViewModeAsync()
    {
        if (SaveSettingCommandHandler is null) return;

        try
        {
            await SaveSettingCommandHandler.Handle(new SaveUserSettingCommand(ViewModeSettingKey, _viewMode));
        }
        catch
        {
            // silently fail — settings are not critical
        }
    }

    /// <summary>Page-size stepper (gallery/tree) → re-query from page 1 with the new size.</summary>
    private async Task OnGalleryPageSizeChanged(int newSize)
    {
        _pageSize = Math.Clamp(newSize, 1, 150);
        _currentPage = 1;
        await SavePageSizeAsync();
        await ApplyFiltersAndPagination();
    }

    // ── Page Size Persistence (same pattern as splitter position / view mode) ──

    private async Task LoadPageSizeAsync()
    {
        if (GetSettingQueryHandler is null) return;

        try
        {
            var json = await GetSettingQueryHandler.Handle(new GetUserSettingQuery(PageSizeSettingKey));
            if (!string.IsNullOrEmpty(json) && int.TryParse(json, out var ps))
            {
                _pageSize = Math.Clamp(ps, 1, 150);
            }
        }
        catch
        {
            // default _pageSize = 50
        }
    }

    private async Task SavePageSizeAsync()
    {
        if (SaveSettingCommandHandler is null) return;

        try
        {
            await SaveSettingCommandHandler.Handle(new SaveUserSettingCommand(PageSizeSettingKey, _pageSize.ToString()));
        }
        catch
        {
            // silently fail — settings are not critical
        }
    }

    // ── Pagination ──────────────────────────────────────
    private bool _hasPrev => _currentPage > 1;
    private bool _hasNext => _currentPage < _totalPages;

    private async Task PrevPage()
    {
        if (_hasPrev)
        {
            _currentPage--;
            await ApplyFiltersAndPagination();
        }
    }

    private async Task NextPage()
    {
        if (_hasNext)
        {
            _currentPage++;
            await ApplyFiltersAndPagination();
        }
    }

