@using MagicAssistant.Core.Services.DeckManagement
@using MagicAssistant.Data.Model.NavigatorNodes
@inject IDeckManagementService DeckManagement

<div class="navigator" @onkeydown="OnKeyDown">

    @* ── Add Menu Overlay (click-outside to close, like context menu) ── *@
    @if (_activeAddMenuNodeId != null || _showRootAddMenu)
    {
        <div class="add-menu-overlay" @onclick="CloseAddMenu">
        </div>
    }

    <div class="navigator-header">
        <span>Collections &amp; Decks</span>
    </div>

    @* ── KnowledgeBase pseudo-node: sits above the tree, looks like a node but is not part of it ── *@
    <button class="btn-kb-node @(SelectedNodeId == null ? "active" : "")"
            @onclick="HandleShowAllCards"
            title="Browse all knowledge base cards">
        <span class="kb-icon"></span>
        <span class="kb-label">KnowledgeBase Cards</span>
    </button>

    @if (_loading)
    {
        <div class="navigator-loading">Loading...</div>
    }
    else if (_error != null)
    {
        <div class="navigator-error">
            <span>@_error</span>
            <button @onclick="ReloadRoot">Retry</button>
        </div>
    }
    else
    {
        <div class="tree-root">
            @foreach (var node in _rootNodes)
            {
                <DecksNavigatorTreeItem @key="node.Id + node.Name" Node="@node"
                          Depth="0"
                          SelectedId="@SelectedNodeId"
                          PinnedId="@PinnedNodeId"
                          ActiveAddMenuNodeId="@_activeAddMenuNodeId"
                          ExpandedSet="@_expandedNodes"
                          OnToggleExpand="ToggleNodeExpanded"
                          OnSelectDeck="OnSelectDeck"
                          OnContextMenuToggle="OnContextMenuToggle"
                          OnAskCreateNode="OnAskCreateNode"
                          OnAddMenuToggle="OnAddMenuToggle"
                          OnImportRequest="OnImportFromMenu" />
            }

            @* ── Add Node Button (root level) — unified AddNodeRow; ShowSpacer=false keeps the current depth-0 offset *@
            <AddNodeRow Depth="0" ShowSpacer="false" IsMenuOpen="_showRootAddMenu"
                        OnToggle="ToggleRootAddMenu" OnCreateNode="(t) => SelectAndShow(null, t)"
                        OnImportRequest="OnImportFromMenu" />
        </div>
    }

    @* ── Context Menu Overlay (click-outside to close) ── *@
    @if (_activeContextMenuNodeId != null)
    {
        <div class="context-menu-overlay" @onclick="CloseContextMenu">
        </div>
        @if (_contextTarget != null)
        {
            <div class="context-menu-fixed" style="--ctx-x: @(_contextMenuLeft.ToString("F0"))px; --ctx-y: @(_contextMenuTop.ToString("F0"))px;">
                <span class="context-label">@_contextTarget.Name</span>
                <button @onclick="() => BeginRename(_contextTarget)">
                    <span class="ctx-cell"><svg class="ctx-icon" viewBox="0 0 24 24" aria-hidden="true"><text x="1" y="17" font-size="15" font-weight="bold" fill="currentColor">ab</text><rect x="19.5" y="3" width="2.5" height="18" fill="currentColor"/></svg></span>Rename
                </button>
                @if (_contextTarget.NodeType != NodeType.Folder)
                {
                    @* Pin/Unpin + Clear — state dot (green = pin, red = lock) / eraser SVG; locked nodes get gray read-only items; sideboard inherits the deck's lock.
                       Deck with a sideboard: paired rows — deck action (1/3 width) | sideboard action (2/3 width). *@
                    @if (_contextTarget is NavigatorNodeDeck menuDeck && menuDeck.Sideboard != null)
                    {
                        var menuSideboard = menuDeck.Sideboard;
                        <div class="ctx-pair">
                            <button disabled="@_contextTarget.Locked"
                                    title="@(_contextTarget.Locked ? "Locked collections cannot be pinned" : null)"
                                    @onclick="() => TogglePinFromMenu(_contextTarget)"><span class="ctx-cell"><span class="menu-dot dot-pinned"></span></span>@(menuDeck.Id == PinnedNodeId ? "Unpin" : _contextTarget.Locked ? "Pin (unlock to pin)" : "Pin")
                            </button>
                            <button disabled="@_contextTarget.Locked"
                                    title="@(_contextTarget.Locked ? "Locked collections cannot be pinned" : null)"
                                    @onclick="() => TogglePinFromMenu(menuSideboard)"><span class="ctx-cell"><span class="menu-dot dot-pinned"></span></span>@(menuSideboard.Id == PinnedNodeId ? "Unpin sideboard" : _contextTarget.Locked ? "Pin sideboard (unlock to pin)" : "Pin sideboard")
                            </button>
                        </div>
                        <button @onclick="() => ToggleLockFromMenu(_contextTarget)"><span class="ctx-cell"><span class="menu-dot dot-locked"></span></span>@(_contextTarget.Locked ? "Unlock" : "Lock")
                        </button>
                        <div class="ctx-pair">
                            <button disabled="@_contextTarget.Locked"
                                    title="@(_contextTarget.Locked ? "Locked collections cannot be cleared" : null)"
                                    @onclick="() => AskClear(_contextTarget)"><span class="ctx-cell"><svg class="ctx-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7 21-4.3-4.3c-1-1-1-2.5 0-3.4l9.6-9.6c1-1 2.5-1 3.4 0l5.6 5.6c1 1 1 2.5 0 3.4L13 21"/><path d="M22 21H7"/><path d="m5 11 9 9"/></svg></span>Clear</button>
                            <button disabled="@_contextTarget.Locked"
                                    title="@(_contextTarget.Locked ? "Locked collections cannot be cleared" : null)"
                                    @onclick="() => AskClearSideboard(menuDeck)"><span class="ctx-cell"><svg class="ctx-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7 21-4.3-4.3c-1-1-1-2.5 0-3.4l9.6-9.6c1-1 2.5-1 3.4 0l5.6 5.6c1 1 1 2.5 0 3.4L13 21"/><path d="M22 21H7"/><path d="m5 11 9 9"/></svg></span>Clear sideboard</button>
                        </div>
                    }
                    else
                    {
                        <button disabled="@_contextTarget.Locked"
                                title="@(_contextTarget.Locked ? "Locked collections cannot be pinned" : null)"
                                @onclick="() => TogglePinFromMenu(_contextTarget)"><span class="ctx-cell"><span class="menu-dot dot-pinned"></span></span>@(_contextTarget.Id == PinnedNodeId ? "Unpin" : _contextTarget.Locked ? "Pin (unlock to pin)" : "Pin")
                        </button>
                        <button @onclick="() => ToggleLockFromMenu(_contextTarget)"><span class="ctx-cell"><span class="menu-dot dot-locked"></span></span>@(_contextTarget.Locked ? "Unlock" : "Lock")
                        </button>
                        <button disabled="@_contextTarget.Locked"
                                title="@(_contextTarget.Locked ? "Locked collections cannot be cleared" : null)"
                                @onclick="() => AskClear(_contextTarget)"><span class="ctx-cell"><svg class="ctx-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7 21-4.3-4.3c-1-1-1-2.5 0-3.4l9.6-9.6c1-1 2.5-1 3.4 0l5.6 5.6c1 1 1 2.5 0 3.4L13 21"/><path d="M22 21H7"/><path d="m5 11 9 9"/></svg></span>Clear</button>
                    }
                    @* Import — cards merge into the clicked node's CollectionId (or its sideboard); gray read-only while locked, same as Clear.
                       Export — read-only, never disabled. Deck with sideboard: paired rows 1/3 | 2/3, same as pin/clear. *@
                    @if (_contextTarget is NavigatorNodeDeck ioDeck && ioDeck.Sideboard != null)
                    {
                        <div class="ctx-pair">
                            <button disabled="@_contextTarget.Locked"
                                    title="@(_contextTarget.Locked ? "Locked collections cannot be imported into" : null)"
                                    @onclick="() => ImportFromMenu(_contextTarget)"><span class="ctx-cell"><svg class="ctx-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></span>Import</button>
                            <button disabled="@_contextTarget.Locked"
                                    title="@(_contextTarget.Locked ? "Locked collections cannot be imported into" : null)"
                                    @onclick="() => ImportSideboardFromMenu(ioDeck)"><span class="ctx-cell"><svg class="ctx-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></span>Import sideboard</button>
                        </div>
                        <div class="ctx-pair">
                            <button @onclick="() => ExportFromMenu(_contextTarget)"><span class="ctx-cell"><svg class="ctx-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg></span>Export</button>
                            <button @onclick="() => ExportSideboardFromMenu(ioDeck)"><span class="ctx-cell"><svg class="ctx-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg></span>Export sideboard</button>
                        </div>
                    }
                    else
                    {
                        <button disabled="@_contextTarget.Locked"
                                title="@(_contextTarget.Locked ? "Locked collections cannot be imported into" : null)"
                                @onclick="() => ImportFromMenu(_contextTarget)"><span class="ctx-cell"><svg class="ctx-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></span>Import</button>
                        <button @onclick="() => ExportFromMenu(_contextTarget)"><span class="ctx-cell"><svg class="ctx-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg></span>Export</button>
                    }
                }
                <hr class="context-sep" />
                <button class="danger" @onclick="() => AskDelete(_contextTarget)">
                    <span class="ctx-cell"><svg class="ctx-icon" viewBox="0 0 24 24" fill="none" stroke="#e74c3c" stroke-width="3.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></span>Delete
                </button>
            </div>
        }
    }

    @* ── Create Node Dialog (Folder / Collection / Deck) ── *@
    @if (_showCreateDialog)
    {
        <div class="dialog-overlay" @onclick="CloseCreateDialog">
            <div class="dialog-box" @onclick:stopPropagation="true">
                <div class="dialog-title">@GetCreateDialogTitle()</div>
                <input @bind="_createName" @onkeypress="OnCreateKey"
                       placeholder="@GetCreatePlaceholder()"
                       class="dialog-input" @ref="_createNameInput" />
                <div class="dialog-actions">
                    <button class="btn-primary" @onclick="ConfirmCreate">Create</button>
                    <button class="btn-secondary" @onclick="CloseCreateDialog">Cancel</button>
                </div>
            </div>
        </div>
    }

    @* ── Rename Dialog ── *@
    @if (_showRenameDialog)
    {
        <div class="dialog-overlay" @onclick="CloseRenameDialog">
            <div class="dialog-box" @onclick:stopPropagation="true">
                <div class="dialog-title">Rename</div>
                <input @bind="_renameValue" @onkeypress="OnRenameKey"
                       placeholder="New name..."
                       class="dialog-input" @ref="_renameInput" />
                <div class="dialog-actions">
                    <button class="btn-primary" @onclick="ConfirmRename" disabled="@string.IsNullOrWhiteSpace(_renameValue)">Save</button>
                    <button class="btn-secondary" @onclick="CloseRenameDialog">Cancel</button>
                </div>
            </div>
        </div>
    }

    @* ── Delete Confirmation ── *@
    @if (_showDeleteConfirm)
    {
        <div class="dialog-overlay" @onclick="CloseDeleteConfirm">
            <div class="dialog-box" @onclick:stopPropagation="true">
                <div class="dialog-title">Delete</div>
                <p>Delete "<strong>@_deleteTarget?.Name</strong>" and all its cards?</p>
                <div class="dialog-actions">
                    <button class="btn-danger" @onclick="ConfirmDelete">Delete</button>
                    <button class="btn-secondary" @onclick="CloseDeleteConfirm">Cancel</button>
                </div>
            </div>
        </div>
    }

    @* ── Clear Sideboard Confirmation (deck nodes only; the SB node itself is kept) ── *@
    @if (_showClearSbConfirm)
    {
        <div class="dialog-overlay" @onclick="CloseClearSbConfirm">
            <div class="dialog-box" @onclick:stopPropagation="true">
                <div class="dialog-title">Clear sideboard</div>
                <p>Delete all @_clearSbTargetSideboardCardCount cards from the sideboard of "<strong>@_clearSbTarget?.Name</strong>"? The sideboard itself is kept.</p>
                <div class="dialog-actions">
                    <button class="btn-danger" @onclick="ConfirmClearSideboard">Clear</button>
                    <button class="btn-secondary" @onclick="CloseClearSbConfirm">Cancel</button>
                </div>
            </div>
        </div>
    }

    @* ── Clear Confirmation (deck/collection nodes; the node itself is kept) ── *@
    @if (_showClearConfirm)
    {
        <div class="dialog-overlay" @onclick="CloseClearConfirm">
            <div class="dialog-box" @onclick:stopPropagation="true">
                <div class="dialog-title">Clear</div>
                <p>Delete all @_clearTargetCardCount cards from the @GetClearNodeKind() "<strong>@_clearTarget?.Name</strong>"? The @GetClearNodeKind() itself is kept.</p>
                <div class="dialog-actions">
                    <button class="btn-danger" @onclick="ConfirmClear">Clear</button>
                    <button class="btn-secondary" @onclick="CloseClearConfirm">Cancel</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // ── Tree state ─────────────────────────────────────────
    /// <summary>Root-level nodes from the pre-built hierarchical tree.</summary>
    private List<NavigatorNodeBase>? _rootNodes;
    /// <summary>Folder IDs that are visually expanded. Decoupled from data — collapse only hides.</summary>
    private HashSet<int> _expandedNodes = new();

    private bool _loading;
    private string? _error;

    // ── Context menu ───────────────────────────────────────
    /// <summary>ID of the node whose context-menu is currently open (for overlay click-outside).</summary>
    private int? _activeContextMenuNodeId;
    /// <summary>The node being acted on by the context menu.</summary>
    private NavigatorNodeBase? _contextTarget;
    /// <summary>Viewport coordinates for fixed-position context menu overlay.</summary>
    private double _contextMenuTop;
    private double _contextMenuLeft;

    // ── Create Node Dialog ────────────────────────────────
    /// <summary>Dialog for creating a new node (Folder/Collection/Deck).</summary>
    private bool _showCreateDialog;
    private string _createName = "";
    private int? _createParentId;
    private NodeType _createNodeType;
    private ElementReference _createNameInput = default!;

    private bool _showRenameDialog;
    private string _renameValue = "";
    private NavigatorNodeBase? _renameTarget;

    private bool _showDeleteConfirm;
    private NavigatorNodeBase? _deleteTarget;

    // ── Clear Sideboard Confirmation ─────────────────────
    private bool _showClearSbConfirm;
    private NavigatorNodeDeck? _clearSbTarget;

    /// <summary>Sideboard card count for the confirmation text (captured when the dialog opens).</summary>
    private int _clearSbTargetSideboardCardCount;

    // ── Clear Confirmation (deck/collection nodes) ───────
    private bool _showClearConfirm;
    private NavigatorNodeBase? _clearTarget;

    /// <summary>Node card count for the confirmation text (captured when the dialog opens).</summary>
    private int _clearTargetCardCount;

    // ── Root add menu ──────────────────────────────────────
    private bool _showRootAddMenu;

    /// <summary>
    /// ID of the folder node whose add-menu is currently open (for overlay click-outside).
    /// null = no folder add-menu open. Distinct from _showRootAddMenu.
    /// </summary>
    private int? _activeAddMenuNodeId;

    // ── Element references for dialog focus ────────────────
    private ElementReference _renameInput = default!;

    // ── Events to parent (MainLayout) ──────────────────────
    /// <summary>Selected node as a LockableCollection (Id, Locked, Name) built from the node's state.</summary>
    [Parameter] public EventCallback<LockableCollection> OnDeckSelected { get; set; }

    /// <summary>Pin button click — the clicked node as a LockableCollection.
    /// These buttons are the only source that changes MainLayout._pinnedCollection.</summary>
    [Parameter] public EventCallback<LockableCollection> OnPinToggled { get; set; }

    /// <summary>Lock state changed on a node (and, for decks, its sideboard) — MainLayout keeps the
    /// _currentCollection/_pinnedCollection IsLocked snapshots fresh and unpins locked nodes.</summary>
    [Parameter] public EventCallback<(int Id, bool Locked)> OnNodeLockToggled { get; set; }
    [Parameter] public EventCallback OnShowAllCards { get; set; }

    /// <summary>A node (and its subtree) was deleted — MainLayout drops any context referencing it.</summary>
    [Parameter] public EventCallback<int> OnNodeDeleted { get; set; }

    /// <summary>Import requested from the add-node menu — parentId null = root level.
    /// MainLayout opens DeckImportWizard with that parent context (new decks are created inside it).</summary>
    [Parameter] public EventCallback<int?> OnImportRequested { get; set; }

    /// <summary>Import requested from the ⋯ context menu — the CollectionId cards are merged INTO (the clicked node,
    /// or its sideboard's own ID). MainLayout opens DeckImportWizard pre-targeted at that existing node.</summary>
    [Parameter] public EventCallback<int> OnImportIntoRequested { get; set; }

    /// <summary>Export requested from the ⋯ context menu — the clicked node (deck/collection).
    /// MainLayout opens DeckExportWizard for that node, not for the displayed one.</summary>
    [Parameter] public EventCallback<int> OnExportRequested { get; set; }

    /// <summary>Clear sideboard requested from the ⋯ context menu (deck nodes only) — the SIDEBOARD node's
    /// own ID (NavigatorNodeDeck.Sideboard.Id), not the parent deck's. MainLayout wipes all cards out of
    /// that sideboard via IDeckCardService (the SB node is kept) and refreshes navigator counts / strip stats.</summary>
    [Parameter] public EventCallback<int> OnClearSideboardRequested { get; set; }

    /// <summary>Clear requested from the ⋯ context menu (deck/collection nodes only, folders ignored) —
    /// the clicked node's own ID. MainLayout wipes all cards out of that node via IDeckCardService
    /// (the node is kept) and refreshes navigator counts / strip stats.</summary>
    [Parameter] public EventCallback<int> OnClearRequested { get; set; }

    /// <summary>Currently displayed collection node (MainLayout._currentCollection.CollectionId).
    /// Pure projection: non-null highlights that node, null (KB mode) highlights nothing —
    /// clicking the KnowledgeBase button clears the tree selection.</summary>
    [Parameter] public int? SelectedNodeId { get; set; }

    /// <summary>ID of the currently pinned node (MainLayout._pinnedCollection.CollectionId)
    /// — drives the Pin/Unpin labels in the ⋯ context menu and the green marker dot on node rows.</summary>
    [Parameter] public int? PinnedNodeId { get; set; }

    // ── Lifecycle ──────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await LoadRoot();
    }

    /// <summary>Focus the active dialog input after render (autofocus unreliable in Blazor Server).</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_showCreateDialog)
        {
            try { await _createNameInput.FocusAsync(); }
            catch { /* element not yet in DOM */ }
        }
        else if (_showRenameDialog)
        {
            try { await _renameInput.FocusAsync(); }
            catch { /* element not yet in DOM */ }
        }
    }

    /// <summary>
    /// GetNodesTreeAsync returns a pre-built hierarchical tree:
    /// Dictionary&lt;int, NavigatorNodeBase&gt; where each folder's Children are already populated.
    /// We extract root nodes (values whose ParentId is null) and mark all folders as expanded.
    /// </summary>
    private async Task LoadRoot()
    {
        _loading = true;
        _error = null;
        try
        {
            var tree = await DeckManagement.GetAllNodesAsync();

            // Root nodes: those not nested under any parent in the dictionary.
            // The handler already filters ParentId == null, so all returned values are roots.
            _rootNodes = new List<NavigatorNodeBase>(tree.Values);

            // Expand all folders by default
            CollectAllFolders(_rootNodes, _expandedNodes);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Re-fetches the tree (single query) and swaps in fresh node objects so card counts
    /// reflect the latest Deck-table state. Called by MainLayout after any card-mutating operation
    /// (+/−, KB add, Move, Split, Edit, Import). Expansion and selection survive — they are keyed
    /// by id, not by node references.
    /// </summary>
    public async Task RefreshCardCountsAsync()
    {
        if (_rootNodes == null) return;  // initial load failed — nothing to refresh
        try
        {
            var tree = await DeckManagement.GetAllNodesAsync();
            _rootNodes = new List<NavigatorNodeBase>(tree.Values);
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Keep the current tree — a failed refresh must not blank out the navigator.
        }
    }

    private static void CollectAllFolders(IEnumerable<NavigatorNodeBase> nodes, HashSet<int> expandedSet)
    {
        foreach (var node in nodes)
        {
            if (node is NavigatorNodeFolder folder)
            {
                expandedSet.Add(folder.Id);
                if (folder.Children != null)
                    CollectAllFolders(folder.Children, expandedSet);
            }
        }
    }

    // ── Tree: expand / collapse (visibility toggle) ────────
    private void ToggleNodeExpanded(int folderId)
    {
        if (_expandedNodes.Contains(folderId))
        {
            _expandedNodes.Remove(folderId);
            // The add-node row is a child of the folder — collapsing removes it,
            // so drop the open add-menu state to avoid a dangling overlay.
            if (_activeAddMenuNodeId == folderId)
                _activeAddMenuNodeId = null;
        }
        else
            _expandedNodes.Add(folderId);
    }

    /// <summary>Selection request from the tree (deck/collection/SB). The highlight is a pure
    /// projection of SelectedNodeId — KB mode (null) leaves nothing highlighted.
    /// Folders are not locations and never select; re-clicking the displayed node is a no-op.</summary>
    private async Task OnSelectDeck(NavigatorNodeBase node)
    {
        if (node.NodeType == NodeType.Folder) return;
        if (node.Id == SelectedNodeId) return;
        await OnDeckSelected.InvokeAsync(ToLockable(node));
    }

    /// <summary>Builds the navigation payload (Id, Locked, Name) from a tree node.</summary>
    private static LockableCollection ToLockable(NavigatorNodeBase node) => new()
    {
        CollectionId = node.Id,
        IsLocked = node.Locked,
        Name = node.Name,
        NodeType = node.NodeType
    };

    /// <summary>
    /// Selects a node by id through the same path as a click in the tree
    /// (external sources, e.g. the InstancesView jump). The node's own (Id, Locked)
    /// pair is reported to MainLayout via OnDeckSelected. No-op if the node is not in the tree.
    /// </summary>
    public async Task SelectNodeAsync(int nodeId)
    {
        var node = FindNodeInTree(_rootNodes ?? Enumerable.Empty<NavigatorNodeBase>(), nodeId);
        if (node == null) return;
        await OnSelectDeck(node);
    }

    /// <summary>Pin/Unpin from the ⋯ context menu — closes the menu, then reuses the shared toggle.
    /// The menu renders this item disabled for locked nodes, so it never fires there.</summary>
    private async Task TogglePinFromMenu(NavigatorNodeBase node)
    {
        CloseContextMenu();
        await OnPinToggle(node);
    }

    /// <summary>Pin request — passes the clicked node up as a LockableCollection; MainLayout toggles the pin.
    /// Only deck/collection/sideboard nodes arrive here (folders have no pin).</summary>
    private async Task OnPinToggle(NavigatorNodeBase node)
    {
        await OnPinToggled.InvokeAsync(ToLockable(node));
    }

    private async Task HandleShowAllCards()
    {
        await OnShowAllCards.InvokeAsync();
    }

    // ── Context menu ───────────────────────────────────────
    private void CloseContextMenu()
    {
        _contextTarget = null;
        _activeContextMenuNodeId = null;
    }

    // ── Create Node (unified dialog → CreateNodeAsync → GetNodesBranchAsync) ──

    /// <summary>Open the name-input dialog for creating a node of the given type.</summary>
    private void ShowCreateDialog(int? parentId, NodeType nodeType)
    {
        CloseContextMenu();
        _createName = "";
        _createParentId = parentId;
        _createNodeType = nodeType;
        _showCreateDialog = true;
    }

    private string GetCreateDialogTitle() => _createNodeType switch
    {
        NodeType.Folder => "New Folder",
        NodeType.Collection => "New Collection",
        NodeType.Deck => "New Deck",
        _ => "New Node"
    };

    private string GetCreatePlaceholder() => _createNodeType switch
    {
        NodeType.Folder => "Folder name...",
        NodeType.Collection => "Collection name...",
        NodeType.Deck => "Deck name...",
        _ => "Name..."
    };

    /// <summary>
    /// 1. DeckManagement.CreateNodeAsync(parentId, name, nodeType) → returns ID.
    /// 2. DeckManagement.GetNodesBranchAsync(id) → returns hierarchical NavigatorNodeBase with Sideboard/Children populated.
    /// 3. Insert into tree + auto-select.
    /// </summary>
    private async Task ConfirmCreate()
    {
        if (string.IsNullOrWhiteSpace(_createName)) return;
        try
        {
            var name = _createName.Trim();

            // Step 1: Create node → returns ID only
            var createdId = await DeckManagement.CreateNodeAsync(_createParentId, name, _createNodeType);

            // Step 2: Fetch the created branch — one hierarchical NavigatorNodeBase (Sideboard for Decks, Children for Folders)
            var created = await DeckManagement.GetNodesBranchAsync(createdId);
            if (created == null) return;

            // Expand if Folder
            if (created.NodeType == NodeType.Folder)
                _expandedNodes.Add(created.Id);

            // Step 3: Insert into tree + auto-select
            InsertIntoTree(_createParentId, created);
            CloseCreateDialog();

            if (created.NodeType == NodeType.Deck || created.NodeType == NodeType.Collection)
                await OnSelectDeck(created);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void CloseCreateDialog()
    {
        _showCreateDialog = false;
        _createName = "";
        _createParentId = null;
    }

    private async Task OnCreateKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_createName))
            await ConfirmCreate();
    }

    // ── Rename ─────────────────────────────────────────────
    private ValueTask BeginRename(NavigatorNodeBase node)
    {
        if (node.Locked) return default;
        CloseContextMenu();
        _renameTarget = node;
        _renameValue = node.Name;
        _showRenameDialog = true;
        return default;
    }

    private async Task ConfirmRename()
    {
        if (_renameTarget == null || string.IsNullOrWhiteSpace(_renameValue)) return;
        var newName = _renameValue.Trim();
        try
        {
            await DeckManagement.RenameAsync(_renameTarget.Id, newName);
            // In-place: the node object is shared in the tree — direct mutation works
            _renameTarget.Name = newName;
            CloseRenameDialog();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

