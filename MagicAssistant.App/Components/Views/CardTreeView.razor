@* CardTreeView — self-contained card tree (grouped view).
   Pure presentation component: receives a page of cards from the parent
   (already filtered/sorted/paged) and emits events. The parent owns all data
   loading, filtering, pagination state and selection.
   Grouping (color/type/set) is a display-only concern — kept inside this
   component and applied to the current page. *@

@using System.Text
<div class="tree-view-container">
    @* ── Group selector ── *@
    <div class="tree-toolbar">
        <span class="toolbar-label">Group by:</span>
        <button class="group-btn @(_groupBy == "color" ? "active" : "")"
                @onclick="OnColorGroup">Color</button>
        <button class="group-btn @(_groupBy == "type" ? "active" : "")"
                @onclick="OnTypeGroup">Type</button>
        <button class="group-btn @(_groupBy == "set" ? "active" : "")"
                @onclick="OnSetGroup">Set</button>
    </div>

    @* ── Tree groups — mosaic of fixed 300px tiles; auto-fill wraps to a single
       vertical stack when the area narrows. ── *@
    <div class="tree-groups">
        @foreach (var group in _groups)
        {
            <div class="tree-group">
                <div class="group-header" @onclick="() => ToggleGroup(group.Key)">
                    <span class="expand-icon">@(_expandedGroups.Contains(group.Key) ? "▾" : "▸")</span>
                    @* Color groups lead with mana symbols — same icons as the filter dialog checkboxes. *@
                    @if (_groupBy == "color")
                    {
                        <span class="group-symbols">
                            @foreach (var ch in group.Key == "Colorless" ? "C" : group.Key)
                            {
                                <span class="card-symbol card-symbol-@ch"></span>
                            }
                        </span>
                    }
                    <span class="group-name">@group.Key</span>
                    <span class="group-count">(@group.Value.Count)</span>
                </div>

                @if (_expandedGroups.Contains(group.Key))
                {
                    <div class="group-cards">
                        @foreach (var card in group.Value)
                        {
                            <div class="tree-card @(SelectedCardId.HasValue && SelectedCardId.Value == card.Id ? "selected" : "")"
                                 @onclick="() => SelectCard(card)">
                                <span class="card-name">@card.Name@(Counts != null && Counts.TryGetValue(card.Id, out var count) && count > 1 ? $" ×{count}" : "")</span>
                                <span class="card-cmc">@FormatCmc(card.CmcText)</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    @* ── Summary ── *@
    <div class="tree-summary">
        <span>@Cards.Count cards in @_groups.Count groups</span>
    </div>
</div>

@code {
    /// <summary>The FULL filtered card list — the tree never pages; the parent loads every
    /// matching card (scoped to a deck or a single set by the view-availability rules).</summary>
    [Parameter] public IReadOnlyList<Card> Cards { get; set; } = Array.Empty<Card>();

    [Parameter] public Guid? SelectedCardId { get; set; }

    /// <summary>Card row clicked.</summary>
    [Parameter] public EventCallback<Card> OnCardClicked { get; set; }

    /// <summary>Copy counts per card Id (location mode). Null = KB mode — no counts shown.</summary>
    [Parameter] public Dictionary<Guid, int>? Counts { get; set; }

    // Grouping state (display-only — grouping is applied to the full list)
    private Dictionary<string, List<Card>> _groups = new();
    private HashSet<string> _expandedGroups = new();
    private string _groupBy = "color";
    private IReadOnlyList<Card>? _lastCards;

    protected override void OnParametersSet()
    {
        // Rebuild groups when the parent hands over a new list of cards
        if (!ReferenceEquals(Cards, _lastCards))
        {
            _lastCards = Cards;
            ApplyGrouping();
        }
    }

    private async Task SelectCard(Card card)
    {
        await OnCardClicked.InvokeAsync(card);
    }

    private void ApplyGrouping()
    {
        if (Cards.Count == 0)
        {
            _groups = new Dictionary<string, List<Card>>();
            _expandedGroups = new HashSet<string>();
            return;
        }

        var dict = new Dictionary<string, List<Card>>(StringComparer.OrdinalIgnoreCase);

        foreach (var card in Cards)
        {
            // One card can belong to several groups — same OR-semantics as the filter dialog
            // (an Artifact Creature passes both the artifact and the creature filter).
            var keys = _groupBy switch
            {
                "color" => ColorGroupKeys(card),
                "type"  => TypeGroupKeys(card),
                "set"   => new[] { card.SetCode ?? "Unknown" },
                _       => new[] { "Uncategorized" }
            };

            foreach (var key in keys)
            {
                if (!dict.TryGetValue(key, out var list))
                {
                    list = new List<Card>();
                    dict[key] = list;
                }
                list.Add(card);
            }
        }

        // Sort groups by count descending
        _groups = dict.OrderByDescending(g => g.Value.Count)
                      .ToDictionary(g => g.Key, g => g.Value, StringComparer.OrdinalIgnoreCase);

        // Groups start collapsed — the user opens only what they need.
        _expandedGroups = new HashSet<string>();
    }

    /// <summary>
    /// Canonical card types — the exact list the filter dialog offers. Membership predicate is
    /// the same too: case-insensitive substring of the Type line (SQL: ma_like('%type%', Type)),
    /// so "Legendary Creature — Elf" is a Creature, and split/hybrid lines land in every group
    /// they contain. Cards matching none (Battle, Dungeon…) fall into "Other".
    /// </summary>
    private static readonly (string Label, string Needle)[] CanonicalTypes =
    {
        ("Artifact", "artifact"), ("Creature", "creature"), ("Enchantment", "enchantment"),
        ("Instant", "instant"), ("Land", "land"), ("Planeswalker", "planeswalker"), ("Sorcery", "sorcery"),
    };

    private static IEnumerable<string> TypeGroupKeys(Card card)
    {
        var line = (card.Type ?? string.Empty).ToLowerInvariant();
        var keys = CanonicalTypes.Where(t => line.Contains(t.Needle)).Select(t => t.Label).ToList();
        return keys.Count > 0 ? keys : new[] { "Other" };
    }

    /// <summary>
    /// Color groups from ColorBits — the same bitmask the filter dialog filters on, not the
    /// ColorType string. Key = the card's WUBRG combination ("W", "WU", …), colorless → "Colorless".
    /// DFCs (ColorBits is null — bits live on faces) join the group of every face combination,
    /// mirroring the dialog's OR-over-faces matching.
    /// </summary>
    private static IEnumerable<string> ColorGroupKeys(Card card)
    {
        if (card.ColorBits is int bits)
            return new[] { ColorKey(bits) };
        if (card.CardFaces is { Length: > 0 } faces)
            return faces.Select(f => ColorKey(f.ColorBits)).Distinct().ToList();
        return new[] { "Colorless" };
    }

    private static string ColorKey(int bits)
    {
        var sb = new StringBuilder();
        if ((bits & (int)ColorBitFlags.W) != 0) sb.Append('W');
        if ((bits & (int)ColorBitFlags.U) != 0) sb.Append('U');
        if ((bits & (int)ColorBitFlags.B) != 0) sb.Append('B');
        if ((bits & (int)ColorBitFlags.R) != 0) sb.Append('R');
        if ((bits & (int)ColorBitFlags.G) != 0) sb.Append('G');
        return sb.Length == 0 ? "Colorless" : sb.ToString();
    }

    private void SetGroupBy(string groupBy)
    {
        _groupBy = groupBy;
        ApplyGrouping();
    }

    // Explicit parameterless overloads for Razor @onclick bindings
    private void OnColorGroup() => SetGroupBy("color");
    private void OnTypeGroup() => SetGroupBy("type");
    private void OnSetGroup() => SetGroupBy("set");

    private void ToggleGroup(string key)
    {
        if (_expandedGroups.Contains(key))
            _expandedGroups.Remove(key);
        else
            _expandedGroups.Add(key);
    }

    /// <summary>Same as the list view: "3.0" → "3", "2.5" stays; CMC 0 renders as empty
    /// (lands on the right edge of the row — the tree has no "—" placeholder).</summary>
    private static string FormatCmc(string? cmcText)
    {
        if (string.IsNullOrEmpty(cmcText)) return string.Empty;
        if (cmcText.EndsWith(".0")) cmcText = cmcText[..^2];
        return cmcText == "0" ? string.Empty : cmcText;
    }
}
