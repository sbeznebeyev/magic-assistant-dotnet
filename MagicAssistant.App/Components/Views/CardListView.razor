@* CardListView — self-contained card table (list view).
   Pure presentation component: receives a page of cards from the parent
   (already filtered/sorted/paged) and emits events. The parent owns all data
   loading, filtering, pagination state and selection. *@
@using System.Text
@using MagicAssistant.App.Components.Shared

<div class="card-list-view">
    <div class="table-wrapper">
        <table class="card-table">
            <thead>
                <tr>
                    @if (IsDeckMode || PinnedCounts != null)
                    {
                        <th class="col-total">Total</th>
                    }
                    @if (!IsDeckMode)
                    {
                        <th class="col-num">#</th>
                    }
                    @* Sortable headers: click = switch sort to this column (ascending if new),
                       repeat click on the same header toggles the direction. *@
                    <th class="col-name sortable @(IsSorted(CardListFilter.SortFields.Name) ? "sorted" : "")"
                        @onclick="@(() => SortHeader(CardListFilter.SortFields.Name))">Name<span class="sort-arrow">@SortIndicator(CardListFilter.SortFields.Name)</span></th>
                    <th class="col-cmc sortable @(IsSorted(CardListFilter.SortFields.CmcNumber) ? "sorted" : "")"
                        @onclick="@(() => SortHeader(CardListFilter.SortFields.CmcNumber))">CMC<span class="sort-arrow">@SortIndicator(CardListFilter.SortFields.CmcNumber)</span></th>
                    <th class="col-cost">Cost</th>
                    <th class="col-rarity sortable @(IsSorted(CardListFilter.SortFields.Rarity) ? "sorted" : "")"
                        @onclick="@(() => SortHeader(CardListFilter.SortFields.Rarity))">Rarity<span class="sort-arrow">@SortIndicator(CardListFilter.SortFields.Rarity)</span></th>
                    <th class="col-set sortable @(IsSorted(CardListFilter.SortFields.SetCode) ? "sorted" : "")"
                        @onclick="@(() => SortHeader(CardListFilter.SortFields.SetCode))">Set<span class="sort-arrow">@SortIndicator(CardListFilter.SortFields.SetCode)</span></th>
                    <th class="col-type sortable @(IsSorted(CardListFilter.SortFields.Type) ? "sorted" : "")"
                        @onclick="@(() => SortHeader(CardListFilter.SortFields.Type))">Type<span class="sort-arrow">@SortIndicator(CardListFilter.SortFields.Type)</span></th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Cards.Count; i++)
                {
                    var card = Cards[i];
                    var physical = Physicals?.GetValueOrDefault(card.Id);
                    <tr class="@(SelectedCardId == card.Id ? "selected" : "")"
                        @onclick="() => SelectCard(card)">
                        @if (IsDeckMode)
                        {
                            @* Deck mode: the Total column replaces the old count column — always > 0, because a
                               card whose count drops to 0 disappears from the deck *@
                            <td class="col-total">
                                @if (physical != null && !Locked)
                                {
                                    <div class="count-control">
                                        <button class="count-btn" @onclick:stopPropagation="true"
                                                @onclick="() => ChangeCount(physical, -1)" title="Decrease count">−</button>
                                        <span class="count-value">@physical.Count</span>
                                        <button class="count-btn" @onclick:stopPropagation="true"
                                                @onclick="() => ChangeCount(physical, 1)" title="Increase count">+</button>
                                    </div>
                                }
                                else if (physical != null)
                                {
                                    @* Locked location — count is shown read-only, no mutation buttons *@
                                    <span class="count-value">@physical.Count</span>
                                }
                            </td>
                        }
                        else if (PinnedCounts != null)
                        {
                            @* KB mode with a pinned target — unified with deck mode: [−] total [+] in the
                               leftmost column; − is hidden when the total is 0 (only possible here, never in
                               deck mode); locked pinned → read-only value *@
                            var pinnedTotal = PinnedCounts.GetValueOrDefault(card.Id);
                            <td class="col-total">
                                @if (!PinnedLocked)
                                {
                                    <div class="count-control">
                                        @if (pinnedTotal > 0)
                                        {
                                            <button class="count-btn" @onclick:stopPropagation="true"
                                                    @onclick="() => RemoveFromFixed(card)" title="Remove from fixed collection">−</button>
                                        }
                                        <span class="count-value">@(pinnedTotal > 0 ? pinnedTotal.ToString() : "")</span>
                                        <button class="count-btn" @onclick:stopPropagation="true"
                                                @onclick="() => AddToFixed(card)" title="Add to fixed collection">+</button>
                                    </div>
                                }
                                else
                                {
                                    <span class="count-value">@(pinnedTotal > 0 ? pinnedTotal.ToString() : "")</span>
                                }
                            </td>
                        }
                        @if (!IsDeckMode)
                        {
                            <td class="col-num">@((CurrentPage - 1) * PageSize + i + 1)</td>
                        }
                        <td class="col-name">
                            <span class="card-name">@(card.PrintedName ?? card.Name)</span>
                            @if (physical != null && !Locked)
                            {
                                <button class="edit-btn" @onclick:stopPropagation="true"
                                        @onclick="() => EditCard(physical)" title="Edit card">✎</button>
                                @* Always available — even a single copy can move deck↔sideboard as a whole. *@
                                <button class="split-btn" @onclick:stopPropagation="true"
                                        @onclick="() => SplitCard(physical)" title="Split pile">✂</button>
                            }
                        </td>
                        <td class="col-cmc">@(card.CmcNumber > 0 ? FormatCmc(card.CmcText) : "—")</td>
                        <td class="col-cost"><MagicText Text="@ManaCost(card)" /></td>
                        <td class="col-rarity">
                            <span class="rarity-badge @(GetRarityClass(card.Rarity))">
                                @card.Rarity
                            </span>
                        </td>
                        <td class="col-set">@(card.SetCode ?? "—")</td>
                        <td class="col-type" title="@(card.PrintedTypeLine ?? card.Type)">@Truncate(card.PrintedTypeLine ?? card.Type, 28)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ── Pagination ── *@
    <div class="gallery-pagination">
        <div class="pagination-buttons">
            <button @onclick="PrevPage" disabled="@(!HasPrev)" class="page-btn">← Prev</button>
            <span class="page-info">Page @CurrentPage / @TotalPages</span>
            <button @onclick="NextPage" disabled="@(!HasNext)" class="page-btn">Next →</button>
        </div>
    </div>
</div>

@code {
    /// <summary>Cards of the current page (parent already applied filter/sort/paging).</summary>
    [Parameter] public IReadOnlyList<Card> Cards { get; set; } = Array.Empty<Card>();

    /// <summary>1-based index of the current page (used for the global row number in "#").</summary>
    [Parameter] public int CurrentPage { get; set; } = 1;

    [Parameter] public int TotalPages { get; set; }

    /// <summary>Page size — must match the size used by the parent for its query.</summary>
    [Parameter] public int PageSize { get; set; } = 50;

    [Parameter] public Guid? SelectedCardId { get; set; }

    /// <summary>Card row clicked.</summary>
    [Parameter] public EventCallback<Card> OnCardClicked { get; set; }

    /// <summary>← Prev requested (parent re-queries page CurrentPage - 1).</summary>
    [Parameter] public EventCallback OnPrevPage { get; set; }

    /// <summary>Next → requested (parent re-queries page CurrentPage + 1).</summary>
    [Parameter] public EventCallback OnNextPage { get; set; }

    /// <summary>Physical instances of the cards in the current location (deck/sideboard/collection).
    /// Null = KB mode — no count controls rendered.</summary>
    [Parameter] public Dictionary<Guid, MyCard>? Physicals { get; set; }

    /// <summary>Count changed by ±1 (location mode only).</summary>
    [Parameter] public EventCallback<(MyCard card, int delta)> OnCountChanged { get; set; }

    /// <summary>Edit requested for a location card.</summary>
    [Parameter] public EventCallback<MyCard> OnEditRequested { get; set; }

    /// <summary>Split requested for a location card — any count, including a single copy
    /// (the whole row moves deck↔sideboard).</summary>
    [Parameter] public EventCallback<MyCard> OnSplitRequested { get; set; }

    /// <summary>Total copies of each displayed card in the pinned collection (leftmost column, KB mode with a
    /// pinned target only — in deck mode the Total column shows the current deck's count instead).
    /// Null = column hidden. 0/absent → empty cell, the column keeps its fixed width.</summary>
    [Parameter] public Dictionary<Guid, int>? PinnedCounts { get; set; }

    /// <summary>The displayed collection is locked — −/+ and ✎/✂ are hidden, count shown read-only.</summary>
    [Parameter] public bool Locked { get; set; }

    /// <summary>The pinned collection is locked — KB (+) is hidden.</summary>
    [Parameter] public bool PinnedLocked { get; set; }

    /// <summary>Active sort field (internal name from CardListFilter.SortFields) — the matching header shows the indicator.</summary>
    [Parameter] public string SortField { get; set; } = "";

    /// <summary>Sort direction for the active field (true = ascending).</summary>
    [Parameter] public bool SortAsc { get; set; } = true;

    /// <summary>Sortable column header clicked — parent switches/toggles sorting by the given internal field name.</summary>
    [Parameter] public EventCallback<string> OnSortColumnClicked { get; set; }

    /// <summary>(+) pressed in KB mode — add one copy of the card to the fixed collection.</summary>
    [Parameter] public EventCallback<Card> OnKbAddRequested { get; set; }

    /// <summary>(−) pressed in KB mode — remove one copy of the card from the fixed collection.</summary>
    [Parameter] public EventCallback<Card> OnKbRemoveRequested { get; set; }

    /// <summary>Deck/location mode — physical instances are provided for every displayed card.</summary>
    private bool IsDeckMode => Physicals is not null;

    private bool HasPrev => CurrentPage > 1;
    private bool HasNext => CurrentPage < TotalPages;

    private async Task SelectCard(Card card)
    {
        await OnCardClicked.InvokeAsync(card);
    }

    // ── Column-header sorting ───────────────────────────
    private bool IsSorted(string field) => SortField == field;

    /// <summary>Indicator for the active column: ▼ ascending / ▲ descending (same semantics as the old toolbar buttons).</summary>
    private string SortIndicator(string field) =>
        !IsSorted(field) ? "" : SortAsc ? "▼" : "▲";

    private async Task SortHeader(string field) => await OnSortColumnClicked.InvokeAsync(field);

    private async Task PrevPage()
    {
        await OnPrevPage.InvokeAsync();
    }

    private async Task NextPage()
    {
        await OnNextPage.InvokeAsync();
    }

    private async Task ChangeCount(MyCard card, int delta)
    {
        await OnCountChanged.InvokeAsync((card, delta));
    }

    private async Task EditCard(MyCard card) => await OnEditRequested.InvokeAsync(card);

    private async Task SplitCard(MyCard card) => await OnSplitRequested.InvokeAsync(card);

    private async Task AddToFixed(Card card) => await OnKbAddRequested.InvokeAsync(card);

    private async Task RemoveFromFixed(Card card) => await OnKbRemoveRequested.InvokeAsync(card);

    /// <summary>Mana cost for the Cost column; double-sided cards show "front // back".</summary>
    private static string ManaCost(Card magicCard)
    {
        if (!string.IsNullOrWhiteSpace(magicCard.ManaCost))
            return magicCard.ManaCost;

        if (magicCard.CardFaces is null || magicCard.CardFaces.Length == 0)
            return string.Empty;

        var sb = new StringBuilder(magicCard.CardFaces[0].ManaCost);

        if (magicCard.CardFaces.Length > 1)
            sb.Append($" // {magicCard.CardFaces[1].ManaCost}");

        return sb.ToString();
    }

    private static string Truncate(string? text, int maxLen)
    {
        if (text == null) return "—";
        return text.Length <= maxLen ? text : text[..(maxLen - 1)] + "…";
    }

    /// <summary>Format CMC: strip trailing ".0" (e.g. "3.0" → "3", "2.5" stays "2.5").</summary>
    private static string FormatCmc(string? cmcText)
    {
        if (string.IsNullOrEmpty(cmcText))
            return "—";

        if (cmcText.EndsWith(".0"))
            return cmcText.Replace(".0", string.Empty);

        return cmcText;
    }

    private static string GetRarityClass(string? rarity)
    {
        return rarity?.ToLowerInvariant() switch
        {
            "common" => "rarity-common",
            "uncommon" => "rarity-uncommon",
            "rare" => "rarity-rare",
            "mythic" => "rarity-mythic",
            _ => ""
        };
    }
}
