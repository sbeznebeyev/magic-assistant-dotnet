@using System.Text.Json
@using MagicAssistant.Core.Commands
@using MagicAssistant.Core.Queries
@using MagicAssistant.Core.Services.CardSearch
@inject ICardSearchService CardSearch
@inject SaveUserSettingCommandHandler? SaveSettingCommandHandler
@inject GetUserSettingQueryHandler? GetSettingQueryHandler

<div class="gallery-container">
    @if (_loading)
    {
        <div class="gallery-loading">Loading cards...</div>
    }
    else if (_error != null)
    {
        <div class="gallery-error">
            <span>@_error</span>
            <button @onclick="RetryLoad">Retry</button>
        </div>
    }
    else if (_cards != null && _cards.Any())
    {
        @* ── Gallery Grid ── *@
        <div class="gallery-grid" style="grid-template-columns: repeat(auto-fill, minmax(@(_cardSize)px, 1fr));">
            @foreach (var card in _displayCards)
            {
                var isDoubleSided = card.Has2Faces;
                var cardKey = card.Id.ToString();
                var showBack = _sideState.GetValueOrDefault<string, bool>(cardKey);
                <div class="gallery-card@(isDoubleSided ? " gallery-card-side-" + (showBack ? "back" : "front") : "")"
                     @onclick="@(() => SelectCard(card, cardKey))">
                    <div class="gallery-image-wrap">
                        @* ── Tabs area (always present for alignment) ── *@
                        <div class="gallery-tabs-area">
                            @if (isDoubleSided)
                            {
                                <button type="button"
                                        class="tab-btn tab-front @(showBack ? "inactive" : "active")"
                                        @onclick:stopPropagation
                                        @onclick="@(() => ToggleSide(card, false))">front</button>
                                <button type="button"
                                        class="tab-btn tab-back @(showBack ? "active" : "inactive")"
                                        @onclick:stopPropagation
                                        @onclick="@(() => ToggleSide(card, true))">back</button>
                            }
                        </div>
                        @{
                            var imgUrl = ImageHelper.GetImageUrl(card, !showBack);
                        }
                        @if (!string.IsNullOrEmpty(imgUrl))
                        {
                            <img src="@imgUrl" alt="@card.Name" class="gallery-image" loading="lazy" />
                        }
                        else
                        {
                            <div class="gallery-placeholder">
                                <span class="placeholder-icon">🃏</span>
                                <span class="placeholder-cmc">@card.CmcText</span>
                            </div>
                        }
                    </div>
                    <div class="gallery-card-info">
                        <div class="gallery-card-name" title="@card.Name">@Truncate(card.Name, 20)</div>
                        <div class="gallery-card-meta">
                            @if (!string.IsNullOrEmpty(card.SetCode))
                            {
                                <span class="meta-set">@card.SetCode</span>
                            }
                            @if (!string.IsNullOrEmpty(card.Rarity))
                            {
                                <span class="rarity-badge @(GetRarityClass(card.Rarity))">@card.Rarity[0]</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* ── Pagination + Size Slider ── *@
        <div class="gallery-pagination">
            <div class="size-slider-group">
                <button type="button" class="slider-arrow" @onclick="() => PageSizeStep(-1)">◀</button>
                <span>Page size: </span><span class="size-value">@_pageSize</span>
                <button type="button" class="slider-arrow" @onclick="() => PageSizeStep(1)">▶</button>
            </div>
            <div class="pagination-buttons">
                <button @onclick="PrevPage" disabled="@(!_hasPrev)" class="page-btn">← Prev</button>
                <span class="page-info">Page @_currentPage / @_totalPages</span>
                <button @onclick="NextPage" disabled="@(!_hasNext)" class="page-btn">Next →</button>
            </div>
            <div class="size-slider-group">
                <button type="button" class="slider-arrow" @onclick="() => CardSizeStep(-25)">◀</button>
                <span>Scale: </span><span class="size-value">@_cardSize px</span>
                <button type="button" class="slider-arrow" @onclick="() => CardSizeStep(25)">▶</button>
            </div>
        </div>
    }
    else
    {
        <div class="gallery-empty">
            No cards to display.<br />
            Sync sets from Scryfall to build your gallery.
        </div>
    }
</div>

@code {
    /// Состояние front/back для каждой карты: true = back, false/missing = front
    private Dictionary<string, bool> _sideState = new();

    private ICollection<MagicCard>? _cards;
    private List<MagicCard> _displayCards = new();
    private bool _loading;
    private string? _error;
    private Guid? _selectedCardId;

    // Gallery settings
    private int _cardSize = 150; // minmax base for grid columns (px)
    private int _pageSize = 20;  // cards per page

    // Settings persistence
    private const string PageSizeSettingKey = "KBCardsGalleryControl.PageSize";
    private const string CardSizeSettingKey = "KBCardsGalleryControl.CardSize";

    // Pagination
    private int _currentPage = 1;

    [Parameter] public EventCallback<MagicCard> OnCardClicked { get; set; }
    [Parameter] public EventCallback<(Guid cardId, bool showBack)> OnCardSideChanged { get; set; }
    [Parameter] public Guid? SelectedCardId { get; set; }

    private async Task SelectCard(MagicCard card, string cardKey)
    {
        var showBack = _sideState.GetValueOrDefault<string, bool>(cardKey);
        await OnCardClicked.InvokeAsync(card);
        await OnCardSideChanged.InvokeAsync((card.Id, showBack));
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadSettingsAsync();
        await LoadCards();
    }

    protected override void OnParametersSet()
    {
        _selectedCardId = SelectedCardId;
    }

    private async Task ToggleSide(MagicCard card, bool showBack)
    {
        var cardKey = card.Id.ToString();
        if (_sideState.TryGetValue(cardKey, out var current) && current == showBack)
        {
            return; // уже активна
        }
        _sideState[cardKey] = showBack;
        // Клик по вкладке = выбор карты + уведомление о стороне
        await OnCardClicked.InvokeAsync(card);
        await OnCardSideChanged.InvokeAsync((card.Id, showBack));
    }

    private void OnCardSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newSize))
        {
            _cardSize = newSize;
        }
        ResetToFirstPage();
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newSize) && newSize >= 1 && newSize <= 150)
        {
            _pageSize = newSize;
        }
        ResetToFirstPage();
    }

    private async Task PageSizeStep(int delta)
    {
        _pageSize = Math.Clamp(_pageSize + delta, 1, 150);
        await SaveSettingsAsync();
        ResetToFirstPage();
    }

    private async Task CardSizeStep(int delta)
    {
        _cardSize = Math.Clamp(_cardSize + delta, 100, 350);
        await SaveSettingsAsync();
        ResetToFirstPage();
    }

    private void ResetToFirstPage()
    {
        _currentPage = 1;
        ApplyPagination();
        StateHasChanged();
    }

    private async Task LoadCards()
    {
        _loading = true;
        _error = null;
        try
        {
            // Load up to 500 cards (gallery limit — user can paginate)
            var allCards = await CardSearch.GetAllAsync(500);
            _cards = allCards;
            ApplyPagination();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyPagination()
    {
        if (_cards == null || !_cards.Any())
        {
            _displayCards = new List<MagicCard>();
            _totalPages = 0;
            return;
        }

        var total = _cards.Count;
        _totalPages = (int)Math.Ceiling((double)total / _pageSize);
        if (_currentPage > _totalPages) _currentPage = _totalPages;

        var skip = (_currentPage - 1) * _pageSize;
        _displayCards = _cards.Skip(skip).Take(_pageSize).ToList();
    }

    private bool _hasPrev => _currentPage > 1;
    private bool _hasNext => _currentPage < _totalPages;
    private int _totalPages = 0;



    private void NextPage()
    {
        if (_hasNext)
        {
            _currentPage++;
            ApplyPagination();
            StateHasChanged();
        }
    }

    private void PrevPage()
    {
        if (_hasPrev)
        {
            _currentPage--;
            ApplyPagination();
            StateHasChanged();
        }
    }

    private async Task RetryLoad()
    {
        await LoadCards();
        StateHasChanged();
    }

    private static string Truncate(string text, int maxLen)
    {
        return text.Length <= maxLen ? text : text[..(maxLen - 1)] + "…";
    }

    private static string GetRarityClass(string? rarity)
    {
        return rarity?.ToLowerInvariant() switch
        {
            "common" => "rarity-common",
            "uncommon" => "rarity-uncommon",
            "rare" => "rarity-rare",
            "mythic" => "rarity-mythic",
            _ => ""
        };
    }

    // ── Settings Persistence ───────────────────────────────

    private async Task LoadSettingsAsync()
    {
        if (GetSettingQueryHandler is null) return;

        try
        {
            var pageSizeJson = await GetSettingQueryHandler.Handle(new GetUserSettingQuery(PageSizeSettingKey));
            if (!string.IsNullOrEmpty(pageSizeJson) && int.TryParse(pageSizeJson, out var ps))
            {
                _pageSize = Math.Clamp(ps, 1, 150);
            }
        }
        catch
        {
            // default _pageSize = 20
        }

        try
        {
            var cardSizeJson = await GetSettingQueryHandler.Handle(new GetUserSettingQuery(CardSizeSettingKey));
            if (!string.IsNullOrEmpty(cardSizeJson) && int.TryParse(cardSizeJson, out var cs))
            {
                _cardSize = Math.Clamp(cs, 100, 350);
            }
        }
        catch
        {
            // default _cardSize = 150
        }
    }

    private async Task SaveSettingsAsync()
    {
        if (SaveSettingCommandHandler is null) return;

        try
        {
            await SaveSettingCommandHandler.Handle(new SaveUserSettingCommand(PageSizeSettingKey, _pageSize.ToString()));
        }
        catch
        {
            // silently fail — settings are not critical
        }

        try
        {
            await SaveSettingCommandHandler.Handle(new SaveUserSettingCommand(CardSizeSettingKey, _cardSize.ToString()));
        }
        catch
        {
            // silently fail — settings are not critical
        }
    }
}