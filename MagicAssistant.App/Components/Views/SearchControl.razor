@*
    SearchControl — FTS5 full-text search input over the knowledge base.
    Pure controlled draft input: it never touches FilterViewModel and never re-queries.
    The owning dialog keeps the draft, commits it to FilterViewModel.SearchQuery on its
    Apply (single commit point), and receives Enter/Escape intents via callbacks.
    FTS5 syntax: "phrase", name:term, OR/AND/NOT.
*@

<div class="search-control">
    <div class="search-toolbar">
        <input value="@Value" @oninput="OnInput" @onkeydown="OnKeyDown" @onkeydown:stopPropagation
               placeholder="Search cards"
               class="search-input" />

        @if (!string.IsNullOrWhiteSpace(Value))
        {
            <button type="button" class="clear-btn" @onclick="OnClear" title="Clear search">✕</button>
        }

        <span class="syntax-hint" tabindex="0">ⓘ<span class="hint-tooltip">
            <span class="hint-title">How to search</span>
            <span class="hint-row"><code>lightning bolt</code><span>both words, any card text</span></span>
            <span class="hint-row"><code>"Lightning Bolt"</code><span>exact phrase</span></span>
            <span class="hint-row"><code>name:lightning</code><span>word in card name only</span></span>
            <span class="hint-row"><code>dragon OR angel</code><span>either word</span></span>
            <span class="hint-row"><code>dragon NOT flying</code><span>dragons without "flying"</span></span>
            <span class="hint-note">Words match by prefix (fly → flying); quotes mean exact. Searches name, type, oracle text and artist.</span>
        </span></span>
    </div>
</div>

@code {
    /// <summary>Draft text owned by the parent dialog.</summary>
    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Enter pressed — the dialog applies everything (single commit point).</summary>
    [Parameter]
    public EventCallback OnEnter { get; set; }

    private async Task OnInput(ChangeEventArgs e)
        => await ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);

    private async Task OnClear()
        => await ValueChanged.InvokeAsync(string.Empty);

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        // stopPropagation on the input: the dialog root never sees these keys —
        // Enter here means "apply everything" (parent decides), Escape clears the draft only.
        if (e.Key == "Enter")
            await OnEnter.InvokeAsync();
        else if (e.Key == "Escape")
            await ValueChanged.InvokeAsync(string.Empty);
    }
}
