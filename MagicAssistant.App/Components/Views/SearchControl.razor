@*
    SearchControl — FTS5 full-text search over the knowledge base.
    Pure input control for the FilterViewModel channel: writes SearchQuery and calls Apply().
    The re-query is performed by CardsListControl (single Changed channel, per architecture.md).
    FTS5 syntax: "phrase", name:term, OR/AND/NOT.
*@

<div class="search-control">
    <div class="search-toolbar">
        <input @bind="_searchQuery" @bind:event="oninput" @onkeydown="OnKeyDown"
               placeholder="Search cards (FTS5)..."
               class="search-input" />
        
        @if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            <button class="clear-btn" @onclick="ClearSearch" title="Clear search">✕</button>
        }

        <button class="search-btn" @onclick="ApplySearch" title="Search">🔍</button>

        <span class="syntax-hint" tabindex="0">ⓘ<span class="hint-tooltip">FTS5: "exact phrase" · name:term · term1 OR term2</span></span>
    </div>
</div>

@code {
    [Parameter]
    public FilterViewModel FilterViewModel { get; set; } = default!;

    [Parameter]
    public EventCallback<string> OnSearchCompleted { get; set; }

    private string _searchQuery = string.Empty;

    /// <summary>Push the current input into the filter channel and trigger a re-query.</summary>
    private async Task ApplySearch()
    {
        var query = _searchQuery.Trim();
        if (query.Length == 0) return;
        FilterViewModel.SearchQuery = query;
        FilterViewModel.Apply();
        await OnSearchCompleted.InvokeAsync(query);
    }

    /// <summary>Remove the FTS filter from the channel and trigger a re-query.</summary>
    private async Task ClearSearch()
    {
        _searchQuery = string.Empty;
        if (FilterViewModel.SearchQuery.Length == 0) return;
        FilterViewModel.SearchQuery = string.Empty;
        FilterViewModel.Apply();
        await OnSearchCompleted.InvokeAsync(string.Empty);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ApplySearch();
        else if (e.Key == "Escape")
            await ClearSearch();
    }
}