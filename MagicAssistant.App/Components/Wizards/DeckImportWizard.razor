@using MagicAssistant.Data.Contracts
@using MagicAssistant.Data.DbModel
@using MagicAssistant.Data.IO.json
@using MagicAssistant.Data.Model
@using MagicAssistant.Data.Model.NavigatorNodes
@inject IDeckImportExportService ImportExport
@inject ICollectionStore CollectionStore

<div class="dialog-overlay" @onclick="OnOverlayClick">
    <div class="dialog-box" @onclick:stopPropagation="true">
        @* Fixed target (⋯ context menu): the target name lives in the title — gold, same
           technology as the export wizard. Select mode keeps the generic title. *@
        <div class="dialog-title">
            @if (TargetNodeId is { })
            {
                <span>Import to </span><span class="target-name">@(_targetIsSideboard ? _targetDeckName : _targetName)</span>
                @if (_targetIsSideboard)
                {
                    <span class="target-sideboard-tag">sideboard</span>
                }
            }
            else
            {
                @:Import Deck
            }
        </div>

        @if (_importing)
        {
            <div class="dialog-loading">Importing...</div>
        }
        else
        {
            @* ── Step 1: Select File ── *@
            <div class="form-group">
                <label>JSON File</label>
                <InputFile id="deck-import-file" OnChange="OnFileSelected" accept=".json" class="file-input-hidden" />
                <label for="deck-import-file" class="file-btn">Choose JSON File</label>
                @if (_fileName != null)
                {
                    <input type="text" @bind="FileName" @bind:event="oninput" class="dialog-input file-name-input" />
                }
            </div>

            @* ── Step 2: Target Deck — select mode only. In fixed-target mode the name is in the title, *@
            @* so a bottom group would duplicate it. *@
            @if (TargetNodeId is not { })
            {
                <div class="form-group">
                    <label>Import to</label>
                    <select @bind="_importMode" class="dialog-select">
                        <option value="new">New deck (creates from file name)</option>
                        @foreach (var d in _existingDecks)
                        {
                            <option value="@d.Id">@d.Name (add to existing)</option>
                        }
                    </select>
                </div>
            }

            @if (TargetNodeId is not { } && _importMode == "new")
            {
                <div class="form-group">
                    <label>Deck Name</label>
                    <input type="text" @bind="_deckName" @bind:event="oninput" class="dialog-input" />
                </div>
            }

            @if (TargetNodeId is not { } && !string.IsNullOrEmpty(_parentName))
            {
                <div class="form-hint">New deck will be created inside "<strong>@_parentName</strong>".</div>
            }

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="dialog-error">@_error</div>
            }

            <div class="dialog-actions">
                <button class="btn-primary" @onclick="OnImport"
                        disabled="@(_fileName == null)">
                    Import
                </button>
                <button class="btn-secondary" @onclick="Close">Cancel</button>
            </div>
        }
    </div>
</div>

@code {
    private string? _fileName;
    /// <summary>Editable file name; spaces are replaced with underscores live.</summary>
    public string? FileName
    {
        get => _fileName;
        set => _fileName = value?.Replace(' ', '_');
    }
    private byte[]? _fileContent;
    private string _deckName = "";
    private string _importMode = "new";
    private bool _importing;
    private string? _error;
    /// <summary>Merge targets: every deck/collection at any depth (Id, Name).</summary>
    private List<(int Id, string Name)> _existingDecks = new();
    private string? _parentName;
    /// <summary>Name of the fixed import target (TargetNodeId) for the "merge into existing" line.</summary>
    private string? _targetName;
    /// <summary>True when TargetNodeId points at a Sideboard node — the dialog must say so explicitly.</summary>
    private bool _targetIsSideboard;
    /// <summary>Name of the deck owning the sideboard (for the target line).</summary>
    private string? _targetDeckName;

    [Parameter] public bool IsOpen { get; set; }
    /// <summary>Parent node the add-node menu was opened under (null = root) — "new deck" is created inside it.</summary>
    [Parameter] public int? ParentNodeId { get; set; }
    /// <summary>Existing CollectionId to merge cards INTO (⋯ context menu — Import / Import sideboard).
    /// When set, the target select is hidden and cards are added to this node instead of a new deck.</summary>
    [Parameter] public int? TargetNodeId { get; set; }
    [Parameter] public EventCallback OnImported { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen)
        {
            _fileName = null;
            _fileContent = null;
            _deckName = "";
            _importMode = "new";
            _error = null;
            _importing = false;

            try
            {
                // Resolve names directly from the DB: the navigation tree dictionary only
                // contains root-level nodes, so nested decks and sideboards would show as "?".
                var all = await CollectionStore.GetAllCollectionsAsync();
                _existingDecks = all.Where(c => c.NodeType is NodeType.Collection or NodeType.Deck)
                                    .Select(c => (c.Id, c.Name))
                                    .ToList();

                if (ParentNodeId is { } parentId)
                    _parentName = (await CollectionStore.GetByIdAsync(parentId))?.Name;

                if (TargetNodeId is { } targetId)
                {
                    var target = await CollectionStore.GetByIdAsync(targetId);
                    _targetName = target?.Name ?? "?";
                    if (target?.NodeType == NodeType.Sideboard)
                    {
                        _targetIsSideboard = true;
                        _targetDeckName = target.ParentId is { } deckId
                            ? (await CollectionStore.GetByIdAsync(deckId))?.Name ?? "?"
                            : "?";
                    }
                }
            }
            catch { }
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        var content = new byte[file.Size];
        await file.OpenReadStream().ReadExactlyAsync(content);

        // Parse early: reject invalid files up front and take the default deck name from the file.
        try
        {
            var parsed = JsonImport.ImportFromJson(System.Text.Encoding.UTF8.GetString(content));
            if (parsed.Cards.Count == 0)
                throw new InvalidOperationException("No cards found in the file.");

            _fileContent = content;
            FileName = file.Name;   // spaces → underscores
            _deckName = parsed.Name;
        }
        catch (Exception ex) when (ex is FormatException or InvalidOperationException)
        {
            _fileName = null;
            _fileContent = null;
            _error = $"Invalid file: {ex.Message}";
        }
    }

    private async Task OnImport()
    {
        if (_fileContent == null || _fileName == null) return;

        _importing = true;
        _error = null;

        try
        {
            var jsonContent = System.Text.Encoding.UTF8.GetString(_fileContent);
            var targetId = _importMode == "new" ? (int?)null : int.Parse(_importMode);
            if (TargetNodeId is { } fixedTarget) targetId = fixedTarget;  // ⋯ menu — fixed CollectionId wins

            // New-node mode: the name must be unique across the whole tree.
            // Duplicates are allowed only for Folder nodes; Sideboards are hidden DB children, not tree nodes.
            string? deckName = null;
            if (targetId == null)
            {
                deckName = _deckName.Trim();
                if (deckName.Length == 0)
                    throw new InvalidOperationException("Deck name cannot be empty.");

                var allNodes = await CollectionStore.GetAllCollectionsAsync();
                if (allNodes.Any(n => n.NodeType is NodeType.Collection or NodeType.Deck
                                      && string.Equals(n.Name, deckName, StringComparison.OrdinalIgnoreCase)))
                    throw new InvalidOperationException(
                        $"A node named \"{deckName}\" already exists in the tree. Please choose a different name.");
            }

            // Atomic commit via the import domain module:
            // parse JSON → validate every card against KB → create node + persist in one transaction.
            // Nothing is created when validation fails.
            await ImportExport.CommitModernImportAsync(jsonContent, ParentNodeId, targetId, deckName);

            await OnImported.InvokeAsync();

            // Close the dialog after a successful import
            IsOpen = false;
            await IsOpenChanged.InvokeAsync(false);
        }
        catch (Exception ex)
        {
            _error = $"Import failed: {ex.Message}";
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task OnCancel()
    {
        if (_importing) return;
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private void OnOverlayClick() => _ = OnCancel();
    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

}
