@using MagicAssistant.Core.Commands
@using MagicAssistant.Core.Queries
@using MagicAssistant.Data.Contracts
@using MagicAssistant.Data.IO.json
@using MagicAssistant.Data.Model
@using MagicAssistant.Data.Model.NavigatorNodes
@inject IDeckImportExportService ImportExport
@inject ICollectionStore CollectionStore
@inject GetSyncProgressQueryHandler SyncProgressQuery
@inject GetUserSettingQueryHandler GetSettingQueryHandler
@inject SaveUserSettingCommandHandler SaveSettingCommandHandler

<div class="dialog-overlay">
    <div class="dialog-box" @onclick:stopPropagation="true">
        @* Fixed target (⋯ context menu): the target name lives in the title — gold, same
           technology as the export wizard. Select mode keeps the generic title. *@
        <div class="dialog-title">
            @if (TargetNodeId is { })
            {
                <span>Import to </span><span class="target-name">@(_targetName)</span>
            }
            else
            {
                @:Import Deck
            }
        </div>

        @switch (_state)
        {
            case WizardState.FileSelection:
                @* ── Step 1: Select File ── *@
                <div class="form-group">
                    <InputFile id="deck-import-file" OnChange="OnFileSelected" accept=".json" class="file-input-hidden" />
                    <label for="deck-import-file" class="file-btn">Choose JSON File</label>
                    @if (_fileName != null)
                    {
                        <div class="file-selected">✓ @_fileName</div>
                    }
                </div>

                @* ── Step 2: Target Deck — select mode only. In fixed-target mode the name is in the title, *@
                @* so a bottom group would duplicate it. *@
                @if (TargetNodeId is not { })
                {
                    <div class="form-group">
                        <label>Import to</label>
                        <select @bind="_importMode" class="dialog-select">
                            <option value="new">New deck (creates from file name)</option>
                            @foreach (var d in _existingDecks)
                            {
                                <option value="@d.Id">@d.Name (add to existing)</option>
                            }
                        </select>
                    </div>
                }

                @if (TargetNodeId is not { } && _importMode == "new")
                {
                    <div class="form-group">
                        <label>Deck Name</label>
                        <input type="text" @bind="_deckName" @bind:event="oninput" class="dialog-input" />
                    </div>
                }

                @if (TargetNodeId is not { } && !string.IsNullOrEmpty(_parentName))
                {
                    <div class="form-hint">New deck will be created inside "<strong>@_parentName</strong>".</div>
                }

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="dialog-error">@_error</div>
                }

                <div class="dialog-actions">
                    <button class="btn-primary" @onclick="OnImport"
                            disabled="@(_fileName == null)">
                        Import
                    </button>
                    <button class="btn-secondary" @onclick="Close">Cancel</button>
                </div>
                break;

            case WizardState.Checking:
                <div class="dialog-loading">Checking sets...</div>
                break;

            case WizardState.SetPrompt:
                <div class="missing-sets-header">Some sets are not in the knowledge base yet:</div>
                <ul class="missing-set-list">
                    @foreach (var s in _check!.MissingSets)
                    {
                        <li><strong>@s.Name</strong> <span class="set-code">@s.Code</span> — @s.CardsInFile card(s) in file</li>
                    }
                </ul>

                @if (_check.UnknownCardCount > 0)
                {
                    <div class="unknown-cards-hint">
                        @_check.UnknownCardCount card(s) not found in the knowledge base — they will be resolved by the sync.
                    </div>
                }

                <div class="form-group language-group">
                    <label>Card languages</label>
                    <div class="language-toggles">
                        @foreach (var lang in AllLanguages)
                        {
                            <button type="button"
                                    class="lang-toggle @(_languages.Contains(lang) ? "active" : "")"
                                    @onclick="() => ToggleLanguage(lang)">
                                @lang
                            </button>
                        }
                    </div>
                </div>

                <div class="form-group">
                    <label class="check-label">
                        <input type="checkbox" @bind="_downloadImages" />
                        Download card images (slower)
                    </label>
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="dialog-error">@_error</div>
                }

                <div class="dialog-actions">
                    <button class="btn-primary" @onclick="OnSyncAndContinue" disabled="@(_languages.Length == 0)">
                        Download &amp; Import
                    </button>
                    <button class="btn-secondary" @onclick="() => _state = WizardState.FileSelection">Back</button>
                </div>
                break;

            case WizardState.Syncing:
                <div class="sync-progress-section">
                    <div class="progress-set-name">
                        @(_currentSyncSetCode ?? "Starting...")
                        @if (_syncTotal > 1)
                        {
                            <span class="sync-count">@(_syncIndex >= 0 ? $" — set {_syncIndex + 1} of {_syncTotal}" : "")</span>
                        }
                    </div>

                    @if (_syncProgress != null)
                    {
                        <div class="phase-indicator">
                            <span class="phase-message">@_syncProgress.Message</span>
                        </div>

                        <div class="progress-bar-wrap">
                            <div class="progress-bar" style="width: @_syncProgress.ProgressPercent%"></div>
                        </div>

                        <div class="progress-stats">
                            <span>Cards: @_syncProgress.ReadyCardsToSave / @_syncProgress.TotalCards</span>
                            @if (_downloadImages)
                            {
                                <span>Images: @_syncProgress.ImagesDownloaded</span>
                                @if (_syncProgress.ImagesFailed > 0)
                                {
                                    <span class="fail">(@_syncProgress.ImagesFailed failed)</span>
                                }
                            }
                        </div>
                    }

                    <button class="cancel-btn" @onclick="CancelSync">Cancel</button>
                </div>
                break;

            case WizardState.Committing:
                <div class="dialog-loading">Importing...</div>
                break;
        }
    </div>
</div>

@code {
    private enum WizardState
    {
        FileSelection,
        Checking,
        SetPrompt,
        Syncing,
        Committing
    }

    private static readonly string[] AllLanguages = ["en", "ru", "es", "fr", "de", "it", "pt", "ja", "ko", "zhs", "zht"];
    private const string LanguagesSettingKey = "SyncKnowledgeBase.Languages";

    // ── State ────────────────────────────────────────────
    private WizardState _state = WizardState.FileSelection;
    /// <summary>Selected file name (display-only); spaces are replaced with underscores.</summary>
    private string? _fileName;
    private byte[]? _fileContent;
    private string _deckName = "";
    private string _importMode = "new";
    private string? _error;
    /// <summary>Merge targets: every deck/collection at any depth (Id, Name).</summary>
    private List<(int Id, string Name)> _existingDecks = new();
    private string? _parentName;
    /// <summary>Name of the fixed import target (TargetNodeId) for the "merge into existing" line.</summary>
    private string? _targetName;

    // ── Set sync (missing sets) ──────────────────────────
    private ModernImportCheckResult? _check;
    private string[] _languages = ["en"];
    private bool _downloadImages;
    private CancellationTokenSource? _cts;
    private int _syncIndex = -1;
    private int _syncTotal;
    private string? _currentSyncSetCode;
    private SyncProgressResponse? _syncProgress;

    [Parameter] public bool IsOpen { get; set; }
    /// <summary>Parent node the add-node menu was opened under (null = root) — "new deck" is created inside it.</summary>
    [Parameter] public int? ParentNodeId { get; set; }
    /// <summary>Existing CollectionId to merge cards INTO (⋯ context menu — Import; deck/collection nodes only).
    /// When set, the target select is hidden and cards are added to this node instead of a new deck.
    /// For a deck target the file's sideboard array merges into its sideboard child;
    /// for a Collection it is silently ignored (only the main cards are imported).</summary>
    [Parameter] public int? TargetNodeId { get; set; }
    [Parameter] public EventCallback OnImported { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen)
        {
            ResetState();

            try
            {
                // Resolve names directly from the DB: the navigation tree dictionary only
                // contains root-level nodes, so nested decks would show as "?".
                var all = await CollectionStore.GetAllCollectionsAsync();
                _existingDecks = all.Where(c => c.NodeType is NodeType.Collection or NodeType.Deck)
                                    .Select(c => (c.Id, c.Name))
                                    .ToList();

                if (ParentNodeId is { } parentId)
                    _parentName = (await CollectionStore.GetByIdAsync(parentId))?.Name;

                if (TargetNodeId is { } targetId)
                    _targetName = (await CollectionStore.GetByIdAsync(targetId))?.Name ?? "?";
            }
            catch { }

            await LoadLanguagesAsync();
        }
    }

    private void ResetState()
    {
        _state = WizardState.FileSelection;
        _fileName = null;
        _fileContent = null;
        _deckName = "";
        _importMode = "new";
        _error = null;
        _check = null;
        _cts?.Dispose();
        _cts = null;
        _syncIndex = -1;
        _syncTotal = 0;
        _currentSyncSetCode = null;
        _syncProgress = null;
    }

    // ── Languages (shared with SyncCards settings) ──

    private void ToggleLanguage(string lang)
    {
        _languages = _languages.Contains(lang)
            ? _languages.Where(l => l != lang).ToArray()
            : _languages.Append(lang).ToArray();
    }

    private async Task LoadLanguagesAsync()
    {
        try
        {
            var json = await GetSettingQueryHandler.Handle(new GetUserSettingQuery(LanguagesSettingKey));
            if (!string.IsNullOrEmpty(json))
                _languages = System.Text.Json.JsonSerializer.Deserialize<string[]>(json) ?? ["en"];
        }
        catch { _languages = ["en"]; }
    }

    private async Task SaveLanguagesAsync()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(_languages);
            await SaveSettingCommandHandler.Handle(new SaveUserSettingCommand(LanguagesSettingKey, json));
        }
        catch { /* settings are optional */ }
    }

    // ── File selection ───────────────────────────────────

    /// <summary>Upload ceiling for deck files. Blazor's default is 512 KB — anything larger
    /// threw past this handler and left the wizard without content (see OldDeckImportWizard's
    /// "0x00, line 1, position 1" incident for the silent-failure shape).</summary>
    private const long MaxImportFileBytes = 25 * 1024 * 1024;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        // Read first, parse second: the size-limit exception is a read failure, not an
        // "invalid file", and gets its own message.
        byte[] content;
        try
        {
            content = new byte[file.Size];
            await file.OpenReadStream(MaxImportFileBytes).ReadExactlyAsync(content);
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException)
        {
            _fileName = null;
            _fileContent = null;
            _error = $"Could not read \"{file.Name}\": {ex.Message}";
            return;
        }

        // Parse early: reject invalid files up front and take the default deck name from the file.
        try
        {
            var parsed = JsonImport.ImportFromJson(System.Text.Encoding.UTF8.GetString(content));
            if (parsed.Cards.Count == 0)
                throw new InvalidOperationException("No cards found in the file.");

            _fileContent = content;
            _fileName = file.Name.Replace(' ', '_');
            _deckName = parsed.Name;
        }
        catch (Exception ex) when (ex is FormatException or InvalidOperationException)
        {
            _fileName = null;
            _fileContent = null;
            _error = $"Invalid file: {ex.Message}";
        }
    }

    // ── Flow: check → (sync) → commit ────────────────────

    private async Task OnImport()
    {
        if (_fileContent == null || _fileName == null) return;

        _error = null;
        _state = WizardState.Checking;

        try
        {
            var jsonContent = System.Text.Encoding.UTF8.GetString(_fileContent);
            _check = await ImportExport.CheckModernImportAsync(jsonContent);

            if (_check.MissingSets.Count > 0)
            {
                _state = WizardState.SetPrompt;
            }
            else
            {
                // Fast path: every set is in the KB — commit directly.
                await DoCommitAsync();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _state = WizardState.FileSelection;
        }
    }

    private async Task OnSyncAndContinue()
    {
        if (_languages.Length == 0)
        {
            _error = "Select at least one language";
            return;
        }

        await SaveLanguagesAsync();
        _error = null;
        _state = WizardState.Syncing;
        _syncIndex = -1;
        _syncTotal = _check!.MissingSets.Count;
        _currentSyncSetCode = null;
        _syncProgress = null;

        _cts = new CancellationTokenSource();
        var progress = new Progress<SetSyncProgress>(p =>
        {
            _syncIndex = p.Index;
            _currentSyncSetCode = p.SetCode;
        });

        var codes = _check.MissingSets.Select(m => m.Code).ToArray();
        var syncTask = ImportExport.SyncMissingSetsAsync(codes, _languages, _downloadImages, progress, _cts.Token);

        // Poll per-set progress while the sequential sync runs
        try
        {
            while (!syncTask.IsCompleted)
            {
                await Task.Delay(500);
                if (_currentSyncSetCode != null)
                    _syncProgress = SyncProgressQuery.Handle(new GetSyncProgressQuery(_currentSyncSetCode));
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) { /* cancelled — handled below */ }

        try
        {
            await syncTask;
        }
        catch (OperationCanceledException)
        {
            _error = "Sync cancelled. Nothing was imported.";
            _state = WizardState.FileSelection;
            return;
        }
        catch (Exception ex)
        {
            _error = $"Set sync failed: {ex.Message}";
            _state = WizardState.FileSelection;
            return;
        }

        // Sync succeeded — commit. CommitModernImportAsync re-validates every card ID, so
        // cards still unknown after the sync surface as a normal import error here.
        try
        {
            await DoCommitAsync();
        }
        catch (Exception ex)
        {
            _error = $"Import failed: {ex.Message}";
            _state = WizardState.FileSelection;
        }
    }

    private void CancelSync() => _cts?.Cancel();

    /// <summary>
    /// Atomic commit via the import domain module: parse JSON → validate every card against
    /// KB → create node + persist in one transaction. Nothing is created when validation fails.
    /// </summary>
    private async Task DoCommitAsync()
    {
        var jsonContent = System.Text.Encoding.UTF8.GetString(_fileContent!);
        var targetId = _importMode == "new" ? (int?)null : int.Parse(_importMode);
        if (TargetNodeId is { } fixedTarget) targetId = fixedTarget;  // ⋯ menu — fixed CollectionId wins

        // New-node mode: the name must be unique across the whole tree.
        // Duplicates are allowed only for Folder nodes; Sideboards are hidden DB children, not tree nodes.
        string? deckName = null;
        if (targetId == null)
        {
            deckName = _deckName.Trim();
            if (deckName.Length == 0)
                throw new InvalidOperationException("Deck name cannot be empty.");

            var allNodes = await CollectionStore.GetAllCollectionsAsync();
            if (allNodes.Any(n => n.NodeType is NodeType.Collection or NodeType.Deck
                                  && string.Equals(n.Name, deckName, StringComparison.OrdinalIgnoreCase)))
                throw new InvalidOperationException(
                    $"A node named \"{deckName}\" already exists in the tree. Please choose a different name.");
        }

        _state = WizardState.Committing;
        await ImportExport.CommitModernImportAsync(jsonContent, ParentNodeId, targetId, deckName);

        await OnImported.InvokeAsync();

        // Close the dialog after a successful import
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task Close()
    {
        _cts?.Cancel();
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
