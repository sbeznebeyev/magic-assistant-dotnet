@* Routes.razor — routing component for Blazor Web App *@

<Router AppAssembly="@typeof(Routes).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(Shared.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not Found — Magic Assistant</PageTitle>
        <LayoutView Layout="@typeof(Shared.MainLayout)">
            <div class="not-found">
                <h1>404 — Page Not Found</h1>
                <p>The page you're looking for doesn't exist or has been moved.</p>
                <a href="/" class="btn btn-primary">Go to Home</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
