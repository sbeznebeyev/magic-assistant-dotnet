using Bunit;
using MagicAssistant.App.Components.Dialogs;
using Microsoft.AspNetCore.Components;

namespace MagicAssistant.Tests.UI;

/// <summary>
/// Tests for EditMagicCardPhysicalDialog — edits physical card instance properties.
/// </summary>
[TestFixture]
public class EditMagicCardPhysicalDialogTests : BaseUiTest
{
    private static MagicCardPhysical CreateFullCard() => new(
        new MagicCard { Id = Guid.NewGuid(), Name = "Test Card", ManaCost = "{W}", SetCode = "m19" },
        Location.FromPath("deck1"), true)
    { Count = 3, IsOwn = true, Price = 15.50f, Comment = "My note", SpecialTags = "foil, premium" };

    [Test]
    public void NotVisible_RendersNothing()
    {
        var cut = Ctx.Render<EditMagicCardPhysicalDialog>(p => p.Add(d => d.IsOpen, false));
        Assert.That(cut.Markup, Does.Not.Contain("edit-dialog-overlay"));
    }

    [Test]
    public void Loads_AllFields_FromCard()
    {
        var card = CreateFullCard();
        var cut = Ctx.Render<EditMagicCardPhysicalDialog>(p =>
        {
            p.Add(d => d.IsOpen, true);
            p.Add(d => d.Card, card);
            p.Add(d => d.DeckId, "deck1");
        });

        Assert.That(cut.Markup, Does.Contain("Test Card"));
        Assert.That(cut.Find(".form-input-sm").GetAttribute("value"), Is.EqualTo("3"));
    }

    [Test]
    public async Task ClickSave_CallsUpdateCardAsync()
    {
        var card = CreateFullCard();
        DeckCard.Setup(s => s.UpdateCardAsync("deck1", card.Id, It.IsAny<Dictionary<MagicCardField, object?>>(), It.IsAny<CancellationToken>()))
            .ReturnsAsync(true);

        bool saved = false;
        var cut = Ctx.Render<EditMagicCardPhysicalDialog>(p =>
        {
            p.Add(d => d.IsOpen, true);
            p.Add(d => d.Card, card);
            p.Add(d => d.DeckId, "deck1");
            p.Add(d => d.OnSaved, EventCallback.Factory.Create<MagicCardPhysical?>(new object(), _ => saved = true));
        });

        cut.Find(".btn-save").Click();
        await Task.Yield();

        DeckCard.Verify(s => s.UpdateCardAsync("deck1", card.Id,
            It.Is<Dictionary<MagicCardField, object?>>((d) => d.ContainsKey(MagicCardField.Count)),
            It.IsAny<CancellationToken>()), Times.Once());
        Assert.That(saved, Is.True);
    }

    [Test]
    public async Task SaveFailure_DisplaysErrorMessage()
    {
        var card = CreateFullCard();
        DeckCard.Setup(s => s.UpdateCardAsync("deck1", card.Id, It.IsAny<Dictionary<MagicCardField, object?>>(), It.IsAny<CancellationToken>()))
            .ReturnsAsync(false);

        var cut = Ctx.Render<EditMagicCardPhysicalDialog>(p =>
        {
            p.Add(d => d.IsOpen, true);
            p.Add(d => d.Card, card);
            p.Add(d => d.DeckId, "deck1");
        });

        cut.Find(".btn-save").Click();
        await Task.Yield();

        Assert.That(cut.Markup, Does.Contain("edit-error"));
        Assert.That(cut.Markup, Does.Contain("Failed to update card"));
    }

    [Test]
    public async Task ClickCancel_FiresIsOpenChanged()
    {
        var card = CreateFullCard();
        bool cancelled = false;
        var cut = Ctx.Render<EditMagicCardPhysicalDialog>(p =>
        {
            p.Add(d => d.IsOpen, true);
            p.Add(d => d.Card, card);
            p.Add(d => d.DeckId, "deck1");
            p.Add(d => d.IsOpenChanged, EventCallback.Factory.Create<bool>(new object(), _ => cancelled = true));
        });

        cut.Find(".btn-cancel").Click();
        await Task.Yield();
        Assert.That(cancelled, Is.True);
    }

    [Test]
    public async Task OverlayClick_FiresIsOpenChanged()
    {
        var card = CreateFullCard();
        bool cancelled = false;
        var cut = Ctx.Render<EditMagicCardPhysicalDialog>(p =>
        {
            p.Add(d => d.IsOpen, true);
            p.Add(d => d.Card, card);
            p.Add(d => d.DeckId, "deck1");
            p.Add(d => d.IsOpenChanged, EventCallback.Factory.Create<bool>(new object(), _ => cancelled = true));
        });

        cut.Find(".edit-dialog-overlay").Click();
        await Task.Yield();
        Assert.That(cancelled, Is.True);
    }
}
