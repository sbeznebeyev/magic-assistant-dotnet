using Bunit;
using MagicAssistant.App.Components.Views;

namespace MagicAssistant.Tests.UI;

/// <summary>
/// Tests for CardDescView — the right panel card details display.
/// </summary>
[TestFixture]
public class CardDescViewTests : BaseUiTest
{
    private static MagicCard CreateFullCard()
    {
        var card = new MagicCard
        {
            Id = Guid.NewGuid(), Name = "Lightning Bolt", ManaCost = "{R}", Type = "Instant",
            OracleText = "Lightning Bolt deals 3 damage to target creature or player.",
            SetCode = "M19", CollectorNumber = "75", Artist = "Daarken", Language = "en",
            Rarity = "common", Cmc = "1",
            Rulings = "2018-08-03: This card deals damage, not prevents it.",
        };
        card.LegalityMap = LegalityMap.CreateFromLegal(Format.Standard, Format.Modern, Format.Legacy);
        return card;
    }

    [Test]
    public void NoCardId_ShowsSelectionHint()
    {
        var cut = Ctx.Render<CardDescView>();
        Assert.That(cut.Markup, Does.Contain("Select a card to see details"));
    }

    [Test]
    public async Task Renders_AllCardFields_ForFullCard()
    {
        var card = CreateFullCard();
        CardSearch.Setup(s => s.GetCardByIdAsync(card.Id, It.IsAny<CancellationToken>())).ReturnsAsync(card);

        var cut = Ctx.Render<CardDescView>(p => p.Add(c => c.CardId, card.Id));
        await Task.Yield();

        Assert.That(cut.Markup, Does.Contain("Lightning Bolt"));
        Assert.That(cut.Markup, Does.Contain("{R}"));
        Assert.That(cut.Markup, Does.Contain("Instant"));
        Assert.That(cut.Markup, Does.Contain("deals 3 damage"));
        Assert.That(cut.Markup, Does.Contain("M19"));
        Assert.That(cut.Markup, Does.Contain("75"));
        Assert.That(cut.Markup, Does.Contain("Daarken"));
    }

    [Test]
    public async Task PowerToughness_Shown_OnlyForCreatures()
    {
        var creature = new MagicCard
        {
            Id = Guid.NewGuid(), Name = "Knight", Type = "Creature — Human Knight",
            Power = "2", Toughness = "3", SetCode = "m19"
        };

        CardSearch.Setup(s => s.GetCardByIdAsync(creature.Id, It.IsAny<CancellationToken>())).ReturnsAsync(creature);

        var cut = Ctx.Render<CardDescView>(p => p.Add(c => c.CardId, creature.Id));
        await Task.Yield();

        Assert.That(cut.Markup, Does.Contain("P/T"));
        Assert.That(cut.Markup, Does.Contain("2 / 3"));
    }

    [Test]
    public async Task NonExistentCard_ShowsNotFoundMessage()
    {
        var nonExistentId = Guid.NewGuid();
        CardSearch.Setup(s => s.GetCardByIdAsync(nonExistentId, It.IsAny<CancellationToken>()))
            .ReturnsAsync((MagicCard?)null);

        var cut = Ctx.Render<CardDescView>(p => p.Add(c => c.CardId, nonExistentId));
        await Task.Yield();

        Assert.That(cut.Markup, Does.Contain("Card not found in knowledge base"));
    }

    [Test]
    public async Task EditButton_FiresOnEditCardCallback()
    {
        var card = CreateFullCard();
        CardSearch.Setup(s => s.GetCardByIdAsync(card.Id, It.IsAny<CancellationToken>())).ReturnsAsync(card);

        Guid? editedCardId = null;
        var cut = Ctx.Render<CardDescView>(p =>
        {
            p.Add(c => c.CardId, card.Id);
            p.Add(c => c.OnEditCard, (Guid? id) => editedCardId = id);
        });

        await Task.Yield();
        cut.Find(".edit-kb-btn").Click();
        Assert.That(editedCardId, Is.EqualTo(card.Id));
    }

    [Test]
    public void EditButton_NotShown_WhenNoCardSelected()
    {
        var cut = Ctx.Render<CardDescView>();
        Assert.That(cut.Markup, Does.Not.Contain("edit-kb-btn"));
    }
}
