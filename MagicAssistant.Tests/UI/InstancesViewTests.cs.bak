using Bunit;
using MagicAssistant.App.Components.Views;

namespace MagicAssistant.Tests.UI;

/// <summary>
/// Tests for InstancesView — shows all deck instances of a selected card.
/// </summary>
[TestFixture]
public class InstancesViewTests : BaseUiTest
{
    private static List<MagicCardPhysical> CreateInstances(Guid cardId, int count)
    {
        var instances = new List<MagicCardPhysical>();
        for (int i = 0; i < count; i++)
        {
            var loc = i % 2 == 0 ? Location.FromPath($"deck_{i}") : Location.FromPath($"deck_{i}_sb");
            instances.Add(new MagicCardPhysical(
                new MagicCard { Id = cardId, Name = $"Card {i}", SetCode = "m19" }, loc, i % 2 == 0)
            { Count = i + 1, Price = i == 0 ? 5.99f : (float?)null, SpecialTags = i == 1 ? "foil" : null });
        }
        return instances;
    }

    [Test]
    public void NoCardId_ShowsHint()
    {
        var cut = Ctx.Render<InstancesView>();
        Assert.That(cut.Markup, Does.Contain("Select a card to see instances"));
    }

    [Test]
    public async Task Renders_InstanceRows_ForAllInstances()
    {
        var cardId = Guid.NewGuid();
        CardPhysicalStore.Setup(s => s.GetCardsAsync(cardId, It.IsAny<CancellationToken>()))
            .ReturnsAsync(CreateInstances(cardId, 3));

        var cut = Ctx.Render<InstancesView>(p => p.Add(v => v.CardId, cardId));
        await Task.Yield();

        Assert.That(cut.FindAll(".instance-row").Count, Is.EqualTo(3));
    }

    [Test]
    public async Task CountBadge_ShowsTotalCopies()
    {
        var cardId = Guid.NewGuid();
        CardPhysicalStore.Setup(s => s.GetCardsAsync(cardId, It.IsAny<CancellationToken>()))
            .ReturnsAsync(CreateInstances(cardId, 3));

        var cut = Ctx.Render<InstancesView>(p => p.Add(v => v.CardId, cardId));
        await Task.Yield();

        Assert.That(cut.Markup, Does.Contain("6 copies")); // 1+2+3=6
    }

    [Test]
    public async Task OwnedInstances_HaveGreenBadge()
    {
        var cardId = Guid.NewGuid();
        CardPhysicalStore.Setup(s => s.GetCardsAsync(cardId, It.IsAny<CancellationToken>()))
            .ReturnsAsync(new List<MagicCardPhysical>
        {
            new(new MagicCard { Id = cardId, Name = "C" }, Location.FromPath("d1"), true) { IsOwn = true, Count = 2 }
        });

        var cut = Ctx.Render<InstancesView>(p => p.Add(v => v.CardId, cardId));
        await Task.Yield();

        Assert.That(cut.Markup, Does.Contain("Owned"));
    }

    [Test]
    public async Task BorrowedInstances_HaveOrangeBadge()
    {
        var cardId = Guid.NewGuid();
        CardPhysicalStore.Setup(s => s.GetCardsAsync(cardId, It.IsAny<CancellationToken>()))
            .ReturnsAsync(new List<MagicCardPhysical>
        {
            new(new MagicCard { Id = cardId, Name = "C" }, Location.FromPath("d1"), false) { IsOwn = false, Count = 1 }
        });

        var cut = Ctx.Render<InstancesView>(p => p.Add(v => v.CardId, cardId));
        await Task.Yield();

        Assert.That(cut.Markup, Does.Contain("Borrowed"));
    }

    [Test]
    public async Task SideboardInstances_ShowSBTag()
    {
        var cardId = Guid.NewGuid();
        CardPhysicalStore.Setup(s => s.GetCardsAsync(cardId, It.IsAny<CancellationToken>()))
            .ReturnsAsync(new List<MagicCardPhysical>
        {
            new(new MagicCard { Id = cardId, Name = "C" }, Location.FromPath("deck1_sb"), true) { Count = 3 }
        });

        var cut = Ctx.Render<InstancesView>(p => p.Add(v => v.CardId, cardId));
        await Task.Yield();

        Assert.That(cut.Markup, Does.Contain("sideboard-tag"));
    }

    [Test]
    public async Task Summary_CalculatesCorrectTotals()
    {
        var cardId = Guid.NewGuid();
        CardPhysicalStore.Setup(s => s.GetCardsAsync(cardId, It.IsAny<CancellationToken>()))
            .ReturnsAsync(new List<MagicCardPhysical>
        {
            new(new MagicCard { Id = cardId, Name = "C" }, Location.FromPath("deck1"), true) { IsOwn = true, Count = 3 },
            new(new MagicCard { Id = cardId, Name = "C" }, Location.FromPath("deck2"), false) { IsOwn = false, Count = 2 }
        });

        var cut = Ctx.Render<InstancesView>(p => p.Add(v => v.CardId, cardId));
        await Task.Yield();

        Assert.That(cut.Markup, Does.Contain("5")); // 3+2=5 total
    }

    [Test]
    public async Task ClickingInstanceRow_FiresOnDeckSelected()
    {
        var cardId = Guid.NewGuid();
        CardPhysicalStore.Setup(s => s.GetCardsAsync(cardId, It.IsAny<CancellationToken>()))
            .ReturnsAsync(new List<MagicCardPhysical>
        {
            new(new MagicCard { Id = cardId, Name = "C" }, Location.FromPath("my-deck-123"), true) { Count = 2 }
        });

        string? selectedDeckId = null;
        var cut = Ctx.Render<InstancesView>(p =>
        {
            p.Add(v => v.CardId, cardId);
            p.Add(v => v.OnDeckSelected, (string id) => selectedDeckId = id);
        });

        await Task.Yield();
        cut.Find(".instance-row").Click();
        Assert.That(selectedDeckId, Is.EqualTo("my-deck-123"));
    }

    [Test]
    public async Task NoInstances_ShowsEmptyMessage()
    {
        var cardId = Guid.NewGuid();
        CardPhysicalStore.Setup(s => s.GetCardsAsync(cardId, It.IsAny<CancellationToken>()))
            .ReturnsAsync(Array.Empty<MagicCardPhysical>());

        var cut = Ctx.Render<InstancesView>(p => p.Add(v => v.CardId, cardId));
        await Task.Yield();

        Assert.That(cut.Markup, Does.Contain("No instances of this card in any deck"));
    }
}
