using Bunit;
using MagicAssistant.App.Components.Dialogs;
using AngleSharp.Dom;

namespace MagicAssistant.Tests.UI;

/// <summary>
/// Tests for CardFilterDialog — advanced card filtering.
/// </summary>
[TestFixture]
public class CardFilterDialogTests : BaseUiTest
{
    private static IElement FindInputByLabel(IRenderedComponent<CardFilterDialog> cut, string labelText)
    {
        // Find the form-row containing the label with the given text, then find input/select within it
        var rows = cut.FindAll(".filter-field-row");
        var targetRow = rows.First(r => r.QuerySelector("label.filter-label")?.TextContent.Trim() == labelText);
        return targetRow.QuerySelector("input, select")!;
    }

    [Test]
    public void NotVisible_RendersNothing()
    {
        var cut = Ctx.Render<CardFilterDialog>(p => p.Add(d => d.IsOpen, false));
        Assert.That(cut.Markup, Does.Not.Contain("filter-dialog-overlay"));
    }

    [Test]
    public void Visible_RendersOverlay()
    {
        var cut = Ctx.Render<CardFilterDialog>(p => p.Add(d => d.IsOpen, true));
        Assert.That(cut.Find(".filter-dialog-overlay"), Is.Not.Null);
    }

    [Test]
    public void DefaultTab_IsTextSearch()
    {
        var cut = Ctx.Render<CardFilterDialog>(p => p.Add(d => d.IsOpen, true));
        Assert.That(cut.Markup, Does.Contain("Syntax:"));
    }

    [Test]
    public void ClickFieldsTab_SwitchesToFields()
    {
        var cut = Ctx.Render<CardFilterDialog>(p => p.Add(d => d.IsOpen, true));
        cut.FindAll("button").First(b => b.TextContent.Contains("Fields")).Click();
        Assert.That(cut.Markup, Does.Contain(">Type<"));
        Assert.That(cut.Markup, Does.Contain("Rarity"));
    }

    [Test]
    public async Task ApplyTextSearch_ProducesCorrectFilterResult()
    {
        FilterResult? result = null;
        var cut = Ctx.Render<CardFilterDialog>(p =>
        {
            p.Add(d => d.IsOpen, true);
            p.Add(d => d.OnFilterApplied, (FilterResult r) => result = r);
        });

        cut.Find(".filter-textarea").Input("creature flying");
        cut.Find(".btn-apply").Click();
        await Task.Yield();

        Assert.That(result!.TextSearch, Is.EqualTo("creature flying"));
        Assert.That(result.FieldFilters, Is.Null);
    }

    [Test]
    public async Task ApplyFieldFilters_ProducesCorrectFilterResult()
    {
        FilterResult? result = null;
        var cut = Ctx.Render<CardFilterDialog>(p =>
        {
            p.Add(d => d.IsOpen, true);
            p.Add(d => d.OnFilterApplied, (FilterResult r) => result = r);
        });

        cut.FindAll("button").First(b => b.TextContent.Contains("Fields")).Click();
        FindInputByLabel(cut, "Type").Input("Creature");
        // Trigger onchange event on select for rarity with proper ChangeEventArgs
        var raritySelect = cut.FindAll(".filter-select")[0];
        SetSelectValue(raritySelect, "rare");
        raritySelect.Change("rare");
        cut.Find(".btn-apply").Click();
        await Task.Yield();

        Assert.That(result!.FieldFilters!["type"], Is.EqualTo("Creature"));
        Assert.That(result.FieldFilters["rarity"], Is.EqualTo("rare"));
    }

    [Test]
    public void ClearButton_ResetsAllFields()
    {
        var cut = Ctx.Render<CardFilterDialog>(p => p.Add(d => d.IsOpen, true));
        // Fill both tabs before clearing
        cut.Find(".filter-textarea").Input("test query");
        cut.FindAll("button").First(b => b.TextContent.Contains("Fields")).Click();
        FindInputByLabel(cut, "Type").Input("Creature");
        cut.Find(".btn-clear").Click();

        // After clear, switch back to Text tab and verify textarea is empty
        cut.FindAll("button").First(b => b.TextContent.Contains("Text Search")).Click();
        Assert.That(cut.Find(".filter-textarea").TextContent, Is.Empty);
    }

    [Test]
    public async Task ClickCancel_FiresOnCancelled()
    {
        bool cancelled = false;
        var cut = Ctx.Render<CardFilterDialog>(p =>
        {
            p.Add(d => d.IsOpen, true);
            p.Add(d => d.IsOpenChanged, _ => cancelled = true);
        });

        cut.Find(".btn-cancel").Click();
        await Task.Yield();
        Assert.That(cancelled, Is.True);
    }

    [Test]
    public async Task OverlayClick_FiresOnCancelled()
    {
        bool cancelled = false;
        var cut = Ctx.Render<CardFilterDialog>(p =>
        {
            p.Add(d => d.IsOpen, true);
            p.Add(d => d.IsOpenChanged, _ => cancelled = true);
        });

        cut.Find(".filter-dialog-overlay").Click();
        await Task.Yield();
        Assert.That(cancelled, Is.True);
    }

    private static void SetSelectValue(IElement select, string value)
    {
        foreach (var opt in select.QuerySelectorAll("option"))
        {
            if (opt.GetAttribute("value") == value || opt.TextContent.Trim() == value)
            {
                opt.SetAttribute("selected", "selected");
                return;
            }
        }
    }
}
