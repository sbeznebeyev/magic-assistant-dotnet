using Bunit;
using MagicAssistant.App.Components.Views;

namespace MagicAssistant.Tests.UI;

/// <summary>
/// Tests for PrintingsView — shows all printings of a card.
/// </summary>
[TestFixture]
public class PrintingsViewTests : BaseUiTest
{
    private static List<MagicCard> CreatePrintings(string name, int count)
    {
        var sets = new[] { "M19", "M20", "M21", "M22", "M25", "M26" };
        var printings = new List<MagicCard>();
        for (int i = 0; i < count && i < sets.Length; i++)
            printings.Add(new MagicCard { Id = Guid.NewGuid(), Name = name, SetCode = sets[i], Rarity = i % 2 == 0 ? "common" : "uncommon", Cmc = "1", Language = "en", CollectorNumber = (i + 1).ToString() });
        return printings;
    }

    [Test]
    public void NoCardId_ShowsHint()
    {
        var cut = Ctx.Render<PrintingsView>();
        Assert.That(cut.Markup, Does.Contain("Select a card to see all printings"));
    }

    [Test]
    public async Task Renders_PrintingRows_ForAllPrintings()
    {
        var currentId = Guid.NewGuid();
        var name = "Lightning Bolt";
        var printings = CreatePrintings(name, 4);
        printings[0].Id = currentId;

        CardSearch.Setup(s => s.GetCardByIdAsync(currentId, It.IsAny<CancellationToken>()))
            .ReturnsAsync(new MagicCard { Id = currentId, Name = name });
        CardSearch.Setup(s => s.GetPrintingsAsync(name, It.IsAny<CancellationToken>())).ReturnsAsync(printings);

        var cut = Ctx.Render<PrintingsView>(p => p.Add(v => v.CardId, currentId));
        await Task.Yield();

        Assert.That(cut.FindAll(".printing-row").Count, Is.EqualTo(4));
    }

    [Test]
    public async Task CurrentPrinting_HasHighlightClass()
    {
        var currentId = Guid.NewGuid();
        var name = "Lightning Bolt";
        var printings = CreatePrintings(name, 3);
        printings[0].Id = currentId;

        CardSearch.Setup(s => s.GetCardByIdAsync(currentId, It.IsAny<CancellationToken>()))
            .ReturnsAsync(new MagicCard { Id = currentId, Name = name });
        CardSearch.Setup(s => s.GetPrintingsAsync(name, It.IsAny<CancellationToken>())).ReturnsAsync(printings);

        var cut = Ctx.Render<PrintingsView>(p => p.Add(v => v.CardId, currentId));
        await Task.Yield();

        Assert.That(cut.Find(".printing-row.current"), Is.Not.Null);
    }

    [Test]
    public async Task FilterBar_Visible_WhenMoreThanFivePrintings()
    {
        var currentId = Guid.NewGuid();
        var name = "Popular Card";
        var printings = CreatePrintings(name, 6);
        printings[0].Id = currentId;

        CardSearch.Setup(s => s.GetCardByIdAsync(currentId, It.IsAny<CancellationToken>()))
            .ReturnsAsync(new MagicCard { Id = currentId, Name = name });
        CardSearch.Setup(s => s.GetPrintingsAsync(name, It.IsAny<CancellationToken>())).ReturnsAsync(printings);

        var cut = Ctx.Render<PrintingsView>(p => p.Add(v => v.CardId, currentId));
        await Task.Yield();

        Assert.That(cut.Find(".filter-bar"), Is.Not.Null);
    }

    [Test]
    public async Task FilterInput_FiltersPrintingsBySet()
    {
        var currentId = Guid.NewGuid();
        var name = "Card";
        var printings = CreatePrintings(name, 6);
        printings[0].Id = currentId;

        CardSearch.Setup(s => s.GetCardByIdAsync(currentId, It.IsAny<CancellationToken>()))
            .ReturnsAsync(new MagicCard { Id = currentId, Name = name });
        CardSearch.Setup(s => s.GetPrintingsAsync(name, It.IsAny<CancellationToken>())).ReturnsAsync(printings);

        var cut = Ctx.Render<PrintingsView>(p => p.Add(v => v.CardId, currentId));
        await Task.Yield();

        Assert.That(cut.FindAll(".printing-row").Count, Is.EqualTo(6));
        cut.Find(".filter-input").Input("M19");
        Assert.That(cut.FindAll(".printing-row").Count, Is.LessThan(6));
    }

    [Test]
    public async Task ClickingPrintingRow_FiresOnPrintingSelected()
    {
        var currentId = Guid.NewGuid();
        var name = "Card";
        var printings = CreatePrintings(name, 3);
        printings[0].Id = currentId;

        CardSearch.Setup(s => s.GetCardByIdAsync(currentId, It.IsAny<CancellationToken>()))
            .ReturnsAsync(new MagicCard { Id = currentId, Name = name });
        CardSearch.Setup(s => s.GetPrintingsAsync(name, It.IsAny<CancellationToken>())).ReturnsAsync(printings);

        Guid? selectedId = null;
        var cut = Ctx.Render<PrintingsView>(p =>
        {
            p.Add(v => v.CardId, currentId);
            p.Add(v => v.OnPrintingSelected, (Guid id) => selectedId = id);
        });

        await Task.Yield();
        cut.FindAll(".printing-row")[1].Click();
        Assert.That(selectedId, Is.EqualTo(printings[1].Id));
    }

    [Test]
    public async Task NoPrintings_ShowsEmptyMessage()
    {
        var currentId = Guid.NewGuid();
        var name = "Unique Card";

        CardSearch.Setup(s => s.GetCardByIdAsync(currentId, It.IsAny<CancellationToken>()))
            .ReturnsAsync(new MagicCard { Id = currentId, Name = name });
        CardSearch.Setup(s => s.GetPrintingsAsync(name, It.IsAny<CancellationToken>())).ReturnsAsync(Array.Empty<MagicCard>());

        var cut = Ctx.Render<PrintingsView>(p => p.Add(v => v.CardId, currentId));
        await Task.Yield();

        Assert.That(cut.Markup, Does.Contain("No printings found"));
    }
}
