    // =========================================================================
    // 13. Deck deselection — tab bar hidden, list view restored
    // =========================================================================

    [Test]
    public void DeckDeselected_HidesTabBarAndShowsList()
    {
        SetPrivateField("_selectedDeckId", "test-deck-1");
        Assert.That(_cut.Find(".tab-bar"), Is.Not.Null);

        SetPrivateField("_selectedDeckId", null);
        Assert.That(_cut.Markup, Does.Not.Contain("tab-bar"));
