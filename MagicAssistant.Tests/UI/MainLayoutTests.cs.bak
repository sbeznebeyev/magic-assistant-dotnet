    [Test]
    public void Toolbar_ContainsAllButtons()
    {
        var toolbar = _cut.Find(".toolbar");

        Assert.That(toolbar.TextContent, Does.Contain("+ Deck"));
        Assert.That(toolbar.TextContent, Does.Contain("Import"));
        Assert.That(toolbar.TextContent, Does.Contain("Legacy Import"));
        Assert.That(toolbar.TextContent, Does.Contain("Export"));
        Assert.That(toolbar.TextContent, Does.Contain("Sync KB"));
        Assert.That(toolbar.TextContent, Does.Contain("Update DB"));
        Assert.That(toolbar.TextContent, Does.Contain("Booster"));
        Assert.That(toolbar.TextContent, Does.Contain("New Folder"));
    }

