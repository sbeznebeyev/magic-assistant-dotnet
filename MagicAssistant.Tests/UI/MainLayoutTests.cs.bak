    // =========================================================================
    // 8. Right Panel — component presence & card selection flow
    // =========================================================================

    [Test]
    public void RightPanel_ContainsAllThreeComponents()
    {
        Assert.That(_cut.Find(".panel-right").InnerHtml, Does.Contain("card-desc"));
        Assert.That(_cut.Find(".panel-right").InnerHtml, Does.Contain("printings-view"));
        Assert.That(_cut.Find(".panel-right").InnerHtml, Does.Contain("instances-view"));
    }

    [Test]
    public void CardSelected_PassesCardIdToAllRightPanelComponents()
    {
        var card = new MagicCard { Id = Guid.NewGuid(), Name = "Lightning Bolt", SetCode = "m19", ManaCost = "{R}", Type = "Instant" };
        
        // Mock the search service to return this card
        CardSearch.Setup(s => s.GetCardByIdAsync(card.Id, It.IsAny<CancellationToken>()))
            .ReturnsAsync(card);
        
        SetPrivateField("_selectedCardId", card.Id);
        
        var rightPanel = _cut.Find(".panel-right");
        
        // CardDescView должен отобразить данные карты
        Assert.That(rightPanel.InnerHtml, Does.Contain("Lightning Bolt"));
        Assert.That(rightPanel.InnerHtml, Does.Contain("{R}"));
        Assert.That(rightPanel.InnerHtml, Does.Contain("Instant"));
    }

    [Test]
    public void NoCardSelected_ShowsHintsInRightPanel()
    {
        var rightPanel = _cut.Find(".panel-right");
        
        Assert.That(rightPanel.InnerHtml, Does.Contain("Select a card to see details"));
        Assert.That(rightPanel.InnerHtml, Does.Contain("Select a card to see all printings"));
        Assert.That(rightPanel.InnerHtml, Does.Contain("Select a card to see instances"));
    }

