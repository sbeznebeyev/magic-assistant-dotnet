    [Test]
    public void NewDeckWizard_CancelButton_ClosesDialog()
    {
        FindButtonByTitle(_cut, "Create new deck").Click();
        Assert.That(_cut.Markup, Does.Contain("Create New Deck"));

        var cancelBtn = _cut.FindAll(".btn-secondary")
            .First(b => b.TextContent.Trim() == "Cancel");
        cancelBtn.Click();
        Assert.That(_cut.Markup, Does.Not.Contain("Create New Deck"));
    }

