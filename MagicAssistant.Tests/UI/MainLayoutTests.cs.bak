    // =========================================================================
    // 10. View Mode Selector — options present
    // =========================================================================

    [Test]
    public void ViewModeSelector_ContainsAllOptions()
    {
        var select = _cut.Find("select");
        var options = select.QuerySelectorAll("option");
        Assert.That(options.Length, Is.EqualTo(3));
        Assert.That(options[0].GetAttribute("value"), Is.EqualTo("list"));
        Assert.That(options[1].GetAttribute("value"), Is.EqualTo("gallery"));
        Assert.That(options[2].GetAttribute("value"), Is.EqualTo("tree"));
    }

