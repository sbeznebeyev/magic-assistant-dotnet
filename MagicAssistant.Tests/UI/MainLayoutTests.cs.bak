using Bunit;
using MagicAssistant.App.Shared;
using AngleSharp.Dom;
using System.Reflection;

namespace MagicAssistant.Tests.UI;

/// <summary>
/// Tests for MainLayout — the central orchestrator of the entire UI.
/// Covers: 3-panel layout, toolbar buttons (8), dialog orchestration (12+),
/// view mode switching, tab bar (9 tabs), card/deck selection flow, status bar updates.
/// </summary>
[TestFixture]
public class MainLayoutTests : BaseUiTest
{
    private IRenderedComponent<MainLayout> _cut = null!;

    [SetUp]
    public override void SetUp()
    {
        base.SetUp();
        _cut = Ctx.Render<MainLayout>();
    }

    [TearDown]
    public override void TearDown()
    {
        _cut?.Dispose();
        base.TearDown();
    }

    private static IElement FindButtonByTitle(IRenderedComponent<MainLayout> cut, string title)
        => cut.FindAll("button").First(b => b.GetAttribute("title") == title);

    private void ChangeSelectTo(IElement select, string value)
    {
        foreach (var opt in select.QuerySelectorAll("option"))
        {
            if (opt.GetAttribute("value") == value)
            {
                opt.SetAttribute("selected", "selected");
                break;
            }
        }
        var evt = Microsoft.AspNetCore.Components.ChangeEventArgs.Empty;
        evt = new Microsoft.AspNetCore.Components.ChangeEventArgs { Value = value };
        select.TriggerEvent("onchange", evt);
    }

    private void SetPrivateField(string fieldName, object? value)
    {
        var field = _cut.Instance.GetType().GetField(fieldName, BindingFlags.NonPublic | BindingFlags.Instance);
        field?.SetValue(_cut.Instance, value);
        _cut.Render();
    }

    // =========================================================================
    // 1. Layout Structure — 3-panel rendering
    // =========================================================================

    [Test]
    public void Renders_InitialLayout_WithAllThreePanels()
    {
        Assert.That(_cut.Find(".panel-left"), Is.Not.Null);
        Assert.That(_cut.Find(".panel-center"), Is.Not.Null);
        Assert.That(_cut.Find(".panel-right"), Is.Not.Null);
    }

    [Test]
    public void Header_DisplaysApplicationTitle()
    {
        Assert.That(_cut.Markup, Does.Contain("Magic Assistant"));
        Assert.That(_cut.Markup, Does.Contain("Card Organizer"));
    }

    // =========================================================================
    // 2. Toolbar — all 8 buttons present and functional
