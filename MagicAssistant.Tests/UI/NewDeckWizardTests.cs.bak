using Bunit;
using MagicAssistant.App.Components.Wizards;
using Microsoft.AspNetCore.Components;
using Microsoft.AspNetCore.Components.Web;

namespace MagicAssistant.Tests.UI;

/// <summary>
/// Tests for NewDeckWizard — creates new decks.
/// </summary>
[TestFixture]
public class NewDeckWizardTests : BaseUiTest
{
    [Test]
    public void Visible_RendersDialog()
    {
        var cut = Ctx.Render<NewDeckWizard>(p => p.Add(d => d.IsOpen, true));
        Assert.That(cut.Find(".dialog-overlay"), Is.Not.Null);
        Assert.That(cut.Markup, Does.Contain("Create New Deck"));
    }

    [Test]
    public void CreateButton_Disabled_WhenNameIsEmpty()
    {
        var cut = Ctx.Render<NewDeckWizard>(p => p.Add(d => d.IsOpen, true));
        Assert.That(cut.Find(".btn-primary").GetAttribute("disabled"), Is.Not.Null);
    }

    [Test]
    public void CreateButton_Enabled_WhenNameIsValid()
    {
        var cut = Ctx.Render<NewDeckWizard>(p => p.Add(d => d.IsOpen, true));
        cut.Find("input").Change("My Awesome Deck");
        Assert.That(cut.Find(".btn-primary").GetAttribute("disabled"), Is.Null);
    }

    [Test]
    public async Task ClickCreate_CallsCreateDeckAsync()
    {
        var newDeck = new CardCollectionNode("new-deck-123", "My Deck", null, false, 0);
        DeckMgmt.Setup(s => s.CreateDeckAsync("My Deck", (string?)null, It.IsAny<CancellationToken>()))
            .ReturnsAsync(newDeck);

        string? createdId = null;
        var cut = Ctx.Render<NewDeckWizard>(p =>
        {
            p.Add(d => d.IsOpen, true);
            p.Add(d => d.OnDeckCreated, EventCallback.Factory.Create<string>(new object(), id => createdId = id));
        });

        cut.Find("input").Change("My Deck");
        cut.Find(".btn-primary").Click();
        await Task.Yield();

        DeckMgmt.Verify(s => s.CreateDeckAsync("My Deck", (string?)null, It.IsAny<CancellationToken>()), Times.Once());
        Assert.That(createdId, Is.EqualTo("new-deck-123"));
    }

    [Test]
    public async Task EnterKey_CreatesDeck()
    {
        var newDeck = new CardCollectionNode("deck-enter", "Enter Deck", null, false, 0);
        DeckMgmt.Setup(s => s.CreateDeckAsync("Enter Deck", (string?)null, It.IsAny<CancellationToken>()))
            .ReturnsAsync(newDeck);

        string? createdId = null;
        var cut = Ctx.Render<NewDeckWizard>(p =>
        {
            p.Add(d => d.IsOpen, true);
            p.Add(d => d.OnDeckCreated, EventCallback.Factory.Create<string>(new object(), id => createdId = id));
        });

        var input = cut.Find("input");
        input.Change("Enter Deck");
        input.KeyPress(new KeyboardEventArgs { Key = "Enter", Type = "keypress" });
        await Task.Yield();

        Assert.That(createdId, Is.EqualTo("deck-enter"));
    }

    [Test]
    public async Task ClickCancel_FiresIsOpenChanged()
    {
        bool cancelled = false;
        var cut = Ctx.Render<NewDeckWizard>(p =>
        {
            p.Add(d => d.IsOpen, true);
            p.Add(d => d.IsOpenChanged, EventCallback.Factory.Create<bool>(new object(), _ => cancelled = true));
        });

        cut.Find(".btn-secondary").Click();
        await Task.Yield();
        Assert.That(cancelled, Is.True);
    }

    [Test]
    public async Task OverlayClick_FiresIsOpenChanged()
    {
        bool cancelled = false;
        var cut = Ctx.Render<NewDeckWizard>(p =>
        {
            p.Add(d => d.IsOpen, true);
            p.Add(d => d.IsOpenChanged, EventCallback.Factory.Create<bool>(new object(), _ => cancelled = true));
        });

        cut.Find(".dialog-overlay").Click();
        await Task.Yield();
        Assert.That(cancelled, Is.True);
    }

    [Test]
    public async Task CreateFailure_DisplaysErrorMessage()
    {
        DeckMgmt.Setup(s => s.CreateDeckAsync(It.IsAny<string>(), It.IsAny<string?>(), It.IsAny<CancellationToken>()))
            .ThrowsAsync(new Exception("Deck name already exists"));

        var cut = Ctx.Render<NewDeckWizard>(p => p.Add(d => d.IsOpen, true));
        cut.Find("input").Change("Duplicate Name");
        cut.Find(".btn-primary").Click();
        await Task.Yield();

        Assert.That(cut.Markup, Does.Contain("dialog-error"));
        Assert.That(cut.Markup, Does.Contain("Deck name already exists"));
    }
}
